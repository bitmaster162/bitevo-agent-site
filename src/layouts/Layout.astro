---
interface Props {
  title: string;
  description?: string;
  robots?: string;
  ogType?: string;
}

const {
  title,
  description = "BitEvo — Authority Budget, Evidence Before Effect and bounded recovery for action-capable AI workflows",
  robots = "max-image-preview:large, index, follow",
  ogType = "website"
} = Astro.props;

const path = Astro.url.pathname;
const canonicalUrl = new URL(path, "https://bitevoagentsite.vercel.app").toString();
const isActive = (href: string) => href === "/" ? path === "/" : path.startsWith(href);
const nav = [
  ["Overview", "/"],
  ["Doctrine", "/doctrine"],
  ["Proof", "/proof"],
  ["Mapper", "/mapper"],
  ["Audit", "/agent-authority-audit"],
  ["Pricing", "/pricing"]
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#071013" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="BitEvo" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="site-ambient" aria-hidden="true"></div>

    <header class="site-header">
      <div class="container header-inner">
        <a href="/" class="brand" aria-label="BitEvo home">
          <span class="brand-mark" aria-hidden="true"><i></i><i></i></span>
          <span class="brand-copy"><strong>BITEVO</strong><small>AGENT SYSTEMS</small></span>
        </a>
        <nav class="desktop-nav" aria-label="Primary navigation">{nav.map(([label, href]) => <a href={href} aria-current={isActive(href) ? "page" : undefined}>{label}</a>)}</nav>
        <a class="header-cta" href="/audit-intake">Scope an audit <span aria-hidden="true">↗</span></a>
        <details class="mobile-menu">
          <summary aria-label="Open navigation"><span></span><span></span></summary>
          <nav aria-label="Mobile navigation">{nav.map(([label, href]) => <a href={href} aria-current={isActive(href) ? "page" : undefined}>{label}</a>)}<a href="/consulting">Services</a><a href="/guides">Research</a><a class="mobile-cta" href="/audit-intake">Scope an audit →</a></nav>
        </details>
      </div>
    </header>

    <main id="main-content"><slot /></main>

    <footer class="site-footer">
      <div class="container footer-shell">
        <section class="footer-cta" aria-labelledby="footer-cta-title">
          <div><div class="eyebrow">Authority before effect</div><h2 id="footer-cta-title">Map what the agent may change before testing whether it should.</h2></div>
          <a class="button button-primary" href="/mapper">Open Authority Mapper <span aria-hidden="true">↗</span></a>
        </section>

        <div class="footer-grid">
          <div class="footer-brand">
            <a href="/" class="brand" aria-label="BitEvo home"><span class="brand-mark" aria-hidden="true"><i></i><i></i></span><span class="brand-copy"><strong>BITEVO</strong><small>AGENT SYSTEMS</small></span></a>
            <p><strong>Authority Budget. Evidence Before Effect. False Green.</strong><br />BitEvo turns consequential agent capability into object-bound authority, explicit evidence gates, external confirmation and bounded owner decisions.</p>
          </div>
          <div class="footer-col"><strong>Method</strong><a href="/doctrine">Doctrine</a><a href="/proof">Proof matrix</a><a href="/mapper">Authority Mapper</a><a href="/diagnostic">7-gate diagnostic</a></div>
          <div class="footer-col"><strong>Work</strong><a href="/agent-authority-audit">Authority & Evidence Audit</a><a href="/pricing">Pricing</a><a href="/consulting">Services</a><a href="/audit-intake">Audit intake</a></div>
          <div class="footer-col"><strong>Build</strong><a href="/continuityos">ContinuityOS</a><a href="/guides">Research library</a><a href="/universe">BitEvo Universe</a><a href="/llms.txt">LLMs.txt</a></div>
        </div>

        <div class="footer-bottom"><span>© 2026 BitEvo</span><span>Authority is earned by evidence.</span></div>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --ink: #f2f6f3;
    --ink-soft: #d7dfdc;
    --muted: #8d9a98;
    --paper: #05090a;
    --paper-soft: #081012;
    --panel: #0b1517;
    --panel-2: #0e1b1d;
    --graphite: #182426;
    --smoke: #263638;
    --gold: #d7c58f;
    --gold-soft: #ab9a69;
    --green: #7fd0b1;
    --blue: #73b9d8;
    --red: #e48b8b;
    --high: #f1a45c;
    --line: rgba(174, 211, 202, 0.11);
    --line-strong: rgba(174, 211, 202, 0.23);
    --shadow: 0 24px 80px rgba(0, 0, 0, .34);
    --radius-sm: 10px;
    --radius: 18px;
    --radius-lg: 28px;
    --sans: 'Manrope', ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    --mono: 'DM Mono', ui-monospace, SFMono-Regular, Consolas, monospace;
  }

  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; background: var(--paper); color-scheme: dark; }
  body {
    margin: 0;
    min-height: 100vh;
    color: var(--ink);
    background:
      radial-gradient(circle at 14% 8%, rgba(77, 145, 134, .12), transparent 28rem),
      radial-gradient(circle at 88% 18%, rgba(82, 131, 154, .10), transparent 30rem),
      linear-gradient(180deg, #071013 0%, #05090a 35%, #05090a 100%);
    font-family: var(--sans);
    font-size: 15px;
    line-height: 1.65;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
    overflow-x: hidden;
  }

  ::selection { background: rgba(127, 208, 177, .25); color: var(--ink); }
  a { color: inherit; text-decoration: none; }
  img, svg { max-width: 100%; }
  button, input, textarea, select { font: inherit; }
  code, pre { font-family: var(--mono); }

  .site-ambient {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: -1;
    opacity: .28;
    background-image:
      linear-gradient(rgba(255,255,255,.018) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,.018) 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: linear-gradient(to bottom, black, transparent 68%);
  }

  .container { width: min(1180px, calc(100vw - 44px)); margin-inline: auto; }
  .narrow { width: min(860px, calc(100vw - 44px)); margin-inline: auto; }
  .section { padding-block: clamp(54px, 8vw, 96px); }
  .section-tight { padding-block: clamp(36px, 5vw, 64px); }
  .section-rule { border-top: 1px solid var(--line); }

  .eyebrow, .kicker { display: inline-flex; align-items: center; gap: 8px; margin: 0 0 14px; color: var(--green); font: 500 .72rem/1.2 var(--mono); letter-spacing: .13em; text-transform: uppercase; }
  .eyebrow::before, .kicker::before { content: ''; width: 18px; height: 1px; background: currentColor; opacity: .7; }
  h1, h2, h3, p { text-wrap: pretty; }
  .display, .page-title { max-width: 920px; margin: 0; font-size: clamp(2.75rem, 7vw, 5.9rem); line-height: .98; letter-spacing: -.055em; font-weight: 700; }
  .section-title { margin: 0; font-size: clamp(1.9rem, 3.8vw, 3.25rem); line-height: 1.08; letter-spacing: -.04em; }
  .lede, .copy { max-width: 760px; color: var(--muted); font-size: clamp(1.02rem, 1.7vw, 1.22rem); line-height: 1.75; }

  .button { display: inline-flex; align-items: center; justify-content: center; gap: 9px; min-height: 46px; padding: 0 18px; border: 1px solid var(--line-strong); border-radius: 999px; color: var(--ink); background: rgba(255,255,255,.025); font-size: .82rem; font-weight: 700; transition: transform .18s ease, border-color .18s ease, background .18s ease; }
  .button:hover { transform: translateY(-1px); border-color: rgba(127,208,177,.55); background: rgba(127,208,177,.055); }
  .button-primary { background: var(--ink); color: #071012; border-color: var(--ink); }
  .button-primary:hover { background: #fff; border-color: #fff; }
  .button-ghost { color: var(--muted); }
  .panel { background: linear-gradient(180deg, rgba(14,27,29,.82), rgba(8,16,18,.84)); border: 1px solid var(--line); border-radius: var(--radius); box-shadow: inset 0 1px 0 rgba(255,255,255,.018); }

  .skip-link { position: fixed; top: 8px; left: 8px; z-index: 1000; transform: translateY(-150%); padding: 9px 12px; background: var(--ink); color: var(--paper); border-radius: 8px; }
  .skip-link:focus { transform: translateY(0); }

  .site-header { position: sticky; top: 0; z-index: 100; border-bottom: 1px solid transparent; background: rgba(5, 9, 10, .72); backdrop-filter: blur(20px) saturate(130%); }
  .site-header::after { content: ''; position: absolute; inset: auto 0 0; height: 1px; background: linear-gradient(90deg, transparent, var(--line-strong), transparent); }
  .header-inner { min-height: 76px; display: flex; align-items: center; gap: 28px; }
  .brand { display: inline-flex; align-items: center; gap: 11px; flex: 0 0 auto; }
  .brand-mark { position: relative; width: 30px; height: 27px; display: inline-block; }
  .brand-mark i { position: absolute; width: 16px; height: 22px; top: 2px; background: linear-gradient(180deg, var(--green), #477e70); transform: skewX(-21deg); border-radius: 2px; box-shadow: 0 0 20px rgba(127,208,177,.12); }
  .brand-mark i:first-child { left: 1px; }
  .brand-mark i:last-child { right: 1px; background: linear-gradient(180deg, var(--blue), #466f82); }
  .brand-copy { display: flex; flex-direction: column; gap: 1px; line-height: 1; }
  .brand-copy strong { font-size: .92rem; letter-spacing: .12em; }
  .brand-copy small { color: var(--muted); font: 500 .54rem/1.2 var(--mono); letter-spacing: .12em; }

  .desktop-nav { margin-left: auto; display: flex; align-items: center; gap: 4px; }
  .desktop-nav a { padding: 9px 11px; border-radius: 999px; color: var(--muted); font-size: .74rem; font-weight: 650; }
  .desktop-nav a:hover, .desktop-nav a[aria-current="page"] { color: var(--ink); background: rgba(255,255,255,.04); }
  .desktop-nav a[aria-current="page"]::before { content: '•'; color: var(--green); margin-right: 6px; }
  .header-cta { display: inline-flex; align-items: center; gap: 8px; padding: 10px 14px; border: 1px solid var(--line-strong); border-radius: 999px; font-size: .76rem; font-weight: 700; background: rgba(255,255,255,.035); }
  .header-cta:hover { border-color: rgba(127,208,177,.5); }
  .mobile-menu { display: none; margin-left: auto; position: relative; }
  .mobile-menu summary { width: 42px; height: 42px; display: grid; place-content: center; gap: 5px; border: 1px solid var(--line-strong); border-radius: 999px; cursor: pointer; list-style: none; }
  .mobile-menu summary::-webkit-details-marker { display: none; }
  .mobile-menu summary span { width: 16px; height: 1px; background: var(--ink); display: block; }
  .mobile-menu nav { position: absolute; right: 0; top: 50px; min-width: 240px; padding: 10px; display: grid; gap: 3px; background: rgba(8,16,18,.98); border: 1px solid var(--line-strong); border-radius: 16px; box-shadow: var(--shadow); }
  .mobile-menu nav a { padding: 11px 12px; border-radius: 10px; color: var(--muted); font-size: .84rem; }
  .mobile-menu nav a:hover, .mobile-menu nav a[aria-current="page"] { color: var(--ink); background: rgba(255,255,255,.04); }
  .mobile-menu .mobile-cta { color: var(--ink); border: 1px solid var(--line); margin-top: 4px; }

  main { min-height: 58vh; }
  .site-footer { margin-top: clamp(60px, 9vw, 120px); border-top: 1px solid var(--line); background: rgba(4,8,9,.78); }
  .footer-shell { padding-block: clamp(46px, 7vw, 78px) 24px; }
  .footer-cta { display: flex; align-items: end; justify-content: space-between; gap: 32px; padding-bottom: clamp(42px, 6vw, 68px); }
  .footer-cta h2 { max-width: 760px; margin: 0; font-size: clamp(2rem, 4.2vw, 3.8rem); line-height: 1.04; letter-spacing: -.045em; }
  .footer-grid { display: grid; grid-template-columns: 1.5fr .8fr .8fr .8fr; gap: 38px; padding-block: 34px; border-top: 1px solid var(--line); }
  .footer-brand p, .footer-col p { color: var(--muted); max-width: 390px; font-size: .82rem; margin: 16px 0 0; }
  .footer-brand p strong { color: var(--ink-soft); }
  .footer-col { display: flex; flex-direction: column; align-items: flex-start; gap: 9px; }
  .footer-col strong { margin-bottom: 4px; color: var(--ink-soft); font: 500 .68rem/1.2 var(--mono); letter-spacing: .11em; text-transform: uppercase; }
  .footer-col a { color: var(--muted); font-size: .8rem; }
  .footer-col a:hover { color: var(--ink); }
  .footer-bottom { display: flex; justify-content: space-between; gap: 20px; padding-top: 20px; border-top: 1px solid var(--line); color: #65716f; font: 500 .66rem/1.4 var(--mono); letter-spacing: .08em; text-transform: uppercase; }
  :focus-visible { outline: 2px solid var(--green); outline-offset: 3px; }

  @media (max-width: 980px) { .desktop-nav, .header-cta { display: none; } .mobile-menu { display: block; } .footer-grid { grid-template-columns: 1.4fr 1fr 1fr; } .footer-grid .footer-col:last-child { grid-column: 2 / -1; } }
  @media (max-width: 720px) { .container, .narrow { width: min(100% - 30px, 1180px); } .header-inner { min-height: 68px; } .brand-copy small { display: none; } .footer-cta { align-items: flex-start; flex-direction: column; } .footer-grid { grid-template-columns: 1fr 1fr; } .footer-brand { grid-column: 1 / -1; } .footer-grid .footer-col:last-child { grid-column: auto; } .footer-bottom { flex-direction: column; } }
  @media (max-width: 460px) { .footer-grid { grid-template-columns: 1fr; } .footer-brand, .footer-grid .footer-col:last-child { grid-column: auto; } .button { width: 100%; } }
  @media (prefers-reduced-motion: reduce) { *, *::before, *::after { scroll-behavior: auto !important; transition: none !important; animation: none !important; } }
</style>