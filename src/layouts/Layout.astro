---
interface Props {
	title: string;
	description?: string;
}

const { title, description = "BitEvo — B2B AI Consulting & Durable Orchestrator Cockpit" } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{title}</title>

		<!-- Google Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400..700;1,400..700&family=Playfair+Display:ital,wght@0,400..900;1,400..900&family=Plus+Jakarta+Sans:ital,wght@0,200..800;1,200..800&display=swap" rel="stylesheet" />
	</head>
	<body>
		<header class="site-header">
			<div class="container header-inner">
				<a href="/" class="brand">
					<div class="brand-logo">◢◤</div>
					<strong>BITEVO AGENT</strong>
				</a>
				<nav class="main-nav">
					<a href="/">Overview</a>
					<a href="/cockpit">Cockpit</a>
					<a href="/consulting">Consulting</a>
					<a href="/intake" class="btn-intake">Get Started</a>
				</nav>
			</div>
		</header>

		<main>
			<slot />
		</main>

		<footer class="site-footer">
			<div class="container footer-inner">
				<div class="footer-brand">
					<div class="footer-mark">
						<span class="logo-text">◢◤</span>
						<strong>BITEVO</strong>
					</div>
					<p>Durable AI orchestrator and cognitive automation trust layer for sovereign enterprise networks.</p>
				</div>
				<div class="footer-bottom">
					<div>© 2026 BITEVO. All rights reserved.</div>
					<div>Powered by Continuity OS & Astro</div>
				</div>
			</div>
		</footer>
	</body>
</html>

<style is:global>
	:root {
		--ink: #f1eee6;
		--muted: #a7adb0;
		--paper: #070a0c;
		--paper-soft: #0a0d10;
		--graphite: #171c20;
		--smoke: #242b30;
		--gold: #bdb392;
		--green: #7da89b;
		--blue: #78afd0;
		--line: rgba(126, 160, 170, 0.14);
		--radius: 10px;
	}

	* {
		box-sizing: border-box;
	}

	html {
		background: linear-gradient(180deg, #0d1417, #071012 34%, #06090b), var(--paper);
		color: var(--ink);
		font-family: 'Plus Jakarta Sans', sans-serif;
		font-size: 15px;
		line-height: 1.6;
		overflow-x: hidden;
		min-height: 100vh;
	}

	body {
		margin: 0;
		display: flex;
		flex-direction: column;
		min-height: 100vh;
	}

	.container {
		width: min(1200px, calc(100vw - 40px));
		margin-inline: auto;
	}

	a {
		color: inherit;
		text-decoration: none;
	}

	/* Header */
	.site-header {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		z-index: 100;
		border-bottom: 1px solid var(--line);
		background: rgba(8, 13, 15, 0.85);
		backdrop-filter: blur(15px);
	}

	.header-inner {
		display: flex;
		justify-content: space-between;
		align-items: center;
		height: 64px;
	}

	.brand {
		display: flex;
		align-items: center;
		gap: 10px;
	}

	.brand-logo {
		font-size: 16px;
		font-weight: 900;
		color: var(--blue);
	}

	.brand strong {
		font-size: 0.95rem;
		letter-spacing: 0.08em;
	}

	.main-nav {
		display: flex;
		align-items: center;
		gap: 20px;
		font-size: 0.75rem;
		font-weight: 800;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--muted);
	}

	.main-nav a:hover {
		color: var(--ink);
	}

	.btn-intake {
		background: linear-gradient(135deg, rgba(120,175,208,0.15), rgba(63,86,96,0.1));
		border: 1px solid rgba(126,160,170,0.3);
		color: var(--ink) !important;
		padding: 6px 14px;
		border-radius: 6px;
		transition: all 0.2s ease;
	}

	.btn-intake:hover {
		border-color: var(--gold);
		background: linear-gradient(135deg, rgba(120,175,208,0.25), rgba(63,86,96,0.15));
		transform: translateY(-1px);
	}

	/* Main section spacing */
	main {
		margin-top: 64px;
		flex-grow: 1;
	}

	/* Footer */
	.site-footer {
		border-top: 1px solid var(--line);
		background: var(--paper-soft);
		margin-top: 60px;
		padding-block: 40px 20px;
	}

	.footer-inner {
		display: flex;
		flex-direction: column;
		gap: 30px;
	}

	.footer-brand {
		display: flex;
		flex-direction: column;
		gap: 12px;
	}

	.footer-mark {
		display: flex;
		align-items: center;
		gap: 8px;
		font-size: 1.1rem;
		font-weight: 900;
		letter-spacing: 0.08em;
	}

	.logo-text {
		color: var(--blue);
	}

	.footer-brand p {
		color: var(--muted);
		max-width: 500px;
		font-family: 'Lora', serif;
		font-size: 0.95rem;
		margin: 0;
	}

	.footer-bottom {
		display: flex;
		justify-content: space-between;
		border-top: 1px solid var(--line);
		padding-top: 16px;
		color: var(--muted);
		font-size: 0.72rem;
		text-transform: uppercase;
		letter-spacing: 0.06em;
	}

	@media (max-width: 600px) {
		.main-nav {
			gap: 12px;
			font-size: 0.7rem;
		}
		.btn-intake {
			padding: 4px 8px;
		}
		.footer-bottom {
			flex-direction: column;
			gap: 8px;
		}
	}
</style>
