t-size:clamp(1.8rem,4vw,3.2rem);letter-spacing:-.04em}.proof-card span{color:var(--muted);font-size:.78rem}.proof-note{margin-top:14px;padding:24px;display:grid;grid-template-columns:180px 1fr;gap:24px}.proof-note p{margin:0;color:var(--muted)}.boundaries{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}.boundaries article{padding:30px}.boundaries h2{margin:0 0 14px;font-size:clamp(1.45rem,3vw,2.2rem);letter-spacing:-.035em}.boundaries p{margin:0;color:var(--muted)}.nofit ul{margin:0;padding-left:18px;color:var(--muted)}.nofit li+li{margin-top:8px}.final{display:flex;align-items:center;justify-content:space-between;gap:34px;padding:clamp(30px,5vw,56px)}.final .lede{margin-bottom:0;max-width:760px}.final .button{flex:0 0 auto}@media(max-width:1040px){.deliverable-grid{grid-template-columns:repeat(3,1fr)}}@media(max-width:900px){.hero-grid,.section-head,.split{grid-template-columns:1fr}.scope-card{max-width:760px}.proof-grid{grid-template-columns:1fr 1fr}.final{align-items:flex-start;flex-direction:column}}@media(max-width:640px){.deliverable-grid,.proof-grid,.boundaries{grid-template-columns:1fr}.scope-row{grid-template-columns:1fr}.proof-note{grid-template-columns:1fr}.final .button{width:100%}}
</style>
