---
const buildSha = import.meta.env.VERCEL_GIT_COMMIT_SHA || 'local-preview';
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><meta name="theme-color" content="#071013"/><title>Site Agent Fleet Desk | BitEvo</title><style>:root{--bg:#071013;--panel:#0e1a1e;--line:#294148;--text:#f2f7f8;--muted:#9eb2b7;--accent:#a5f3d0;--warn:#f2d58a;--bad:#ffb4aa}*{box-sizing:border-box}body{margin:0;background:linear-gradient(180deg,#071013,#0a1518);color:var(--text);font:15px/1.55 Inter,system-ui,sans-serif}.w{width:min(1180px,calc(100% - 28px));margin:auto;padding:28px 0 80px}a{color:var(--accent)}h1{font-size:clamp(44px,7vw,78px);line-height:.93;letter-spacing:-.055em;margin:30px 0 14px}.lead{font-size:19px;color:var(--muted);max-width:900px}.row{display:flex;gap:8px;flex-wrap:wrap;margin:18px 0}.btn{border:1px solid var(--line);border-radius:12px;padding:10px 13px;background:#101f23;color:var(--text);font:inherit;font-weight:800;cursor:pointer}.primary{background:var(--accent);color:#082118;border-color:var(--accent)}.grid{display:grid;grid-template-columns:.85fr 1.15fr;gap:16px}.card{border:1px solid var(--line);background:var(--panel);border-radius:22px;padding:20px}textarea{width:100%;min-height:430px;background:#050b0d;color:#dce8eb;border:1px solid var(--line);border-radius:14px;padding:13px;font:13px/1.48 ui-monospace,monospace;resize:vertical}.status{padding:11px 13px;border:1px solid var(--line);border-radius:12px;color:var(--muted);margin-bottom:12px}.queue{display:grid;gap:10px}.item{border:1px solid var(--line);border-radius:15px;padding:14px;background:#0a1518}.item h3{margin:0 0 7px}.meta{font-size:12px;color:var(--muted)}.tags{display:flex;gap:6px;flex-wrap:wrap;margin-top:8px}.tag{border:1px solid var(--line);border-radius:999px;padding:4px 8px;font-size:11px}.blocked{color:var(--bad)}.needs{color:var(--warn)}.ready{color:var(--accent)}pre{white-space:pre-wrap;background:#050b0d;border:1px solid var(--line);border-radius:14px;padding:13px;max-height:330px;overflow:auto}.note{color:var(--warn);font-size:13px;margin-top:16px}footer{margin-top:24px;color:var(--muted);font-size:12px}@media(max-width:850px){.grid{grid-template-columns:1fr}}</style></head><body><main class="w"><a href="/site-agent-copilot-lab">← Owner Copilot Lab</a><h1>Fleet Owner Desk.</h1><p class="lead">One browser-local review queue for all site-agent lanes. Paste an array of <code>SITE_AGENT_ENVELOPE_V1</code> packets or load safe synthetic samples. The desk validates each packet against the shared policy pack, prioritizes blocked/needs-info items, and produces a human review queue. Nothing is transmitted or stored.</p><div class="row"><button class="btn" id="samples">Load 8 safe samples</button><button class="btn primary" id="run">Build review queue</button><button class="btn" id="copy">Copy queue JSON</button><button class="btn" id="download">Download queue</button><button class="btn" id="clear">Clear</button></div><div class="grid"><section class="card"><h2>Input envelopes</h2><div class="status" id="status">Policy not loaded yet.</div><textarea id="input" spellcheck="false" placeholder='[{"schema_version":"SITE_AGENT_ENVELOPE_V1",...}]'></textarea><p class="note">No credentials, ID documents, medical records, private content or payment data.</p></section><section class="card"><h2>Human review queue</h2><div class="queue" id="queue"><div class="status">No queue yet.</div></div><h2>Queue JSON</h2><pre id="output">No output yet.</pre></section></div><footer>Build: {buildSha} · noindex · browser-local · execute_authority=false · write_authority=false</footer></main><script src="/site-agent-fleet-desk.js" defer></script></body></html>