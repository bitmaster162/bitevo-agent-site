---
import Layout from '../layouts/Layout.astro';

const projects = [
  { type: 'Build index', name: 'BitEvo Build', href: '/build', text: 'Public index of shipped decision tools, source projects and research surfaces with source, build and runtime evidence kept distinct.', internal: true },
  { type: 'Service', name: 'Agent Authority & Evidence Audit', href: '/agent-authority-audit', text: 'Bounded engineering audit of agent authority, evidence chains, failure controls and operational traceability.', internal: true },
  { type: 'Project', name: 'ContinuityOS', href: '/continuityos', text: 'Public-source work on durable local memory, provenance and governance-oriented agent workflows.', internal: true },
  { type: 'Research', name: 'BitEvo Research Library', href: '/guides', text: 'Four reviewed public notes on agent authority, sandboxing, drift monitoring and tool-I/O contracts; historical notes stay offline until re-verified.', internal: true },
  { type: 'Research surface', name: 'Sovereign Arena', href: 'https://sovereign-arena-site.vercel.app/', text: 'Separate public research surface. Runtime claims and changing metrics are not duplicated here.', internal: false },
  { type: 'Research surface', name: 'Crypto & Trading Guides', href: 'https://cryptoguidessite.vercel.app/', text: 'Separate public guide portal. Dynamic operational counters are not mirrored into this navigator.', internal: false },
  { type: 'Source', name: 'ContinuityOS on GitHub', href: 'https://github.com/bitmaster162/continuityos', text: 'Public source repository used as the bounded installation path advertised by this site.', internal: false }
];

const mapNodes = [
  { label: 'AUDIT', name: 'Authority Audit', href: '/agent-authority-audit', className: 'node-audit' },
  { label: 'PRODUCT', name: 'Authority Mapper', href: '/mapper', className: 'node-mapper' },
  { label: 'BUILD', name: 'Public Works', href: '/build', className: 'node-build' },
  { label: 'SOURCE', name: 'ContinuityOS', href: '/continuityos', className: 'node-continuity' },
  { label: 'RESEARCH', name: 'Guides', href: '/guides', className: 'node-research' }
];
---

<Layout title="BitEvo Universe — Public Product & Research Navigator" description="A static public map of BitEvo services, built products, source projects and research surfaces without internal telemetry or infrastructure identifiers.">
  <section class="universe-hero section">
    <div class="container hero-grid">
      <div><div class="eyebrow">Public navigator</div><h1 class="display">One map. No fake control room.</h1></div>
      <div><p class="lede">BitEvo Universe is a static map of public services, shipped products, source projects and research surfaces. It deliberately excludes private operational state, infrastructure identifiers and live-control semantics.</p><div class="hero-actions"><a class="button button-primary" href="/build">See what is built <span aria-hidden="true">↗</span></a><a class="button button-ghost" href="/doctrine">Read the doctrine</a></div></div>
    </div>
  </section>

  <section class="section-tight section-rule">
    <div class="container map-shell panel" aria-label="Static BitEvo public-surface navigator">
      <div class="map-grid" aria-hidden="true"></div>
      <div class="core-node">
        <span class="pulse"></span>
        <small>PUBLIC CORE</small>
        <strong>BitEvo</strong>
        <p>authority · evidence · continuity · research</p>
      </div>
      <div class="orbit orbit-one" aria-hidden="true"></div>
      <div class="orbit orbit-two" aria-hidden="true"></div>
      {mapNodes.map(node => (
        <a class:list={['surface-node', node.className]} href={node.href}>
          <small>{node.label}</small>
          <strong>{node.name}</strong>
          <span aria-hidden="true">↗</span>
        </a>
      ))}
      <div class="map-note top-left">STATIC PUBLIC MAP</div>
      <div class="map-note bottom-right">NO RUNTIME TELEMETRY</div>
      <div class="map-legend" aria-label="Surface types"><span><i></i> service</span><span><i></i> product</span><span><i></i> source</span><span><i></i> research</span></div>
    </div>
  </section>

  <section class="section section-rule">
    <div class="container section-head">
      <div><div class="eyebrow">Public surfaces</div><h2 class="section-title">Navigate by what you need.</h2></div>
      <p class="lede">Commercial audit work, shipped decision products, public-source infrastructure and research are kept distinct so a visitor can tell an offer from a product, a product from a source project, and all of them from a research note.</p>
    </div>

    <div class="container project-grid">
      {projects.map((project, i) => (
        <a class="project-card panel" href={project.href} target={project.internal ? undefined : '_blank'} rel={project.internal ? undefined : 'noopener'}>
          <div class="project-top"><span>{String(i + 1).padStart(2,'0')}</span><small>{project.type}</small></div>
          <div><h3>{project.name}</h3><p>{project.text}</p></div>
          <div class="project-link">Open <span aria-hidden="true">↗</span></div>
        </a>
      ))}
    </div>
  </section>

  <section class="section section-rule">
    <div class="container boundary-grid">
      <div><div class="eyebrow">Boundary</div><h2 class="section-title">A navigator is not evidence of runtime health.</h2></div>
      <div class="boundary-copy"><p>No live state, changing service counts, private hosts, IP addresses, operator-control semantics, credentials or secret-bearing logs are published on this page.</p><p>When a commercial audit needs runtime evidence, it is collected inside the agreed staging/test scope and Rules of Engagement — not inferred from this public map.</p></div>
    </div>
  </section>
</Layout>

<style>
  .universe-hero{padding-top:clamp(78px,10vw,132px)}.hero-grid{display:grid;grid-template-columns:1.08fr .92fr;gap:clamp(40px,8vw,110px);align-items:end}.hero-grid .lede{margin:0 0 24px}.hero-actions{display:flex;gap:10px;flex-wrap:wrap}
  .map-shell{height:min(620px,68vw);min-height:430px;position:relative;overflow:hidden;display:grid;place-items:center;background:radial-gradient(circle at center,rgba(127,208,177,.1),transparent 22%),radial-gradient(circle at 80% 18%,rgba(115,185,216,.055),transparent 20rem),linear-gradient(180deg,rgba(13,25,27,.78),rgba(7,13,15,.8))}.map-grid{position:absolute;inset:0;background:linear-gradient(90deg,transparent 49.9%,rgba(255,255,255,.028) 50%,transparent 50.1%),linear-gradient(transparent 49.9%,rgba(255,255,255,.028) 50%,transparent 50.1%),linear-gradient(rgba(255,255,255,.012) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.012) 1px,transparent 1px);background-size:auto,auto,52px 52px,52px 52px;mask-image:radial-gradient(circle at center,black,transparent 76%)}.map-shell::after{content:'';position:absolute;inset:12%;border:1px solid rgba(174,211,202,.04);border-radius:50%;transform:rotate(24deg);pointer-events:none}.core-node{position:relative;z-index:5;width:200px;height:200px;border:1px solid rgba(127,208,177,.34);border-radius:50%;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;background:rgba(7,15,16,.92);box-shadow:0 0 0 10px rgba(127,208,177,.015),0 0 90px rgba(127,208,177,.1)}.pulse{width:8px;height:8px;border-radius:50%;background:var(--green);box-shadow:0 0 18px rgba(127,208,177,.55);margin-bottom:12px}.core-node small{color:var(--muted);font:500 .57rem var(--mono);letter-spacing:.11em}.core-node strong{font-size:1.55rem;letter-spacing:-.03em;margin:4px 0}.core-node p{max-width:150px;margin:0;color:var(--muted);font-size:.68rem}.orbit{position:absolute;border:1px solid var(--line);border-radius:50%;z-index:1;pointer-events:none}.orbit-one{width:410px;height:410px}.orbit-two{width:690px;height:690px;border-style:dashed;opacity:.52}.surface-node{position:absolute;z-index:6;min-width:148px;padding:11px 13px;border:1px solid rgba(174,211,202,.13);border-radius:13px;background:rgba(7,15,16,.88);box-shadow:0 12px 38px rgba(0,0,0,.24);transition:transform .18s ease,border-color .18s ease,background .18s ease}.surface-node:hover{transform:translateY(-3px);border-color:rgba(127,208,177,.42);background:rgba(12,24,25,.96)}.surface-node small{display:block;color:var(--green);font:500 .52rem var(--mono);letter-spacing:.11em}.surface-node strong{display:block;margin-top:3px;font-size:.76rem}.surface-node>span{position:absolute;right:10px;top:10px;color:#60716d;font-size:.7rem}.node-audit{left:8%;top:18%}.node-mapper{right:9%;top:20%}.node-build{left:12%;bottom:17%}.node-continuity{right:10%;bottom:18%}.node-research{left:50%;top:8%;transform:translateX(-50%)}.node-research:hover{transform:translateX(-50%) translateY(-3px)}.map-note{position:absolute;z-index:4;color:#5c6865;font:500 .57rem var(--mono);letter-spacing:.12em}.map-note.top-left{top:20px;left:22px}.map-note.bottom-right{right:22px;bottom:20px}.map-legend{position:absolute;z-index:4;left:22px;bottom:20px;display:flex;gap:14px;flex-wrap:wrap;color:#62706e;font:500 .55rem var(--mono);letter-spacing:.06em;text-transform:uppercase}.map-legend span{display:flex;align-items:center;gap:5px}.map-legend i{width:5px;height:5px;border-radius:50%;background:var(--green);opacity:.6}
  .section-head{display:grid;grid-template-columns:.8fr 1.2fr;gap:clamp(40px,8vw,110px);margin-bottom:38px}.section-head .lede{margin:3px 0 0}.project-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.project-card{min-height:300px;padding:24px;display:flex;flex-direction:column;justify-content:space-between;transition:transform .18s ease,border-color .18s ease,background .18s ease}.project-card:hover{transform:translateY(-4px);border-color:rgba(127,208,177,.34);background:linear-gradient(180deg,rgba(15,30,31,.92),rgba(8,16,18,.9))}.project-top{display:flex;justify-content:space-between;color:#58645f;font:500 .61rem var(--mono)}.project-top small{padding:4px 7px;border:1px solid rgba(127,208,177,.12);border-radius:999px;color:var(--green);letter-spacing:.08em;text-transform:uppercase}.project-card h3{margin:0 0 10px;font-size:1.12rem;letter-spacing:-.018em}.project-card p{margin:0;color:var(--muted);font-size:.8rem}.project-link{margin-top:26px;color:var(--ink-soft);font-size:.75rem;font-weight:650}.project-link span{display:inline-block;transition:transform .18s ease}.project-card:hover .project-link span{transform:translate(2px,-2px)}.boundary-grid{display:grid;grid-template-columns:.78fr 1.22fr;gap:clamp(40px,8vw,110px)}.boundary-copy{border-top:1px solid var(--line)}.boundary-copy p{margin:0;padding:18px 0;border-bottom:1px solid var(--line);color:var(--muted)}
  @media(max-width:900px){.hero-grid,.section-head,.boundary-grid{grid-template-columns:1fr}.project-grid{grid-template-columns:1fr 1fr}.map-shell{height:560px}.node-audit{left:4%}.node-mapper{right:4%}.node-build{left:7%}.node-continuity{right:7%}}
  @media(max-width:620px){.project-grid{grid-template-columns:1fr}.map-shell{height:620px;min-height:620px}.orbit-one{width:300px;height:300px}.orbit-two{width:510px;height:510px}.core-node{width:160px;height:160px}.surface-node{min-width:128px;padding:9px 10px}.surface-node strong{font-size:.7rem}.node-audit{left:18px;top:104px}.node-mapper{right:18px;top:104px}.node-build{left:18px;bottom:104px}.node-continuity{right:18px;bottom:104px}.node-research{top:28px}.map-legend{left:18px;right:18px;bottom:18px}.map-note.bottom-right{display:none}}
  @media(max-width:430px){.map-shell{height:650px}.surface-node{min-width:116px}.node-audit,.node-build{left:12px}.node-mapper,.node-continuity{right:12px}}
</style>
