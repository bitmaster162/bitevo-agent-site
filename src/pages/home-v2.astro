const screens={home:screenHome,pricing:screenPricing,inner:screenInner,des:screenDes};
function nav(p){
  document.getElementById('screen').innerHTML=(screens[p]||screenHome)();
  document.querySelectorAll('nav.links a').forEach(a=>a.classList.toggle('active',a.dataset.name===p));
  window.scrollTo(0,0);
  if(p==='home'){ const a=document.getElementById('hA'),b=document.getElementById('hB');
    if(a)a.onclick=()=>{hero='A';document.getElementById('heroWrap').innerHTML=heroBlock();bindHero();};
    if(b)b.onclick=()=>{hero='B';document.getElementById('heroWrap').innerHTML=heroBlock();bindHero();}; }
}
function bindHero(){ const a=document.getElementById('hA'),b=document.getElementById('hB');
  if(a)a.onclick=()=>{hero='A';document.getElementById('heroWrap').innerHTML=heroBlock();bindHero();};
  if(b)b.onclick=()=>{hero='B';document.getElementById('heroWrap').innerHTML=heroBlock();bindHero();}; }
