---
// FAITHFUL port of Claude Design's BitevoUniverse.dc.html → self-contained preview (all 4 screens + nav routing + hero A/B).
// Tokens/components reconstructed as plain CSS (DS _ds assets not available locally). Additive route /home-v2, noindex. Not prod.
---
<!doctype html>
<html lang="ru">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="robots" content="noindex" />
<title>BITEVO UNIVERSE — redesign preview</title>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;800;900&family=Space+Grotesk:wght@400;500;700&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet" />
<style>
  :root{
    --page-bg:#05060a; --ink-950:#080a11; --ink-850:#0e1220;
    --surface:#0b0f18; --surface-sunken:#080b12;
    --border:#1b2230; --border-strong:#2b3852;
    --text:#e7ecf3; --text-muted:#8b96a9; --text-faint:#5c6678;
    --gold-600:#d99a10; --gold-500:#f4b41a; --gold-400:#ffc94a; --gold-glow:rgba(244,180,26,.28);
    --positive:#34e57a; --negative:#ff5c72; --accent:#34e57a; --cyan-400:#7fd0ff; --amber-500:#f4b41a; --red-400:#ff8a8a;
    --font-display:'Playfair Display',Georgia,serif; --font-body:'Space Grotesk',system-ui,sans-serif; --font-mono:'JetBrains Mono',ui-monospace,monospace;
    --r-sm:7px; --r-md:10px; --r-lg:16px; --r-xl:22px; --r-pill:999px;
    --fs-display:clamp(2.4rem,6vw,4rem); --fs-h1:clamp(2rem,4.5vw,3rem); --fs-h2:clamp(1.55rem,3vw,2.1rem); --fs-h3:1.4rem; --fs-h4:1.1rem; --fs-body-lg:1.1rem; --fs-sm:.9rem;
    --section-y:clamp(48px,7vw,86px); --container-max:1140px; --container-narrow:820px;
    --grid-dot:radial-gradient(circle at 1px 1px,#ffffff0a 1px,transparent 0); --grid-dot-size:22px 22px;
    --shadow-card:0 14px 34px #00000055;
  }
  *{box-sizing:border-box;margin:0;padding:0}
  html,body{background:var(--page-bg);color:var(--text);font-family:var(--font-body);line-height:1.55;-webkit-font-smoothing:antialiased}
  h1,h2,h3{font-family:var(--font-display);line-height:1.06;letter-spacing:-.01em}
  a{color:inherit;text-decoration:none}
  .eyebrow{font-family:var(--font-mono);font-size:11px;letter-spacing:.2em;text-transform:uppercase;color:var(--text-faint)}
  .wrapx{max-width:var(--container-max);margin:0 auto}
  /* header */
  header{position:sticky;top:0;z-index:40;display:flex;align-items:center;gap:22px;padding:14px clamp(18px,4vw,44px);background:#05060add;backdrop-filter:blur(12px);border-bottom:1px solid var(--border)}
  .logo{display:flex;align-items:center;gap:9px;font-family:var(--font-display);font-weight:800;font-size:18px;cursor:pointer}
  .logo .mk{color:var(--gold-500);letter-spacing:-3px;font-size:19px}
  .logo .u{color:var(--text-faint);font-weight:500;font-size:11px;font-family:var(--font-mono);letter-spacing:.14em}
  nav.links{display:flex;gap:2px;margin-left:12px}
  nav.links a{font-family:var(--font-mono);font-size:12px;letter-spacing:.04em;padding:7px 10px;border-radius:var(--r-sm);color:var(--text-muted);cursor:pointer}
  nav.links a:hover,nav.links a.active{color:var(--gold-400)}
  .hend{margin-left:auto}
  /* buttons */
  .btn{display:inline-flex;align-items:center;gap:8px;font-family:var(--font-body);font-weight:700;font-size:14px;padding:11px 18px;border-radius:var(--r-md);cursor:pointer;border:1px solid transparent;transition:transform .12s,border-color .12s,background .12s}
  .btn:hover{transform:translateY(-1px)}
  .btn.sm{padding:7px 14px;font-size:13px}
  .btn.full{width:100%;justify-content:center}
  .btn.primary{background:var(--gold-500);color:#1a1400}
  .btn.secondary{border-color:var(--border-strong);color:var(--text)}
  .btn.ghost{color:var(--text-muted)}
  .btn.ghost:hover{color:var(--text)}
  /* tag & badge */
  .tag{display:inline-flex;align-items:center;gap:6px;font-family:var(--font-mono);font-size:11px;padding:4px 10px;border-radius:var(--r-pill);border:1px solid}
  .tag.green{color:var(--positive);border-color:#1c5a33;background:#0c1f15}
  .tag.amber{color:var(--gold-400);border-color:#5a4a12;background:#1c1608}
  .tag.cyan{color:var(--cyan-400);border-color:#1c4a5a;background:#08161c}
  .tag.solid{background:var(--positive);color:#05130b;border-color:transparent}
  .badge{display:inline-flex;align-items:center;gap:6px;font-family:var(--font-mono);font-size:10px;letter-spacing:.08em;padding:4px 9px;border-radius:var(--r-pill);border:1px solid var(--border)}
  .badge .d{width:6px;height:6px;border-radius:50%}
  .badge.live{color:var(--positive)} .badge.live .d{background:var(--positive);box-shadow:0 0 7px var(--positive)}
  .badge.info{color:var(--cyan-400)} .badge.info .d{background:var(--cyan-400)}
  .badge.idle{color:var(--text-faint)} .badge.idle .d{background:#3a4353}
  /* metric */
  .metric .ml{font-family:var(--font-mono);font-size:10px;letter-spacing:.1em;text-transform:uppercase;color:var(--text-faint);margin-bottom:6px}
  .metric .mv{font-family:var(--font-mono);font-size:1.35rem;font-weight:700;color:var(--text)}
  .mv.negative{color:var(--negative)} .mv.positive{color:var(--positive)} .mv.info{color:var(--cyan-400)}
  /* ticker */
  .ticker{display:flex;flex-wrap:wrap;gap:7px 24px;padding:11px clamp(18px,4vw,44px);border-bottom:1px solid var(--border);background:var(--ink-950);font-family:var(--font-mono);font-size:11px}
  .ticker .ti{color:var(--text-faint)} .ticker .ti b{margin-left:5px}
  .tv-info{color:var(--cyan-400)} .tv-warn{color:var(--gold-400)} .tv-negative{color:var(--negative)} .tv-positive{color:var(--positive)}
  /* layout helpers */
  section{padding:var(--section-y) clamp(18px,4vw,44px)}
  .bd-top{border-top:1px solid var(--border)}
  .dotbg{background-image:var(--grid-dot);background-size:var(--grid-dot-size)}
  .card{border:1px solid var(--border);border-radius:var(--r-lg);background:var(--surface);box-shadow:var(--shadow-card)}
  .lift{transition:transform .15s,border-color .15s} .lift:hover{transform:translateY(-3px);border-color:var(--border-strong)}
  .grid-auto{display:grid;gap:16px}
  .console{border:1px solid var(--border);border-radius:var(--r-lg);overflow:hidden;background:var(--surface);box-shadow:var(--shadow-card)}
  .console .hd{display:flex;align-items:center;gap:10px;padding:12px 16px;border-bottom:1px solid var(--border);background:var(--surface-sunken);font-family:var(--font-mono);font-size:11px;color:var(--text-faint)}
  .hero-grid{display:grid;grid-template-columns:1.15fr .85fr;gap:52px;align-items:center;max-width:var(--container-max);margin:0 auto}
  .split{display:grid;grid-template-columns:1fr 1fr;gap:48px;align-items:center;max-width:var(--container-max);margin:0 auto}
  code.pill{display:inline-block;font-family:var(--font-mono);font-size:14px;color:var(--text-muted);background:var(--surface-sunken);border:1px solid var(--border);border-radius:var(--r-sm);padding:9px 14px}
  code.pill span{color:var(--accent)}
  .hero-h1{font-size:var(--fs-display);margin:0 0 22px;font-weight:900}
  .lead{font-size:var(--fs-body-lg);color:var(--text-muted);margin-bottom:28px}
  .gold{color:var(--gold-500)}
  .note{font-family:var(--font-mono);font-size:11px;color:var(--text-faint)}
  .heroToggle{display:flex;align-items:center;gap:10px;padding:16px clamp(18px,4vw,44px) 0;max-width:var(--container-max);margin:0 auto}
  .heroToggle .tg{display:flex;border:1px solid var(--border);border-radius:var(--r-pill);overflow:hidden;font-family:var(--font-mono);font-size:11px}
  .heroToggle button{cursor:pointer;padding:6px 14px;border:0;letter-spacing:.1em;background:transparent;color:var(--text-muted)}
  .heroToggle button.on{background:var(--gold-500);color:#1a1400}
  .flag{position:fixed;bottom:12px;left:12px;z-index:60;background:#12080c;border:1px solid var(--gold-500);color:var(--gold-400);font-family:var(--font-mono);font-size:11px;padding:6px 12px;border-radius:var(--r-pill)}
  footer{border-top:1px solid var(--border);padding:52px clamp(18px,4vw,44px) 40px;background:var(--ink-950)}
  @media(max-width:820px){ nav.links{display:none} .hero-grid,.split{grid-template-columns:1fr!important;gap:30px} }
</style>
</head>
<body>
  <header>
    <div class="logo" data-nav="home"><span class="mk">◢◤</span> BITEVO <span class="u">UNIVERSE</span></div>
    <nav class="links">
      <a data-nav="home">Universe</a><a>Cockpit</a><a data-nav="des">Consulting</a>
      <a>AI Guides</a><a>Crypto Library ↗</a><a data-nav="pricing" data-name="pricing">Pricing</a>
    </nav>
    <div class="hend"><button class="btn primary sm" data-nav="des"><span>◢◤</span> Get Started</button></div>
  </header>
  <main id="screen"></main>
  <footer><div class="wrapx" id="footer"></div></footer>
  <div class="flag">PREVIEW /home-v2 · Claude Design port · не прод</div>

