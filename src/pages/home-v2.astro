const esc=s=>String(s);
const btn=(label,variant,extra="")=>`<button class="btn ${variant} ${extra}">${label}</button>`;
const tag=(txt,tone,glyph="",solid=false)=>`<span class="tag ${tone}${solid?' solid':''}">${glyph?glyph+' ':''}${txt}</span>`;
const badge=(txt,tone)=>`<span class="badge ${tone}"><span class="d"></span>${txt}</span>`;
const metric=(m,size="")=>`<div class="metric"><div class="ml">${m.l}</div><div class="mv ${m.t||''}" style="${size==='sm'?'font-size:1.1rem':''}">${m.v}</div></div>`;
const feat=arr=>arr.map(f=>`<div style="display:flex;gap:9px;font-size:var(--fs-sm);color:var(--text-muted)"><span style="color:var(--accent);flex-shrink:0">▸</span><span>${f}</span></div>`).join('');

let hero="A";
