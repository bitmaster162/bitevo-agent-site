         ${D.edges.map(e=>`<div style="background:var(--ink-850);padding:18px"><div style="display:flex;align-items:center;gap:8px;margin-bottom:8px">${tag(e.tag,"green","",true)}<span style="font-family:var(--font-mono);font-size:13px;font-weight:700;color:var(--positive)">${e.pnl}</span></div><div class="note">${e.detail}</div></div>`).join('')}
