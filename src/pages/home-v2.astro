---
// PREVIEW of the BITEVO UNIVERSE redesign (Home). Additive route /home-v2 — does NOT touch the live Home.
// Hybrid palette (locked): gold #f4b41a = brand/display, green = live/positive signal, on #05060a. Serif display, mono numbers. 0 fake numbers.
const nav = [
  { label: "Universe", href: "/universe" },
  { label: "Cockpit", href: "/cockpit" },
  { label: "Consulting", href: "/consulting" },
  { label: "AI Guides", href: "/guides" },
  { label: "Pricing", href: "/pricing" },
];
const ticker = [
  { k: "TRADING", v: "PAPER · PHASE A", live: true },
  { k: "CONTINUITY", v: "PROVEN ACROSS MODEL SWAPS", live: true },
  { k: "LEDGER", v: "HASH-CHAINED", live: true },
  { k: "DATA", v: "LOCAL-FIRST", live: false },
];
const ops = [
  { icon: "🧠", title: "Durable memory", body: "ContinuityOS: гибридная память (FTS+вектор), event-sourced identity, переживает смену модели и контейнера. Apache-2.0, на PyPI." },
  { icon: "🛡️", title: "Governance gate", body: "Default-DENY гейт, capability-паспорта, hash-chain журнал каждого решения — воспроизводимо под аудит (EU AI Act Art-12)." },
  { icon: "🎛️", title: "Orchestrator", body: "Orca: мульти-модельный оркестратор (Claude + Hermes + OpenClaw) под одним каноном, с fork/merge и anti-looping." },
];
const proof = [
  { n: "70,946", l: "paper-сделок в логе" },
  { n: "0 / 29", l: "gate-pass (честно)" },
  { n: "2", l: "OOS-верифицированных эджа" },
  { n: "3×", l: "continuity через смену модели" },
];
---
<html lang="ru">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex" />
  <title>BitEvo Universe — Durable AI Orchestrator (preview)</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;800;900&family=Space+Grotesk:wght@400;500;700&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet" />
  <style>
    :root{
      --bg:#05060a; --ink:#e7ecf3; --dim:#8792a6; --line:#1b2230; --card:#0b0f18;
      --gold:#f4b41a; --green:#34e57a; --cyan:#7fd0ff; --violet:#b98cff;
      --serif:'Playfair Display',Georgia,serif; --sans:'Space Grotesk',system-ui,sans-serif; --mono:'JetBrains Mono',ui-monospace,monospace;
    }
    *{box-sizing:border-box;margin:0;padding:0}
    body{background:radial-gradient(1200px 620px at 50% -12%, #0d1424 0%, var(--bg) 62%);color:var(--ink);font-family:var(--sans);line-height:1.55;-webkit-font-smoothing:antialiased}
    a{color:inherit;text-decoration:none}
    .wrap{max-width:1140px;margin:0 auto;padding:0 22px}
    /* header */
    header{position:sticky;top:0;z-index:20;backdrop-filter:blur(10px);background:#05060acc;border-bottom:1px solid var(--line)}
    .bar{display:flex;align-items:center;gap:22px;height:62px}
    .brand{font-family:var(--serif);font-weight:900;font-size:20px;letter-spacing:.02em}
    .brand b{color:var(--gold)}
    nav.main{display:flex;gap:20px;margin-left:8px;font-size:14px;color:var(--dim)}
    nav.main a:hover{color:var(--ink)}
    .cta{margin-left:auto;display:flex;gap:10px}
    .btn{padding:9px 16px;border-radius:9px;font-weight:700;font-size:14px}
    .btn-gold{background:var(--gold);color:#0a0a0a}
    .btn-ghost{border:1px solid var(--line);color:var(--ink)}
    .btn:hover{transform:translateY(-1px)}
    /* ticker */
    .ticker{display:flex;flex-wrap:wrap;gap:8px 26px;padding:11px 0;border-bottom:1px solid var(--line);font-family:var(--mono);font-size:12px;color:var(--dim)}
    .ticker b{color:var(--ink);font-weight:600}
    .dot{display:inline-block;width:7px;height:7px;border-radius:50%;background:var(--green);box-shadow:0 0 8px var(--green);margin-right:6px;vertical-align:middle}
    .dot.off{background:#3a4353;box-shadow:none}
    /* hero */
    .hero{text-align:center;padding:74px 0 46px}
    .kicker{font-family:var(--mono);font-size:12px;letter-spacing:.28em;text-transform:uppercase;color:var(--gold)}
    h1{font-family:var(--serif);font-weight:900;font-size:clamp(2.4rem,6vw,4.2rem);line-height:1.04;margin:16px 0 0;
       background:linear-gradient(96deg,#fff,#cfe6ff 55%,var(--violet));-webkit-background-clip:text;background-clip:text;color:transparent}
    .sub{max-width:660px;margin:20px auto 0;color:var(--dim);font-size:1.08rem}
    .hero-cta{margin-top:26px;display:flex;gap:12px;justify-content:center;flex-wrap:wrap}
    /* sections */
    section{padding:44px 0}
    .h2{font-family:var(--serif);font-weight:800;font-size:1.7rem;margin-bottom:20px}
    .grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
    .card{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:22px;transition:transform .15s,border-color .15s,box-shadow .15s}
    .card:hover{transform:translateY(-3px);border-color:#2b3852;box-shadow:0 12px 30px #0008}
    .card .ic{font-size:24px}
    .card h3{font-size:1.08rem;margin:10px 0 6px}
    .card p{color:var(--dim);font-size:.93rem}
    /* proof */
    .proof{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;background:#0a0e16;border:1px solid var(--line);border-radius:18px;padding:26px}
    .proof .n{font-family:var(--mono);font-weight:600;font-size:2rem;color:var(--gold);font-variant-numeric:tabular-nums}
    .proof .l{color:var(--dim);font-size:.82rem;margin-top:4px}
    .proof .note{grid-column:1/-1;color:var(--dim);font-size:.8rem;border-top:1px solid var(--line);padding-top:12px}
    /* cta band */
    .band{display:flex;flex-wrap:wrap;gap:16px;align-items:center;justify-content:space-between;background:linear-gradient(100deg,#12080c,#0b0f18);border:1px solid #ffd16633;border-radius:18px;padding:28px}
    .band h3{font-family:var(--serif);font-size:1.5rem}
    footer{border-top:1px solid var(--line);margin-top:30px;padding:28px 0 60px;color:var(--dim);font-size:13px}
    .preview-flag{position:fixed;bottom:12px;left:12px;z-index:50;background:#12080c;border:1px solid var(--gold);color:var(--gold);font-family:var(--mono);font-size:11px;padding:6px 12px;border-radius:999px}
    @media(max-width:820px){ .grid3,.proof{grid-template-columns:1fr 1fr} nav.main{display:none} }
    @media(max-width:520px){ .proof{grid-template-columns:1fr} }
  </style>
</head>
<body>
  <header>
    <div class="wrap">
      <div class="bar">
        <a href="/" class="brand">◢◤ BIT<b>EVO</b></a>
        <nav class="main">{nav.map(n => <a href={n.href}>{n.label}</a>)}</nav>
        <div class="cta">
          <a class="btn btn-ghost" href="https://cryptoguidessite.vercel.app">Crypto Library ↗</a>
          <a class="btn btn-gold" href="/intake">Get Started</a>
        </div>
      </div>
      <div class="ticker">
        {ticker.map(t => (<span><span class={t.live ? "dot" : "dot off"}></span>{t.k}: <b>{t.v}</b></span>))}
      </div>
    </div>
  </header>

  <div class="wrap">
    <div class="hero">
      <div class="kicker">Durable AI · Governance-first · Local-first</div>
      <h1>Durable AI Orchestrator</h1>
      <p class="sub">Мы строим AI-агентов, которые <b>помнят</b>, работают <b>под гейтом</b> и оставляют
        <b>воспроизводимый след</b> каждого решения. Ядро — open-source. Торговля — на paper, цифры честные.</p>
      <div class="hero-cta">
        <a class="btn btn-gold" href="/digital-entity-setup">🧬 Digital Entity Setup</a>
        <a class="btn btn-ghost" href="/pricing">Смотреть цены</a>
      </div>
    </div>

    <section>
      <div class="h2">Core Operations</div>
      <div class="grid3">
        {ops.map(o => (
          <div class="card">
            <div class="ic">{o.icon}</div>
            <h3>{o.title}</h3>
            <p>{o.body}</p>
          </div>
        ))}
      </div>
    </section>

    <section>
      <div class="h2">Proof — честные цифры арены</div>
      <div class="proof">
        {proof.map(p => (<div><div class="n">{p.n}</div><div class="l">{p.l}</div></div>))}
        <div class="note">Всё на paper — реальными деньгами не торгуем. Lifetime paper-результат отрицательный,
          и мы показываем это открыто. 150+ ботов — коррелированные вариации гипотез, не 150 доказательств. Не финансовый совет.</div>
      </div>
    </section>

    <section>
      <div class="band">
        <div>
          <h3>Готов собрать свою AI-операционную систему?</h3>
          <p style="color:var(--dim);margin-top:6px">Память + гейт + журнал + оркестратор под ключ. Или начни с бесплатной диагностики агента.</p>
        </div>
        <div style="display:flex;gap:10px;flex-wrap:wrap">
          <a class="btn btn-gold" href="/intake">Оставить заявку</a>
          <a class="btn btn-ghost" href="/ai-audit">AI-Audit (free триаж)</a>
        </div>
      </div>
    </section>

    <footer>
      <div style="display:flex;gap:26px;flex-wrap:wrap;justify-content:space-between">
        <div>◢◤ <b style="color:var(--gold)">BITEVO UNIVERSE</b> · Durable AI Orchestrator</div>
        <div style="display:flex;gap:18px;flex-wrap:wrap">
          <a href="/universe">Universe</a><a href="https://sovereign-arena-site.vercel.app">Arena</a>
          <a href="/guides">Guides</a><a href="https://github.com/bitmaster162/continuityos">GitHub</a>
          <a href="https://pypi.org/project/continuityos/">PyPI</a>
        </div>
      </div>
    </footer>
  </div>

  <div class="preview-flag">PREVIEW /home-v2 · редизайн-направление · не прод</div>
</body>
</html>
