---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Inner Circle — Archived BitEvo Offer" description="This legacy BitEvo subscription page is archived and is not a current public commercial offer." robots="noindex, follow">
  <section class="archive section">
    <div class="narrow archive-card panel">
      <div class="eyebrow">Archived commercial surface</div>
      <h1 class="page-title">Inner Circle is not a current public offer.</h1>
      <p class="lede">Legacy subscription tiers and trading-signal pricing on this route have been retired so they cannot be mistaken for the current BitEvo commercial offer.</p>
      <div class="boundary"><strong>Current public commercial focus:</strong><span>Agent Authority & Evidence Audit — bounded engineering work with explicit scope and Rules of Engagement.</span></div>
      <div class="actions">
        <a class="button button-primary" href="/agent-authority-audit">Current audit offer <span aria-hidden="true">↗</span></a>
        <a class="button" href="/guides">Research library</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .archive{min-height:64vh;display:grid;place-items:center}.archive-card{padding:clamp(34px,7vw,72px);text-align:center}.archive-card .page-title{margin-inline:auto}.archive-card .lede{margin:22px auto}.boundary{max-width:680px;margin:30px auto;padding:18px;border-top:1px solid var(--line);border-bottom:1px solid var(--line);display:grid;gap:6px}.boundary strong{font-size:.82rem}.boundary span{color:var(--muted);font-size:.78rem}.actions{display:flex;gap:10px;justify-content:center;flex-wrap:wrap}
</style>
