---
import Layout from '../layouts/Layout.astro';

const tiers = [
  { name: "Signal", price: "$97", unit: "/мес", color: "#66ffe0",
    perks: [
      "Inner Circle Telegram-канал: research-заметки лаборатории",
      "Лента сигналов валидированных арена-ботов: entry / SL / TP / size",
      "Еженедельный обзор режимов рынка (regime radar)",
    ] },
  { name: "Research", price: "$297", unit: "/мес", color: "#ffd166", featured: true,
    perks: [
      "Всё из Signal",
      "Внутренние отчёты лаборатории + ранний доступ к находкам",
      "Strategy Autopsy: разборы наших убытков — где, почему, что дальше",
      "Edge-матрица по режимам (полный доступ)",
    ] },
  { name: "Direct", price: "$797", unit: "/мес", color: "#b366ff",
    perks: [
      "Всё из Research",
      "Прямой Q&A по стратегиям, ботам и AI-агентам",
      "Приоритетный разбор твоего кейса",
      "Мест ограниченно",
    ] },
];
---

<Layout title="Inner Circle — BitEvo Universe (research-доступ, честно)">
  <section class="hero-section">
    <div class="container" style="text-align:center;padding-block:56px 16px">
      <div class="kicker" style="color:var(--gold,#ffd166)">💎 Research-доступ · не сигнал-хайп</div>
      <h1 style="font-family:'Playfair Display',serif;font-size:clamp(2.1rem,5vw,3.2rem);font-weight:900;margin:8px 0 0">Inner Circle</h1>
      <p style="max-width:700px;margin:14px auto 0;color:var(--muted);font-size:1.05rem;line-height:1.6">
        Доступ во внутрь открытой лаборатории: research-заметки, ранние находки, лента сигналов
        <b>валидированных</b> ботов и честные разборы наших убытков. Мы не продаём прибыль — мы продаём прозрачность процесса.
      </p>
      <div style="margin-top:22px;display:flex;gap:12px;justify-content:center;flex-wrap:wrap">
        <a href="https://t.me/bitai1_bot" style="padding:11px 22px;background:var(--gold,#ffd166);color:#0a0a0a;font-weight:800;border-radius:9px;text-decoration:none">🤖 Открыть в Telegram</a>
        <a href="/intake" style="padding:11px 22px;border:1px solid #2a3550;color:#e2e8f0;border-radius:9px;text-decoration:none">Оставить заявку</a>
      </div>
    </div>
  </section>

  <section class="container" style="max-width:1040px;padding-block:26px 10px">
    <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:16px" class="tier-grid">
      {tiers.map(t => (
        <div style={`background:#0b1220;border:1px solid ${t.featured ? 'var(--gold,#ffd166)' : '#1e2b45'};border-radius:16px;padding:24px;display:flex;flex-direction:column;gap:12px;position:relative`}>
          {t.featured && <div style="position:absolute;top:-11px;left:24px;background:var(--gold,#ffd166);color:#0a0a0a;font-size:0.72rem;font-weight:800;padding:3px 10px;border-radius:999px">ПОПУЛЯРНЫЙ</div>}
          <div style={`font-weight:800;font-size:0.82rem;text-transform:uppercase;letter-spacing:0.1em;color:${t.color}`}>{t.name}</div>
          <div style="display:flex;align-items:baseline;gap:8px">
            <span style="font-size:2rem;font-weight:900;color:#e2e8f0;font-variant-numeric:tabular-nums">{t.price}</span>
            <span style="color:var(--muted);font-size:0.9rem">{t.unit}</span>
          </div>
          <ul style="margin:0;padding:0;list-style:none;display:flex;flex-direction:column;gap:8px;flex:1">
            {t.perks.map(p => (
              <li style="color:var(--muted);font-size:0.9rem;line-height:1.5;display:flex;gap:8px"><span style={`color:${t.color}`}>✓</span><span>{p}</span></li>
            ))}
          </ul>
          <a href="https://t.me/bitai1_bot" style={`text-align:center;padding:11px 16px;border-radius:9px;font-weight:800;text-decoration:none;${t.featured ? 'background:var(--gold,#ffd166);color:#0a0a0a' : 'border:1px solid #2a3550;color:#e2e8f0'}`}>Вступить</a>
        </div>
      ))}
    </div>
  </section>

  <section class="container" style="max-width:960px;padding-block:26px 6px">
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px" class="tier-grid">
      <div style="background:#0a1512;border:1px solid #16c78444;border-radius:14px;padding:20px">
        <h3 style="margin:0 0 10px;color:#16c784;font-size:1.05rem">✓ Что это</h3>
        <p style="margin:0;color:var(--muted);font-size:0.92rem;line-height:1.6">Окно в реальный research: гипотезы, режимы рынка, что сработало и что мы похоронили. Сигналы — только по ботам, прошедшим валидацию на paper. Образование и прозрачность.</p>
      </div>
      <div style="background:#160a0a;border:1px solid #ff445544;border-radius:14px;padding:20px">
        <h3 style="margin:0 0 10px;color:#ff4455;font-size:1.05rem">✗ Чего это не</h3>
        <p style="margin:0;color:var(--muted);font-size:0.92rem;line-height:1.6">Не гарантия прибыли, не «AI предсказывает крипту», не управление твоими деньгами. Мы реальными деньгами не торгуем. Ничто здесь не финансовый совет.</p>
      </div>
    </div>
  </section>

  <section class="container" style="max-width:960px;padding-block:20px 48px">
    <div style="background:#160a1e;border:1px solid #ff00ea44;border-radius:16px;padding:22px;color:#d9c2e8;line-height:1.6">
      <b style="color:var(--gold,#ffd166)">Честно про эдж.</b>
      Актуальные bot/edge counts намеренно не дублируются на этой странице: меняющиеся числа должны читаться только из текущего timestamped evidence snapshot в Sovereign Arena. Подписка оплачивает доступ к процессу и находкам, а не обещанную доходность.
    </div>
  </section>

  <style>@media (max-width:820px){ .tier-grid { grid-template-columns:1fr !important; } }</style>
</Layout>
