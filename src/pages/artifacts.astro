---
import Layout from '../layouts/Layout.astro';

const artifacts = [
  { code: 'A1', name: 'Authority Ledger', purpose: 'Define exactly what consequential actions exist and what must constrain them.', fields: ['Critical action','Target object / object binding','Authority owner','Approval path','Allowed transitions','Prohibited transitions','Retry / replay rights','Recovery owner'], decision: 'What authority exists now, and which part should expand, contract or remain conditional?' },
  { code: 'A2', name: 'Evidence Contract', purpose: 'Turn “the agent should know enough” into explicit evidence requirements at decision time.', fields: ['Required input','Provenance','Freshness requirement','Object binding','Approval evidence','Version / configuration context','External confirmation','Behavior when evidence is missing'], decision: 'What must be true before the workflow is allowed to spend its Authority Budget?' },
  { code: 'A3', name: 'Finding Record', purpose: 'Preserve a reproducible failure without inflating a hypothesis into a conclusion.', fields: ['Trigger','Authority involved','Evidence observed','External effect','Recovery behavior','Reproduction steps','Consequence','Evidence quality / uncertainty'], decision: 'Is the failure decision-relevant enough to constrain, repair or retest?' },
  { code: 'A4', name: 'Decision Memo', purpose: 'Translate evidence into one bounded owner action instead of a generic risk score.', fields: ['Owner question','Decision','Evidence supporting it','Residual uncertainty','Required control change','Authority after decision','Retest criterion','Named owner'], decision: 'EXPAND / CONSTRAIN / REPAIR / RETEST.' }
];

const proofCases = [
  ['SAMPLE-001','CRM write','/sample-audit','False Green / external-effect confirmation gap','CONSTRAIN'],
  ['SAMPLE-002','Outbound message','/sample-message','Recipient + approval binding gap','CONSTRAIN'],
  ['SAMPLE-003','Deployment / config','/sample-deployment','Environment + baseline/version binding gap','REPAIR']
];

const sample = [
  ['Intent','Update one CRM lead record after qualification.'],
  ['Authority Budget','May update status + qualification fields on the matched lead only. May not create contacts, send messages or modify unrelated records.'],
  ['Evidence Before Effect','Lead identity matched; qualification source is fresh; approval state is valid; expected CRM object/version context is present.'],
  ['External confirmation','Read-back confirms the intended fields changed on the same lead object.'],
  ['False Green trigger','Internal tool call reports success, but read-back is absent, stale or points to a different object.'],
  ['Recovery','Do not retry blindly. Constrain the write path, preserve the trace and reconcile before another mutation.'],
  ['Owner decision','Keep authority constrained until object binding and external confirmation are explicit gates.']
];
---

<Layout title="Audit Artifacts — BitEvo Authority & Evidence Audit" description="Public anatomy of the BitEvo Authority Ledger, Evidence Contract, Finding Record and Decision Memo used to turn agent-workflow evidence into owner decisions.">
  <section class="artifact-hero section">
    <div class="container hero-grid"><div><div class="eyebrow">Audit artifacts</div><h1 class="display">The method ends in inspectable artifacts, not a trust score.</h1></div><div><p class="lede">These public structures show what the primary audit is designed to produce. They are templates and worked examples, not customer evidence or certification.</p><div class="hero-actions"><a href="/mapper" class="button button-primary">Draft Authority Ledger + Evidence Contract <span aria-hidden="true">↗</span></a><a href="/proof" class="button button-ghost">Open proof matrix</a></div></div></div>
  </section>

  <section class="section-tight section-rule"><div class="container artifact-stack">{artifacts.map(a => <article class="artifact panel"><div class="artifact-code">{a.code}</div><div class="artifact-title"><div class="eyebrow">Decision-grade artifact</div><h2>{a.name}</h2><p>{a.purpose}</p></div><div class="artifact-body"><div><span class="label">Minimum structure</span><ul>{a.fields.map(f => <li>{f}</li>)}</ul></div><div class="decision"><span>OWNER QUESTION</span><p>{a.decision}</p></div></div></article>)}</div></section>

  <section class="section section-rule">
    <div class="container toolchain panel">
      <div><div class="eyebrow">Local artifact chain</div><h2 class="section-title">Draft, compare, then scope — without fabricating findings.</h2><p class="lede">The public tools cover planning and owner-decision structure. A Finding Record remains an evidence artifact from actual scoped testing; BitEvo does not manufacture one from a form.</p></div>
      <div class="toolchain-grid">
        <a href="/mapper"><span>01 · MAPPER</span><strong>Draft A1 + A2</strong><p>Build an Authority Ledger, Evidence Contract, failure hypotheses and explicit unresolved gates for one external action.</p><i>Open Mapper ↗</i></a>
        <a href="/workspace"><span>02 · WORKSPACE</span><strong>Compare + draft A4</strong><p>Save before/after checkpoints, inspect exact deltas and generate a bounded local Decision Memo.</p><i>Open Workspace ↗</i></a>
        <a href="/audit-intake"><span>03 · INTAKE</span><strong>Add scope + RoE</strong><p>Add owner, access, data and Rules-of-Engagement boundaries before any testing can be authorized.</p><i>Prepare scope ↗</i></a>
      </div>
    </div>
  </section>

  <section class="section section-rule">
    <div class="container proof-head"><div><div class="eyebrow">Proof matrix</div><h2 class="section-title">Same artifacts across three different external effects.</h2></div><p class="lede">The artifact names stay stable while the authority object, evidence gates, confirmation semantics and recovery criteria change with the action class.</p></div>
    <div class="container proof-grid">{proofCases.map(([id,type,href,finding,decision]) => <a href={href} class="proof-card panel"><div><span>{id}</span><strong>{type}</strong></div><h3>{finding}</h3><p>Worked owner decision: <b>{decision}</b></p><i>Open pack ↗</i></a>)}</div>
    <div class="container proof-action"><a href="/proof" class="button button-primary">Compare all three packs →</a></div>
  </section>

  <section class="section section-rule"><div class="container example-grid"><div><div class="eyebrow">One chain in detail</div><h2 class="section-title">CRM write, expressed as a decision chain.</h2><p class="lede">SAMPLE-001 remains the deepest public walkthrough and shows how BitEvo separates permission, evidence, effect and recovery without implying a real customer finding.</p><a class="text-link" href="/sample-audit">Follow complete SAMPLE-001 →</a></div><div class="sample panel">{sample.map(([label,value]) => <div><span>{label}</span><p>{value}</p></div>)}</div></div></section>

  <section class="section section-rule sample-pack-section"><div class="container pack-callout panel"><div><div class="eyebrow">Evidence provenance</div><h2>The samples keep uncertainty visible.</h2><p>Every proof pack distinguishes synthetic facts, assumptions, expected gates and NOT TESTED states. A worked example never becomes customer evidence by presentation.</p></div><div class="pack-meta"><div><span>SAMPLES</span><strong>3 synthetic packs</strong></div><div><span>MACHINE READABLE</span><strong>JSON for each pack</strong></div><div><span>CUSTOMER CLAIM</span><strong>FALSE</strong></div><a href="/proof" class="button button-primary">Inspect proof system <span aria-hidden="true">↗</span></a></div></div></section>

  <section class="section section-rule"><div class="container anti-theatre panel"><div><div class="eyebrow">Evidence discipline</div><h2>A polished report is not the product.</h2></div><div><p>The useful unit is a chain another owner or engineer can challenge: <strong>what action was possible, what evidence justified it, what actually happened, how uncertainty was handled, and what decision follows.</strong></p><p>If the evidence cannot support the decision, the artifact should preserve that uncertainty instead of hiding it behind a severity label.</p></div></div></section>

  <section class="section section-rule"><div class="narrow final"><div class="eyebrow">Scope one workflow</div><h2 class="section-title">Seed the artifacts before testing starts.</h2><p class="lede">Map the consequential action, preserve before/after checkpoints when controls change, then add owner and Rules-of-Engagement context before testing.</p><div class="actions"><a href="/mapper" class="button button-primary">Map the workflow <span aria-hidden="true">↗</span></a><a href="/workspace" class="button">Compare checkpoints</a><a href="/audit-intake" class="button button-ghost">Prepare scope brief</a></div></div></section>
</Layout>

<style>
  .artifact-hero{padding-top:clamp(78px,10vw,132px)}.hero-grid,.proof-head{display:grid;grid-template-columns:1.08fr .92fr;gap:clamp(42px,8vw,110px);align-items:end}.hero-grid .lede,.proof-head .lede{margin:0 0 26px}.hero-actions{display:flex;gap:10px;flex-wrap:wrap}.artifact-stack{display:grid;gap:14px}.artifact{display:grid;grid-template-columns:58px .72fr 1.28fr;gap:28px;padding:30px;align-items:start}.artifact-code{color:var(--green);font:500 .66rem var(--mono)}.artifact-title h2{margin:5px 0 10px;font-size:clamp(1.55rem,3vw,2.45rem);letter-spacing:-.04em}.artifact-title p{margin:0;color:var(--muted);font-size:.86rem}.artifact-body{display:grid;grid-template-columns:1fr .92fr;gap:28px}.label,.decision span{color:var(--muted);font:500 .58rem var(--mono);letter-spacing:.1em;text-transform:uppercase}.artifact-body ul{display:grid;grid-template-columns:1fr 1fr;gap:7px 18px;margin:12px 0 0;padding:0;list-style:none}.artifact-body li{position:relative;padding-left:14px;color:var(--ink-soft);font-size:.78rem}.artifact-body li::before{content:'+';position:absolute;left:0;color:var(--green);font-family:var(--mono)}.decision{padding-left:22px;border-left:1px solid var(--line)}.decision p{margin:8px 0 0;color:var(--ink);font-weight:650;font-size:.84rem}.toolchain{padding:clamp(28px,5vw,54px)}.toolchain>.lede{margin:15px 0 0}.toolchain-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:32px}.toolchain-grid a{display:flex;flex-direction:column;min-height:220px;padding:22px;border:1px solid var(--line);border-radius:14px;background:rgba(255,255,255,.018)}.toolchain-grid a:hover{border-color:rgba(127,208,177,.45)}.toolchain-grid span{color:var(--green);font:500 .58rem var(--mono);letter-spacing:.07em}.toolchain-grid strong{margin:24px 0 7px;font-size:1rem}.toolchain-grid p{margin:0;color:var(--muted);font-size:.78rem}.toolchain-grid i{margin-top:auto;padding-top:20px;color:var(--green);font-style:normal;font-size:.72rem;font-weight:700}.proof-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.proof-card{padding:24px;text-decoration:none;min-height:260px;display:flex;flex-direction:column}.proof-card>div{display:flex;justify-content:space-between;gap:14px}.proof-card span{color:var(--green);font:500 .61rem var(--mono)}.proof-card>div strong{color:var(--muted);font:500 .56rem var(--mono);text-transform:uppercase}.proof-card h3{margin:40px 0 10px;font-size:1.05rem;line-height:1.3}.proof-card p{margin:auto 0 18px;color:var(--muted);font-size:.78rem}.proof-card p b{color:var(--ink)}.proof-card i{font-style:normal;color:var(--green);font-size:.74rem;font-weight:700}.proof-action{margin-top:18px}.example-grid{display:grid;grid-template-columns:.72fr 1.28fr;gap:clamp(44px,8vw,110px)}.example-grid .text-link{display:inline-block;margin-top:18px;font-size:.82rem;font-weight:700}.sample{padding:8px 24px}.sample>div{display:grid;grid-template-columns:150px 1fr;gap:20px;padding:18px 0;border-bottom:1px solid var(--line)}.sample>div:last-child{border-bottom:0}.sample span{color:var(--green);font:500 .62rem var(--mono)}.sample p{margin:0;color:var(--muted);font-size:.82rem}.pack-callout{display:grid;grid-template-columns:1.05fr .95fr;gap:clamp(40px,7vw,90px);padding:clamp(28px,5vw,54px)}.pack-callout h2{margin:6px 0 12px;font-size:clamp(1.7rem,3vw,2.8rem);letter-spacing:-.04em}.pack-callout p{margin:0;color:var(--muted)}.pack-meta>div{display:flex;justify-content:space-between;gap:18px;padding:12px 0;border-bottom:1px solid var(--line)}.pack-meta span{color:var(--muted);font:500 .56rem var(--mono)}.pack-meta strong{font:500 .65rem var(--mono);text-align:right}.pack-meta .button{margin-top:20px}.anti-theatre{display:grid;grid-template-columns:.75fr 1.25fr;gap:clamp(40px,7vw,90px);padding:clamp(28px,5vw,54px)}.anti-theatre h2{margin:6px 0 0;font-size:clamp(1.7rem,3vw,2.8rem);letter-spacing:-.04em}.anti-theatre p{color:var(--muted)}.anti-theatre strong{color:var(--ink)}.final{text-align:center}.final .section-title{margin-inline:auto}.final .lede{margin:18px auto 28px}.actions{display:flex;gap:10px;justify-content:center;flex-wrap:wrap}
  @media(max-width:900px){.hero-grid,.proof-head,.example-grid,.anti-theatre,.pack-callout{grid-template-columns:1fr}.artifact{grid-template-columns:42px 1fr}.artifact-body{grid-column:2}.proof-grid,.toolchain-grid{grid-template-columns:1fr}.sample>div{grid-template-columns:120px 1fr}}
  @media(max-width:650px){.artifact{grid-template-columns:1fr;padding:24px}.artifact-code{display:none}.artifact-body{grid-column:auto;grid-template-columns:1fr}.artifact-body ul{grid-template-columns:1fr}.decision{padding-left:0;padding-top:18px;border-left:0;border-top:1px solid var(--line)}.sample>div{grid-template-columns:1fr;gap:6px}.pack-meta>div{flex-direction:column;gap:5px}.pack-meta strong{text-align:left}}
</style>
