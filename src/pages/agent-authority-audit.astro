  .anatomy-grid{display:grid;grid-template-columns:1fr 1fr;border:1px solid var(--line);border-radius:var(--radius);overflow:hidden}.anatomy-grid article{display:grid;grid-template-columns:38px 1fr;gap:16px;padding:24px;border-right:1px solid var(--line);border-bottom:1px solid var(--line);background:rgba(8,16,18,.42)}.anatomy-grid article:nth-child(2n){border-right:0}.anatomy-grid article:nth-last-child(-n+2){border-bottom:0}.anatomy-grid article>span{color:var(--green);font:500 .62rem var(--mono)}.anatomy-grid h3{margin:0 0 6px;font-size:.96rem}.anatomy-grid p{margin:0;color:var(--muted);font-size:.82rem}.severity-note{display:grid;grid-template-columns:.75fr 1.25fr;gap:42px;margin-top:18px;padding:28px}.severity-note h3{margin:0;font-size:1.2rem}.severity-note p{margin:0;color:var(--muted)}
  .delivery-grid{display:grid;grid-template-columns:.78fr 1.22fr;gap:clamp(44px,8vw,110px);align-items:start}.delivery-copy .lede{margin-top:18px}.deliverables{padding:8px 24px}.deliverables>div{display:grid;grid-template-columns:34px 1fr;gap:18px;padding:18px 0;border-bottom:1px solid var(--line)}.deliverables>div:last-child{border-bottom:0}.deliverables>div>span{color:var(--green);font:500 .64rem var(--mono)}.deliverables section{margin:0}.deliverables strong{font-size:.9rem}.deliverables p{margin:5px 0 0;color:var(--muted);font-size:.81rem}
  .lab-grid{display:grid;grid-template-columns:.72fr 1.28fr;gap:clamp(38px,7vw,90px);padding:clamp(28px,5vw,56px)}.dogfood-proof{border-color:rgba(127,208,177,.22);background:radial-gradient(circle at 0 0,rgba(127,208,177,.07),transparent 42%),linear-gradient(180deg,rgba(14,27,29,.86),rgba(8,16,18,.9))}.lab-id{font-size:clamp(2.8rem,5vw,5rem);font-weight:700;letter-spacing:-.06em;line-height:1;margin:10px 0 18px}.tags{display:flex;gap:7px;flex-wrap:wrap}.tags span{border:1px solid var(--line);border-radius:999px;padding:5px 8px;color:var(--muted);font:500 .58rem var(--mono)}.lab-copy h2{margin:0 0 16px;font-size:clamp(1.8rem,3.5vw,3rem);letter-spacing:-.04em}.lab-copy p{color:var(--muted);font-size:.94rem}.lab-copy strong{color:var(--ink)}.lab-copy .button{margin-top:10px}.lab-copy .small{font-size:.76rem;margin-top:24px}
  .roe-grid{display:grid;grid-template-columns:.8fr 1.2fr;gap:clamp(40px,8vw,110px)}.roe-list{border-top:1px solid var(--line)}.roe-list p{margin:0;padding:19px 0;border-bottom:1px solid var(--line);color:var(--muted)}.roe-list strong{color:var(--ink)}.roe-list .button{margin-top:24px}
  @media(max-width:900px){.hero-grid,.method-grid,.delivery-grid,.lab-grid,.roe-grid,.severity-note{grid-template-columns:1fr}.commercial-card{max-width:620px}.doctrine-grid{grid-template-columns:1fr}.doctrine-grid article{min-height:auto}.scenario-grid{grid-template-columns:1fr 1fr}.scenario-grid div:nth-child(2n){border-right:0}.scenario-grid div:nth-child(4n){border-right:0}.scenario-grid div:nth-last-child(-n+4){border-bottom:1px solid var(--line)}.scenario-grid div:nth-last-child(-n+2){border-bottom:0}}
  @media(max-width:700px){.section-heading{grid-template-columns:1fr;gap:24px}.fit-grid,.anatomy-grid{grid-template-columns:1fr}.anatomy-grid article{border-right:0;border-bottom:1px solid var(--line)!important}.anatomy-grid article:last-child{border-bottom:0!important}.scenario-grid{grid-template-columns:1fr}.scenario-grid div{border-right:0!important;border-bottom:1px solid var(--line)!important;min-height:120px}.scenario-grid div:last-child{border-bottom:0!important}.price{font-size:3.5rem}.lab-grid{padding:24px}.lab-copy .button{width:100%}}
</style>