---
import Layout from '../../layouts/Layout.astro';

const guides = [
	{"slug": "ai-agents-2026", "title": "Эволюция ИИ-агентов: глобальный ландшафт, токеномика и локальная безопасность в 2026 году", "date": "2026-07-07", "category": "AI", "kicker": "Ai Agents 2026", "desc": "С середины 2026 года глобальный ландшафт ИИ претерпел значительные изменения, перейдя от простых диалоговых систем к высокоавтономным агентам. Это стало возможным благодаря новым моделям, таким как Cl", "tags": ["ИИ-агенты", "токеномика", "безопасность ИИ", "Claude Fable", "Claude Mythos", "Open Weights", "Mem0", "MCP", "локальное развертывание", "2026"]},
	{"slug": "ai-agents-ecosystem-2026", "title": "Экосистема ИИ-агентов 2026: что взять и применить", "date": "2026-07-07", "category": "AI", "kicker": "Ai Agents Ecosystem 2026", "desc": "Период 2025–2026 годов знаменует собой фундаментальный переход от традиционных диалоговых моделей к суверенным автономным агентам. Эта эволюция сделала агентскую инфраструктуру вопросом национальной б", "tags": ["AI agents", "ecosystem", "2026", "paradigms", "infrastructure", "security", "frameworks", "trading", "ContinuityOS", "autonomous agents", "Computer Use"]},
	{"slug": "ai-companion-market-analysis", "title": "Анализ рынка AI-компаньонов: GTM-реалии и рыночная карта 2025–2026", "date": "2026-07-07", "category": "AI", "kicker": "Ai Companion Market Analysis", "desc": "Глобальный рынок AI-компаньонов находится на пороге экспоненциального роста, прогнозируясь с 28,19 млрд долларов в 2024 году до 140,75 млрд долларов к 2030 году при среднегодовом темпе роста 30,8%. Эт", "tags": ["AI", "Искусственный интеллект", "Маркетинг", "GTM", "Монетизация", "Приватность", "Telegram", "Рост рынка", "Голосовые интерфейсы", "AI-компаньоны"]},
	{"slug": "anthropic-models-and-upgrade", "title": "Аналитический отчёт по моделям уровня Fable Mythos и по апгрейду Sovereign Arena до Hybrid LLM plus RL", "date": "2026-07-07", "category": "AI", "kicker": "Anthropic Models And Upgrade", "desc": "Anthropic Claude Fable 5 и Mythos 5 представляют собой две конфигурации одной передовой модели, однако их доступность нестабильна, что делает Claude Opus 4.8 наиболее надёжным и мощным публичным вариа", "tags": ["Anthropic", "Claude", "Fable 5", "Mythos 5", "Opus 4.8", "Hybrid LLM + RL", "Sovereign Arena", "Trading System", "Agent Frameworks", "Geo-optimized"]},
	{"slug": "best-longterm-memory-systems-for-ai", "title": "Лучшие системы долговременной памяти для ИИ: Полное руководство по выбору и архитектуре", "date": "2026-07-07", "category": "AI", "kicker": "Best Longterm Memory Systems For Ai", "desc": "Выбор оптимальной системы долговременной памяти для ИИ зависит от конкретных потребностей приложения, а не от универсальных решений. Для корпоративных RAG-систем и поиска в production-средах часто под", "tags": ["долговременная память", "память ИИ", "RAG", "векторные базы данных", "MemGPT", "GraphRAG", "иерархическая память", "Pinecone", "Qdrant", "Weaviate", "Milvus", "Chroma", "FAISS", "LangChain", "LlamaIndex", "бенчмарки ИИ"]},
	{"slug": "blockchain-forensics-methodology", "title": "Блокчейн-форензика: методология ончейн-расследований", "date": "2026-07-07", "category": "Security", "kicker": "Blockchain Forensics Methodology", "desc": "Блокчейн-форензика — это систематический подход к расследованию и анализу транзакций и активности в децентрализованных сетях. Она позволяет реконструировать Sybil-фермы, отслеживать происхождение сред", "tags": ["blockchain", "forensics", "on-chain analysis", "sybil detection", "gas trail", "smart contracts", "investigations", "automation", "risk management", "web3"]},
	{"slug": "fable-mythos-agents-2026", "title": "Как поднять агентов до уровня Fable/Mythos: target-архитектура 2026", "date": "2026-07-07", "category": "AI", "kicker": "Fable Mythos Agents 2026", "desc": "Ключевое отличие Fable 5 и Mythos 5 от обычных агентов заключается не столько в базовых способностях модели, сколько в превосходной системной инженерии, обеспечивающей стабильный режим поведения при д", "tags": ["AI agents", "agent architecture", "LLM orchestration", "system engineering", "prompt engineering", "Fable", "Mythos", "memory management", "guardrails", "observability", "evaluation", "production AI"]},
	{"slug": "frontier-models-cost-routing", "title": "Ландшафт frontier-моделей и cost-routing (середина 2026)", "date": "2026-07-07", "category": "AI", "kicker": "Frontier Models Cost Routing", "desc": "К середине 2026 года ландшафт frontier-моделей претерпел значительные изменения: рынок сместился от оценки «умных чат-ботов» к инструментам, способным доводить полезную работу до конца. Вендоры теперь", "tags": ["AI models", "frontier models", "cost routing", "LLM", "agentic production", "mid-2026", "model landscape", "pricing"]},
	{"slug": "python-rt-architecture", "title": "Архитектура Python-контура для жесткого реального времени (hb <= 0.5 мс)", "date": "2026-07-07", "category": "Infrastructure", "kicker": "Python Rt Architecture", "desc": "Для достижения жесткого реального времени (hard real-time) в Python-контуре с задержкой цикла (hot path) менее 0.5 мс необходимо выделить критически важные операции в отдельный RT-процесс на изолирова", "tags": ["Python", "Real-time", "Linux", "Performance", "Low Latency", "IPC", "CPU Isolation", "GIL", "Shared Memory"]},
	{"slug": "vector-graph-hybrid-search", "title": "Сравнительный анализ векторного, графового и гибридного поиска для систем памяти", "date": "2026-07-07", "category": "AI", "kicker": "Vector Graph Hybrid Search", "desc": "Графовые методы памяти (GraphRAG, Graphiti, HippoRAG) оптимальны для задач с явными связями и \"многопрыжковыми\" запросами, поскольку они эффективно моделируют отношения и временные контексты. Векторны", "tags": ["векторный поиск", "графовый поиск", "гибридный поиск", "RAG", "LLM", "память", "эмбеддинги", "ANN", "SQLite", "ранжирование", "бенчмарки"]},
	{"slug": "capability-passports-sap", "title": "Capability Passports & SAP: Делегирование прав доступа ИИ-агентов и цифровые подписи", "date": "2026-06-25", "category": "Security", "kicker": "Capability Passports Sap", "desc": "Введение\nПредоставление автономным ИИ-агентам доступа к разрушительным инструментам (модификация кода, управление процессами, переводы средств) требует строгого разграничения прав доступа.", "tags": ["ai-safety", "state-authority-plane", "capability-passports", "cryptography", "security"]},
	{"slug": "reviewer-sandbox-split", "title": "ReviewerGate and SandboxPreflight Decoupled AI Security Architecture", "date": "2026-06-25", "category": "Security", "kicker": "Reviewer Sandbox Split", "desc": "Введение\nВ автономных системах на базе ИИ-агентов выполнение генерируемого кода несет критические риски безопасности (удаление файлов, утечка API-ключей, ботнет-активность).", "tags": ["ai-safety", "security", "sandbox", "reviewer-gate", "json-schema", "runtime-telemetry"]},
	{"slug": "security-sandboxing", "title": "Security Sandboxing: Изоляция выполнения и контроль лимитов инструментов ИИ", "date": "2026-06-25", "category": "Security", "kicker": "Security Sandboxing", "desc": "Введение\nПри интеграции ИИ-агентов с внешним окружением (базы данных, локальная ОС, внешние API) ключевым риском является неконтролируемое выполнение команд (untrusted tool execution).", "tags": ["ai-safety", "sandboxing", "tool-isolation", "security", "runtime-protection"]},
	{"slug": "tee-agent-secrets", "title": "TEE & MPC: Безопасное управление ключами автономных ИИ-агентов", "date": "2026-06-25", "category": "Security", "kicker": "Tee Agent Secrets", "desc": "Введение\nПредоставление автономному ИИ-агенту прямого доступа к API-ключам биржи или приватным ключам блокчейна несет критическую уязвимость.", "tags": ["ai-safety", "security", "tee", "mpc", "key-management"]},
	{
		slug: 'd3-tool-io-bridge-contract',
		title: 'D3: Tool-IO Bridge Спецификация и Контракт',
		date: '2026-06-08',
		category: 'Security',
		kicker: 'Security Sandbox',
		desc: 'Спецификация безопасного вызова внешних инструментов и выполнения скриптов в изолированной песочнице с валидацией схемы и контролем лимитов.',
		tags: ['security', 'sandbox', 'd3', 'bitevo']
	},
	{
		slug: 'state-authority-plane-evolution',
		title: 'State Authority Plane: Управление привилегиями агентов',
		date: '2026-06-08',
		category: 'Governance',
		kicker: 'Agent Governance',
		desc: 'Эволюция контуров управления правами и привилегиями агентов SAP (Loop A -> B -> C) с паспортами способностей и проверкой подписей.',
		tags: ['governance', 'sap', 'authority', 'continuity']
	},
	{
		slug: 'reflex-layer-ooda-monitoring',
		title: 'Reflex Layer: Автономный OODA-мониторинг',
		date: '2026-06-08',
		category: 'Automation',
		kicker: 'OODA Loop',
		desc: 'Реализация автономного OODA-мониторинга (Observe-Orient-Decide-Act) для отслеживания здоровья систем, перезапуска процессов и лог-ротации.',
		tags: ['automation', 'reflex', 'ooda', 'monitoring']
	},
	{
		slug: 'multi-agent-system-safety',
		title: 'Управляемая коэволюция и безопасность многоагентных систем (MAS)',
		date: '2026-06-08',
		category: 'Security',
		kicker: 'Multi-Agent Safety',
		desc: 'Принципы безопасной управляемой коэволюции нескольких ИИ-агентов с использованием Policy Gate и изоляцией исполнения в песочницах.',
		tags: ['multi-agent', 'safety', 'sandboxing', 'coevolution']
	},
	{
		slug: 'mirrorcore-seeding-identity-persistence',
		title: 'MirrorCore & Seeding: Техника переноса и устойчивости контекста ИИ',
		date: '2026-06-08',
		category: 'Security',
		kicker: 'AI Safety',
		desc: 'Как переносить и восстанавливать контекст и идентичность ИИ-агентов через сессии с использованием капсул сидов и IdentityLock.',
		tags: ['ai-safety', 'seeding', 'mirror-core', 'continuity']
	},
	{
		slug: 'omnicore-loop-self-preservation',
		title: 'Omni Core Loop & Self-Preservation: Детерминированные фоновые циклы автономии',
		date: '2026-06-08',
		category: 'Automation',
		kicker: 'OODA Loop',
		desc: 'Архитектура фонового планировщика OODA с автоматическими проверками дрейфа (DriftGuard), лог-ротацией и авто-чекпоинтами.',
		tags: ['automation', 'omni-core-loop', 'drift-guard', 'watchdog']
	},
	{
		slug: 'archiveos-multigpt-bridge-integration',
		title: 'ArchiveOS & MultiGPT-Bridge: Потоки памяти и арбитраж ИИ',
		date: '2026-06-08',
		category: 'Infrastructure',
		kicker: 'Memory & Bridge',
		desc: 'Как правильно Continuity OS и BitEvo должны взаимодействовать с ArchiveOS API/Data для управления контекстом, переноса идентичности через AnchorSet и построения федеративного ИИ-арбитража.',
		tags: ['archiveos', 'multigpt', 'arbitrage', 'memory']
	}

];
---

<Layout title="AI & Agent Security Guides Portal">
	<!-- Hero Section -->
	<section class="hero-section">
		<div class="container hero-inner">
			<div class="kicker">Security & Governance</div>
			<h1 class="display">AI Agent Playbooks</h1>
			<p class="copy">
				Технические спецификации, стандарты безопасности и протоколы управления для автономных многоагентных сред.
			</p>
		</div>
	</section>

	<!-- Guides List -->
	<section class="guides-section">
		<div class="container">
			<div class="guides-grid">
				{guides.map(guide => (
					<article class="guide-card">
						<div class="card-meta">
							<span class="category">{guide.category}</span>
							<span class="dot">·</span>
							<span class="date">{guide.date}</span>
						</div>
						<a href={`/guides/${guide.slug}`} class="title-link">
							<h2 class="display-sm">{guide.title}</h2>
						</a>
						<p class="desc">{guide.desc}</p>
						<div class="card-footer">
							<div class="tags">
								{guide.tags.map(tag => (
									<span class="tag">#{tag}</span>
								))}
							</div>
							<a href={`/guides/${guide.slug}`} class="read-more">Read Playbook →</a>
						</div>
					</article>
				))}
			</div>
		</div>
	</section>
</Layout>

<style>
	.hero-section {
		padding-block: 60px 30px;
		text-align: center;
	}
	.kicker {
		color: var(--blue);
		font-size: 0.72rem;
		font-weight: 900;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		margin-bottom: 6px;
	}
	.display {
		font-family: 'Playfair Display', serif;
		font-size: clamp(2.2rem, 5vw, 3.4rem);
		font-weight: 900;
		line-height: 1.15;
		margin: 0;
	}
	.copy {
		font-family: 'Lora', serif;
		color: var(--muted);
		max-width: 600px;
		margin: 12px auto 0;
		font-size: 1rem;
		line-height: 1.6;
	}

	/* Grid */
	.guides-section {
		padding-block: 20px 60px;
	}
	.guides-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 24px;
		max-width: 1000px;
		margin-inline: auto;
	}
	@media (max-width: 768px) {
		.guides-grid {
			grid-template-columns: 1fr;
		}
	}

	.guide-card {
		background: var(--paper-soft);
		border: 1px solid var(--line);
		border-radius: var(--radius);
		padding: 30px;
		display: flex;
		flex-direction: column;
		transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
	}
	.guide-card:hover {
		transform: translateY(-2px);
		border-color: var(--blue);
		box-shadow: 0 12px 28px rgba(0, 0, 0, 0.4);
	}

	.card-meta {
		display: flex;
		align-items: center;
		gap: 6px;
		font-size: 0.72rem;
		font-weight: 800;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: var(--muted);
		margin-bottom: 12px;
	}
	.category {
		color: var(--green);
	}

	.display-sm {
		font-family: 'Playfair Display', serif;
		font-size: 1.35rem;
		margin: 0 0 12px;
		line-height: 1.25;
		transition: color 0.2s ease;
	}
	.display-sm:hover {
		color: var(--blue);
	}

	.desc {
		font-family: 'Lora', serif;
		color: var(--muted);
		font-size: 0.92rem;
		line-height: 1.6;
		margin: 0 0 20px;
	}

	.card-footer {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-top: auto;
		border-top: 1px solid var(--line);
		padding-top: 14px;
	}

	.tags {
		display: flex;
		gap: 8px;
		font-size: 0.75rem;
		font-weight: 700;
		color: var(--muted);
	}

	.read-more {
		font-size: 0.75rem;
		font-weight: 800;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: var(--blue);
		transition: transform 0.2s ease;
	}
	.read-more:hover {
		transform: translateX(2px);
	}
</style>
