---
import Layout from '../../layouts/Layout.astro';

const collections = [
  {
    name: 'Agent authority & safety',
    text: 'Architecture notes around delegated authority, sandboxing, review gates and evidence boundaries.',
    items: [
      ['Agent Authority & Evidence Audit — methodology note', '/guides/ai-agent-reliability-audit'],
      ['Capability Passports & State Authority Plane', '/guides/capability-passports-sap'],
      ['ReviewerGate and SandboxPreflight split', '/guides/reviewer-sandbox-split'],
      ['Security sandboxing for tool execution', '/guides/security-sandboxing'],
      ['TEE & MPC for agent secrets', '/guides/tee-agent-secrets'],
      ['Multi-agent system safety', '/guides/multi-agent-system-safety'],
      ['State Authority Plane evolution', '/guides/state-authority-plane-evolution'],
      ['Tool-I/O bridge contract', '/guides/d3-tool-io-bridge-contract']
    ]
  },
  {
    name: 'Memory & retrieval',
    text: 'Research notes on durable context, retrieval architecture and the limits of remembered state.',
    items: [
      ['Long-term memory systems for AI', '/guides/best-longterm-memory-systems-for-ai'],
      ['Vector, graph and hybrid search', '/guides/vector-graph-hybrid-search'],
      ['MirrorCore compact memory compression', '/guides/mirrorcore-compactdigest-memory-compression'],
      ['MirrorCore seeding & identity persistence', '/guides/mirrorcore-seeding-identity-persistence'],
      ['ArchiveOS & MultiGPT bridge integration', '/guides/archiveos-multigpt-bridge-integration']
    ]
  },
  {
    name: 'Infrastructure & investigation',
    text: 'Method and architecture notes spanning observability, forensics and operational infrastructure.',
    items: [
      ['Blockchain forensics methodology', '/guides/blockchain-forensics-methodology'],
      ['PostgreSQL backup sync daemon', '/guides/postgres-backup-sync-daemon'],
      ['Python real-time architecture', '/guides/python-rt-architecture'],
      ['Fleet coordinator drift monitoring', '/guides/fleet-coordinator-drift-monitoring']
    ]
  },
  {
    name: 'Trading research archive',
    text: 'Historical strategy and risk notes. Research material only; not a current signal service or profit claim.',
    items: [
      ['How to validate edge with OOS & bootstrap', '/guides/how-to-validate-edge-oos-bootstrap'],
      ['Trading discipline journal: MAE / MFE', '/guides/trading-discipline-journal-mae-mfe'],
      ['Survival math: ergodicity & Kelly', '/guides/survival-math-ergodicity-kelly'],
      ['Trend-following R-multiple math', '/guides/trend-following-r-multiple-math'],
      ['Candle confirmation & data alignment', '/guides/candle-confirmation-data-alignment']
    ]
  }
];
---

<Layout title="BitEvo Research Library — Agent Systems, Security & Methods" description="Curated BitEvo research notes on agent authority, safety, memory, infrastructure and historical trading methods.">
  <section class="research-hero section">
    <div class="container hero-grid">
      <div><div class="eyebrow">Research library</div><h1 class="display">Notes, methods and architecture — separated from commercial proof.</h1></div>
      <div><p class="lede">This library contains technical research and historical working notes. A research page may describe hypotheses, prototypes or time-sensitive observations; it should not be read as customer proof, certification or a current runtime claim.</p></div>
    </div>
  </section>

  <section class="section-tight section-rule">
    <div class="container research-boundary panel">
      <div><span>EVIDENCE CLASS</span><strong>Research / technical notes</strong></div>
      <p>Verify time-sensitive facts against current primary sources before relying on them. Trading material is informational research, not financial advice or a promise of returns.</p>
    </div>
  </section>

  <section class="section section-rule">
    <div class="container collection-stack">
      {collections.map((collection, i) => (
        <section class="collection">
          <div class="collection-head">
            <span>{String(i + 1).padStart(2, '0')}</span>
            <div><h2>{collection.name}</h2><p>{collection.text}</p></div>
          </div>
          <div class="collection-links">
            {collection.items.map(([title, href]) => (
              <a href={href}><span>{title}</span><i aria-hidden="true">↗</i></a>
            ))}
          </div>
        </section>
      ))}
    </div>
  </section>

  <section class="section section-rule">
    <div class="narrow closing">
      <div class="eyebrow">Commercial boundary</div>
      <h2 class="section-title">Research is not the audit deliverable.</h2>
      <p class="lede">The Agent Authority & Evidence Audit uses an agreed workflow, Rules of Engagement and reproducible evidence criteria. Public research notes are context, not a substitute for scoped testing.</p>
      <a class="button button-primary" href="/agent-authority-audit">See audit methodology <span aria-hidden="true">↗</span></a>
    </div>
  </section>
</Layout>

<style>
  .research-hero{padding-top:clamp(78px,10vw,132px)}.hero-grid{display:grid;grid-template-columns:1.08fr .92fr;gap:clamp(40px,8vw,110px);align-items:end}.hero-grid .lede{margin:0}.research-boundary{display:grid;grid-template-columns:.7fr 1.3fr;gap:30px;padding:22px 26px;align-items:center}.research-boundary div{display:flex;flex-direction:column;gap:5px}.research-boundary span{color:var(--green);font:500 .6rem var(--mono);letter-spacing:.1em}.research-boundary strong{font-size:.82rem}.research-boundary p{margin:0;color:var(--muted);font-size:.78rem}.collection-stack{border-top:1px solid var(--line)}.collection{display:grid;grid-template-columns:.75fr 1.25fr;gap:clamp(38px,7vw,90px);padding:38px 0;border-bottom:1px solid var(--line)}.collection-head{display:grid;grid-template-columns:34px 1fr;gap:14px}.collection-head>span{color:#596560;font:500 .64rem var(--mono)}.collection h2{margin:0 0 8px;font-size:1.2rem}.collection p{margin:0;color:var(--muted);font-size:.8rem}.collection-links{border-top:1px solid var(--line)}.collection-links a{display:flex;justify-content:space-between;gap:18px;padding:14px 2px;border-bottom:1px solid var(--line);color:var(--ink-soft);font-size:.8rem}.collection-links a:hover{color:var(--green)}.collection-links i{font-style:normal;color:#64716d}.closing{text-align:center}.closing .section-title{margin-inline:auto}.closing .lede{margin:18px auto 28px}@media(max-width:820px){.hero-grid,.research-boundary,.collection{grid-template-columns:1fr}.collection{gap:24px}}
</style>
