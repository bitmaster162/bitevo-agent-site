	const { title, date, category, eyebrow, desc, agent_summary, contracts, rpc_endpoints, constants, safety_guards, content_ru } = Astro.props;

// GEO Phase 4 (ported from crypto latest format): Quick Answer + Article/FAQ JSON-LD
const qaPoints = (agent_summary || desc || "")
	.split(/(?<=[.!?])\s+/)
	.map(x => x.trim())
	.filter(x => x.length > 25)
	.slice(0, 4);
const _faqM = (content_ru || "").match(/##\s*([^\n]+)\n+([\s\S]+?)(?:\n\n|<)/);
const faqQ = _faqM ? _faqM[1].trim() : title;
let faqA = (_faqM ? _faqM[2] : (desc || "")).replace(/<[^>]+>/g, " ").replace(/\s+/g, " ").trim().slice(0, 600);
if (faqA.split(/\s+/).filter(Boolean).length < 25 && desc) faqA = (desc || "").replace(/<[^>]+>/g, " ").replace(/\s+/g, " ").trim().slice(0, 600);
const _slugUrl = `https://bitevoagentsite.vercel.app/guides/${Astro.params.slug}`;
const ldArticle = JSON.stringify({
	"@context": "https://schema.org",
	"@graph": [
		{
			"@type": "Article",
			"@id": `${_slugUrl}#article`,
			"headline": title.slice(0, 110),
			"description": desc,
			"datePublished": date,
			"dateModified": date,
			"inLanguage": "ru",
			"author": { "@id": "https://bitevoagentsite.vercel.app/#org" },
			"publisher": { "@id": "https://bitevoagentsite.vercel.app/#org" },
			"mainEntityOfPage": _slugUrl
		},
		{
			"@type": "FAQPage",
			"@id": `${_slugUrl}#faq`,
			"mainEntity": [{
				"@type": "Question",
				"name": faqQ,
				"acceptedAnswer": { "@type": "Answer", "text": faqA }
			}]
		},
		{
			"@type": "Organization",
			"@id": "https://bitevoagentsite.vercel.app/#org",
			"name": "BitEvo",
			"url": "https://bitevoagentsite.vercel.app/",
			"sameAs": [
				"https://sovereign-arena-site.vercel.app/",
				"https://cryptoguidessite.vercel.app/",
				"https://github.com/bitmaster162/bitevo-agent-site"
			]
		}
	]
});
---

<Layout title={`${title} · BitEvo Playbooks`}>
	<article class="article-page">
		<div class="container article-container">
			<div class="article-header">
				<div class="kicker">{eyebrow}</div>
				<h1 class="display">{title}</h1>
				<div class="meta">
					<span>Published: {date}</span>
					<span>·</span>
					<span class="cat">{category}</span>
				</div>
			</div>

			<p class="lead-copy">{desc}</p>

			<!-- Quick Answer (GEO Phase 4) -->
			<div class="quick-answer" style="background:#0c1428;border:1px solid #00ffe133;border-radius:12px;padding:16px 20px;margin:18px 0">
				<h2 style="font-size:16px;margin:0 0 8px;color:#ffd166">⚡ Быстрый ответ</h2>
				<ul style="margin:0 0 0 18px;padding:0">
					{qaPoints.map(pt => (<li style="margin-bottom:6px;font-size:14.5px;line-height:1.55">{pt}</li>))}
				</ul>
			</div>
			<script type="application/ld+json" set:html={ldArticle} />

			<!-- MemIR Agent Summary Block -->
			<div class="memir-summary">
				<div class="summary-label">MemIR AI Agent Summary</div>
				<pre><code>{agent_summary}</code></pre>
			</div>

			<!-- Executable Parameters -->
			<div class="params-block">
				<h2>Executable Parameters</h2>
				<div class="params-grid">
					<div class="param-card">
						<h3>Contracts</h3>
						{contracts.length > 0 ? (
							contracts.map(c => (
								<div class="contract-row">
									<span class="c-name">{c.name}:</span>
									<span class="c-addr">{c.address}</span>
									<span class="c-chain">[{c.chain}]</span>
								</div>
							))
						) : (
							<div class="contract-row">No active contract requirements.</div>
						)}
					</div>
					<div class="param-card">
						<h3>RPC Endpoints</h3>
						{rpc_endpoints.length > 0 ? (
							rpc_endpoints.map(rpc => (
								<div class="rpc-row">{rpc}</div>
							))
						) : (
							<div class="rpc-row">No external RPC routes required.</div>
						)}
					</div>
					<div class="param-card">
						<h3>Constants</h3>
						{Object.keys(constants).length > 0 ? (
							Object.entries(constants).map(([key, val]) => (
								<div class="constant-row">
									<span class="c-name">{key}:</span>
									<span class="c-val">{typeof val === 'object' ? JSON.stringify(val) : val}</span>
								</div>
							))
						) : (
							<div class="constant-row">No active constants.</div>
						)}
					</div>
				</div>
