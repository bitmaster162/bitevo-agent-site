		margin-bottom: 24px;
		border-bottom: 1px solid var(--line);
		padding-bottom: 16px;
	}
	.kicker {
		color: var(--blue);
		font-size: 0.72rem;
		font-weight: 900;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		margin-bottom: 6px;
	}
	.display {
		font-family: 'Playfair Display', serif;
		font-size: clamp(2rem, 4vw, 2.8rem);
		font-weight: 900;
		line-height: 1.15;
		margin: 0;
	}
	.meta {
		color: var(--muted);
		font-size: 0.82rem;
		display: flex;
		gap: 8px;
		margin-top: 8px;
	}
	.cat {
		color: var(--green);
		font-weight: 700;
	}

	.lead-copy {
		font-family: 'Lora', serif;
		font-size: 1.1rem;
		color: var(--muted);
		line-height: 1.6;
		margin-bottom: 30px;
	}

	/* MemIR Block */
	.memir-summary {
		background: rgba(120, 175, 208, 0.05);
		border: 1px solid var(--blue);
		border-radius: var(--radius);
		padding: 18px;
		margin-bottom: 30px;
	}
	.summary-label {
		color: var(--blue);
		font-size: 0.68rem;
		font-weight: 900;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		margin-bottom: 8px;
	}
	.memir-summary pre {
		margin: 0;
		white-space: pre-wrap;
		font-size: 0.85rem;
		font-family: monospace;
		color: var(--ink);
	}

	/* Params */
	.params-block {
		margin-bottom: 30px;
	}
	.params-block h2, .safety-block h2, .article-content h2 {
		font-family: 'Playfair Display', serif;
		font-size: 1.35rem;
		color: var(--blue);
		margin: 0 0 16px;
	}
	.params-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
		gap: 16px;
	}
	.param-card {
		background: var(--paper-soft);
		border: 1px solid var(--line);
		border-radius: 6px;
		padding: 16px;
	}
	.param-card h3 {
		font-size: 0.85rem;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		margin: 0 0 10px;
		color: var(--green);
	}
	.contract-row, .rpc-row, .constant-row {
		font-size: 0.78rem;
		font-family: monospace;
		color: var(--muted);
		margin-bottom: 6px;
		word-break: break-all;
	}
	.c-name {
		color: var(--ink);
		font-weight: 700;
	}
	.c-addr, .c-val {
		color: var(--blue);
	}
	.c-chain {
		color: var(--green);
	}

	/* Safety Guards Table */
	.safety-block {
		margin-bottom: 30px;
	}
	table {
		width: 100%;
		border-collapse: collapse;
		font-size: 0.8rem;
	}
	th, td {
		border: 1px solid var(--line);
		padding: 10px;
		text-align: left;
	}
	th {
		background: var(--paper-soft);
		font-weight: 800;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: var(--green);
	}
	td code {
		color: var(--blue);
		font-family: monospace;
	}

	/* Content RU */
	.content-text {
		font-family: 'Lora', serif;
		font-size: 1rem;
		line-height: 1.65;
		color: var(--ink);
	}
	.content-text code {
		background: var(--paper-soft);
		padding: 2px 6px;
		border-radius: 4px;
		font-family: monospace;
		font-size: 0.88rem;
		color: var(--blue);
	}
</style>
