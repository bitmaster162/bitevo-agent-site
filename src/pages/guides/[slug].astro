			props: {
			  "id": "mem-core-arc-008",
			  "title": "ArchiveOS & MultiGPT-Bridge: Потоки памяти и арбитраж ИИ",
			  "date": "2026-06-08",
			  "category": "Infrastructure",
			  "eyebrow": "Memory & Bridge",
