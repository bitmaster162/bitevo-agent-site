			  "safety_guards": [
			    {
			      "rule": "red_button_stops",
			      "max_limit": 3,
			      "action_on_breach": "halt_trading_24h"
			    },
			    {
			      "rule": "leverage_limit",
			      "max_limit": 3,
			      "action_on_breach": "reduce_position"
