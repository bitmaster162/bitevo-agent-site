	const { title, date, category, eyebrow, desc, agent_summary, contracts, rpc_endpoints, constants, safety_guards, content_ru } = Astro.props;
---

<Layout title={`${title} · BitEvo Playbooks`}>
	<article class="article-page">
		<div class="container article-container">
			<div class="article-header">
				<div class="kicker">{eyebrow}</div>
				<h1 class="display">{title}</h1>
				<div class="meta">
					<span>Published: {date}</span>
					<span>·</span>
					<span class="cat">{category}</span>
				</div>
			</div>

			<p class="lead-copy">{desc}</p>

			<!-- MemIR Agent Summary Block -->
			<div class="memir-summary">
				<div class="summary-label">MemIR AI Agent Summary</div>
				<pre><code>{agent_summary}</code></pre>
			</div>

			<!-- Executable Parameters -->
			<div class="params-block">
				<h2>Executable Parameters</h2>
				<div class="params-grid">
					<div class="param-card">
						<h3>Contracts</h3>
						{contracts.length > 0 ? (
							contracts.map(c => (
								<div class="contract-row">
									<span class="c-name">{c.name}:</span>
									<span class="c-addr">{c.address}</span>
									<span class="c-chain">[{c.chain}]</span>
								</div>
							))
						) : (
							<div class="contract-row">No active contract requirements.</div>
						)}
					</div>
					<div class="param-card">
						<h3>RPC Endpoints</h3>
						{rpc_endpoints.length > 0 ? (
							rpc_endpoints.map(rpc => (
								<div class="rpc-row">{rpc}</div>
							))
						) : (
							<div class="rpc-row">No external RPC routes required.</div>
						)}
					</div>
					<div class="param-card">
						<h3>Constants</h3>
						{Object.keys(constants).length > 0 ? (
							Object.entries(constants).map(([key, val]) => (
								<div class="constant-row">
									<span class="c-name">{key}:</span>
									<span class="c-val">{typeof val === 'object' ? JSON.stringify(val) : val}</span>
								</div>
							))
						) : (
							<div class="constant-row">No active constants.</div>
						)}
					</div>
				</div>
			</div>

			<!-- Safety Guards -->
			<div class="safety-block">
				<h2>Safety Guards</h2>
				<table>
					<thead>
						<tr>
							<th>Rule</th>
							<th>Max Limit</th>
							<th>Action On Breach</th>
						</tr>
					</thead>
					<tbody>
						{safety_guards.map(sg => (
							<tr>
								<td><code>{sg.rule}</code></td>
								<td>{sg.max_limit}</td>
								<td><code>{sg.action_on_breach}</code></td>
							</tr>
						))}
					</tbody>
				</table>
			</div>

			<!-- Content RU -->
			<div class="article-content">
				<h2>Спецификация и руководство</h2>
				<div class="content-text" set:html={content_ru.replace(/\n/g, '<br>')} />
			</div>
		</div>
	</article>
</Layout>

<style>
	.article-page {
		padding-block: 40px 60px;
	}
	.article-container {
		max-width: 800px;
		margin-inline: auto;
	}

	.article-header {
		margin-bottom: 24px;
		border-bottom: 1px solid var(--line);
		padding-bottom: 16px;
	}
	.kicker {
		color: var(--blue);
		font-size: 0.72rem;
		font-weight: 900;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		margin-bottom: 6px;
	}
	.display {
		font-family: 'Playfair Display', serif;
		font-size: clamp(2rem, 4vw, 2.8rem);
		font-weight: 900;
		line-height: 1.15;
		margin: 0;
	}
	.meta {
		color: var(--muted);
		font-size: 0.82rem;
		display: flex;
		gap: 8px;
		margin-top: 8px;
	}
	.cat {
		color: var(--green);
		font-weight: 700;
	}

	.lead-copy {
		font-family: 'Lora', serif;
		font-size: 1.1rem;
		color: var(--muted);
		line-height: 1.6;
		margin-bottom: 30px;
	}

	/* MemIR Block */
	.memir-summary {
		background: rgba(120, 175, 208, 0.05);
		border: 1px solid var(--blue);
		border-radius: var(--radius);
		padding: 18px;
		margin-bottom: 30px;
	}
	.summary-label {
		color: var(--blue);
		font-size: 0.68rem;
		font-weight: 900;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		margin-bottom: 8px;
	}
	.memir-summary pre {
		margin: 0;
		white-space: pre-wrap;
		font-size: 0.85rem;
