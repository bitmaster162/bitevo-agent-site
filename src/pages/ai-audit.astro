---
import Layout from '../layouts/Layout.astro';
---

<Layout title="AI Audit — BitEvo System Assurance" description="BitEvo now separates buyer evidence readiness from bounded security-control validation across consequential AI and software workflows." robots="noindex, follow">
  <section class="alias section">
    <div class="narrow alias-card panel">
      <div class="eyebrow">System assurance</div>
      <h1 class="page-title">BitEvo now validates consequential systems — not only agents.</h1>
      <p class="lede">The umbrella offer is maintained at <strong>/assurance</strong>: AI Evidence Readiness for buyer/procurement evidence, plus Security Control Validation for one bounded behavioral control in staging. The deeper Agent Authority &amp; Evidence Audit remains a separate specialized method.</p>
      <div class="actions"><a href="/assurance" class="button button-primary">Open System Assurance <span aria-hidden="true">↗</span></a><a href="/agent-authority-audit" class="button">Agent Primary Audit</a></div>
    </div>
  </section>
</Layout>

<style>
  .alias{min-height:62vh;display:grid;place-items:center}.alias-card{text-align:center;padding:clamp(34px,7vw,72px)}.alias-card .page-title{margin-inline:auto}.alias-card .lede{margin:22px auto 28px}.actions{display:flex;gap:10px;justify-content:center;flex-wrap:wrap}
</style>