---
import Layout from '../layouts/Layout.astro';
---

<Layout title="AI Audit — Canonical BitEvo Audit Route" description="The current BitEvo audit offer is maintained at /agent-authority-audit." robots="noindex, follow">
  <section class="alias section">
    <div class="narrow alias-card panel">
      <div class="eyebrow">Legacy route</div>
      <h1 class="page-title">The audit moved to one canonical page.</h1>
      <p class="lede">Scope, pricing, evidence boundaries and Rules of Engagement are maintained on the Agent Authority & Evidence Audit route so old offer language cannot drift independently.</p>
      <div class="actions"><a href="/agent-authority-audit" class="button button-primary">Open current audit <span aria-hidden="true">↗</span></a><a href="/audit-intake" class="button">Audit intake</a></div>
    </div>
  </section>
</Layout>

<style>
  .alias{min-height:62vh;display:grid;place-items:center}.alias-card{text-align:center;padding:clamp(34px,7vw,72px)}.alias-card .page-title{margin-inline:auto}.alias-card .lede{margin:22px auto 28px}.actions{display:flex;gap:10px;justify-content:center;flex-wrap:wrap}
</style>
