font:500 .63rem/1.3 var(--mono);letter-spacing:.06em;text-transform:uppercase}input,textarea,select{width:100%;border:1px solid var(--line-strong);border-radius:11px;background:rgba(255,255,255,.025);color:var(--ink);padding:11px 12px;font:500 .82rem/1.55 var(--sans);letter-spacing:0;text-transform:none;outline:none}textarea{resize:vertical}input:focus,textarea:focus,select:focus{border-color:rgba(127,208,177,.55);box-shadow:0 0 0 3px rgba(127,208,177,.06)}.comparison-warning,.decision-conflict{margin-top:20px;padding:13px 14px;border:1px solid rgba(239,186,92,.28);border-radius:11px;color:#d9c999;background:rgba(239,186,92,.04);font-size:.76rem}.decision-conflict{border-color:rgba(228,139,139,.35);color:#e7b2b2;background:rgba(228,139,139,.05)}.summary-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin:22px 0}.summary-grid article{padding:17px;border:1px solid var(--line);border-radius:12px}.summary-grid span{color:var(--muted);font:500 .55rem var(--mono);letter-spacing:.08em}.summary-grid strong{display:block;margin:7px 0 4px;font-size:1rem}.summary-grid p{margin:0;color:var(--muted);font-size:.68rem}.detail-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}.detail-grid section{padding:18px;border:1px solid var(--line);border-radius:12px}.detail-grid h3{margin:0 0 12px;font-size:.9rem}.detail-grid pre,.memo-output{min-height:220px;max-height:420px;overflow:auto;margin:0;padding:14px;border:1px solid var(--line);border-radius:10px;background:rgba(0,0,0,.18);white-space:pre-wrap;color:var(--ink-soft);font:500 .62rem/1.65 var(--mono)}.transition-list{display:grid}.transition-list>div{display:flex;justify-content:space-between;gap:14px;padding:9px 0;border-bottom:1px solid var(--line);font-size:.72rem}.transition-list span{font-family:var(--mono);color:var(--muted)}.transition-list span[data-state="resolved"]{color:var(--green)}.transition-list span[data-state="regressed"]{color:var(--red)}.transition-list span[data-state="changed"]{color:var