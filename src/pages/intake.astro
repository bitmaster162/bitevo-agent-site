---
import Layout from '../layouts/Layout.astro';
---

<Layout title="BitEvo Intake — Use the Agent Audit Scope Form" description="The current BitEvo intake is the bounded Agent Authority & Evidence Audit Rules-of-Engagement form." robots="noindex, follow">
  <section class="alias section">
    <div class="narrow alias-card panel">
      <div class="eyebrow">Intake route updated</div>
      <h1 class="page-title">Use the bounded audit intake.</h1>
      <p class="lede">The old general questionnaire has been retired. The current intake isolates one workflow, defines execution boundaries and explicitly excludes credentials and customer secrets.</p>
      <div class="actions">
        <a href="/audit-intake" class="button button-primary">Open audit intake <span aria-hidden="true">↗</span></a>
        <a href="/agent-authority-audit" class="button">See audit scope</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .alias{min-height:62vh;display:grid;place-items:center}.alias-card{text-align:center;padding:clamp(34px,7vw,72px)}.alias-card .page-title{margin-inline:auto}.alias-card .lede{margin:22px auto 28px}.actions{display:flex;justify-content:center;gap:10px;flex-wrap:wrap}
</style>
