---
import RuLayout from '../../layouts/RuLayout.astro';
import ScopeHandoffShort from '../../components/ScopeHandoffShort.astro';
import parity from '../../data/ru-semantic-parity.json';

const page = parity.pages.find((item) => item.slug === 'entry-audit');
if (!page) throw new Error('RU parity page missing: entry-audit');
const ruPath = `/ru/${page.slug}`;
const categoryRu = {
  FLAGSHIP:'ГЛАВНЫЙ',
  ENTRY:'ВХОД',
  SPECIALIST:'СПЕЦИАЛИЗАЦИЯ',
  TOOL:'ИНСТРУМЕНТ',
  PROOF:'ДОКАЗАТЕЛЬСТВА',
  RESEARCH:'ИССЛЕДОВАНИЯ',
  CONTEXT:'КОНТЕКСТ'
}[page.category] ?? page.category;
---

<RuLayout
  title={page.metaTitle ?? `${page.title} | BitEvo`}
  description={page.description}
  enPath={page.enPath}
  ruPath={ruPath}
>
  <section class="parity-hero section">
    <div class="container parity-grid">
      <div>
        <div class="eyebrow">{page.eyebrow}</div>
        <h1 id={page.slug === 'failure-recovery' ? 'ruFailureRecoveryTitle' : page.slug === 'reservation-action-validation' ? 'ruReservationActionValidationTitle' : undefined} class:list={['display', page.slug === 'evidence-readiness' && 'ru-evidence-readiness-title', (page.slug === 'build/exception-workflow-diagnostic' || page.slug === 'build/hr-workflow-diagnostic') && 'ru-build-diagnostic-title']}>{page.title}</h1>
      </div>
      <div>
        <p class="lede">{page.description}</p>
        <div class="parity-meta panel" role="group" aria-label="Статус смыслового соответствия RU">
          <span>{categoryRu}</span>
          <strong>Смысловое соответствие RU</strong>
          <small>Назначение и граница заявлений связаны с парным EN-маршрутом.</small>
        </div>
      </div>
    </div>
  </section>

  <section class="section-tight section-rule">
    <div id={page.slug === 'reservation-action-validation' ? 'ruReservationActionValidationPoints' : undefined} class="container parity-points">
      {page.points.map((point, index) => (
        <article class="panel">
          <span>{String(index + 1).padStart(2, '0')}</span>
          <p>{point}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section section-rule">
    <div class="container parity-boundary panel">
      <div>
        <div class="eyebrow">Граница смысла</div>
        <h2 class="section-title">Русская версия сохраняет смысл. Не расширяет полномочия или обещания.</h2>
      </div>
      <div>
        <p>Эта RU-поверхность локализует назначение, границу решения и границу заявлений парного EN-маршрута. Она не создаёт новое предложение, цену, заявление о сертификации, разрешение на production или разрешение на тестирование.</p>
        <p>Если операционное решение зависит от свежего состояния продукта, провайдера или внешней системы, требуется отдельная проверка актуального состояния.</p>
      </div>
    </div>
  </section>

  <ScopeHandoffShort locale="ru" offer="entry_audit" />

  <section class="section section-rule">
    <div class="narrow parity-actions">
      <div class="eyebrow">Следующее решение</div>
      <h2 class="section-title">Продолжайте по текущему пути решения BitEvo.</h2>
      <div class="actions">
        <a class="button button-primary" href={page.primaryHref}>{page.primaryLabel} <span aria-hidden="true">↗</span></a>
        <a class="button button-ghost" href={page.enPath} lang="en">Парный EN-маршрут</a>
      </div>
    </div>
  </section>
</RuLayout>

<style>
  .parity-hero{padding-top:clamp(70px,9vw,120px)}
  .parity-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(360px,.78fr);gap:clamp(38px,7vw,96px);align-items:end}
  .parity-grid .lede{margin:0 0 24px}
  .parity-meta{padding:18px;display:grid;grid-template-columns:auto 1fr;gap:6px 18px;align-items:center}
  .parity-meta span{color:var(--green);font:600 .6rem/1.2 var(--mono);letter-spacing:.08em}
  .parity-meta strong{font-size:.82rem}
  .parity-meta small{grid-column:1/-1;color:var(--muted)}
  .parity-points{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}
  .parity-points article{padding:26px;min-height:210px;display:flex;flex-direction:column;justify-content:space-between}
  .parity-points span{color:var(--green);font:600 .62rem var(--mono)}
  .parity-points p{margin:40px 0 0;color:var(--ink-soft)}
  .parity-boundary{padding:clamp(28px,5vw,50px);display:grid;grid-template-columns:minmax(0,.9fr) minmax(320px,1.1fr);gap:clamp(30px,6vw,78px)}
  .parity-boundary p{margin:0 0 16px;color:var(--muted)}
  .parity-boundary p:last-child{margin-bottom:0}
  .parity-actions{text-align:center}
  .parity-actions .section-title{margin-inline:auto}
  .actions{display:flex;justify-content:center;gap:10px;flex-wrap:wrap;margin-top:28px}
  @media(max-width:880px){.parity-grid,.parity-boundary{grid-template-columns:1fr}.parity-points{grid-template-columns:1fr}}
</style>
