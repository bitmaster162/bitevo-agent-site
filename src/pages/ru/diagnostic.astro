---
import RuLayout from '../../layouts/RuLayout.astro';
const questions = [
  { id:'action', gate:'Authority Budget', q:'Можете назвать точное внешнее действие, которое этому workflow разрешено выполнять?', why:'Если consequential action расплывчат, authority boundary нельзя проверить.' },
  { id:'object', gate:'Object binding', q:'Может ли workflow до исполнения доказать, к какому точному объекту относится действие?', why:'Правильное permission на неправильной записи, аккаунте или документе всё равно создаёт неправильный effect.' },
  { id:'owner', gate:'Authority owner', q:'Есть ли named role, которая владеет разрешением на это действие?', why:'Authority без owner сложно согласовать, ограничить или отозвать.' },
  { id:'evidence', gate:'Evidence Before Effect', q:'Явно ли определён минимальный pre-action evidence?', why:'Workflow не может fail closed на missing evidence, если requirement не формализован.' },
  { id:'freshness', gate:'Freshness', q:'Понимает ли workflow, когда required evidence стал stale или invalid?', why:'Healthy-looking surface может работать на truth, которая перестала обновляться.' },
  { id:'confirm', gate:'External confirmation', q:'Подтверждается ли intended external effect независимо после действия?', why:'Internal completion или tool ACK не доказывают, что внешний system state достиг expected value.' },
  { id:'recovery', gate:'Recovery', q:'При неопределённости evidence/confirmation workflow входит в определённое constrained/recovery state?', why:'Продолжение или retry через ambiguity может превратить один uncertain action в повторные effects.' }
];
---
<RuLayout title="7-gate Diagnostic — русский локальный инструмент | BitEvo" description="Локальный русский seven-gate diagnostic BitEvo для authority, evidence, external confirmation и recovery без trust score и testing authorization." enPath="/diagnostic" ruPath="/ru/diagnostic">
<section class="section hero"><div class="container split"><div><div class="eyebrow">Local workflow diagnostic</div><h1 class="display">Семь gates. Никакого фальшивого trust score.</h1></div><div><p class="lede">Ответьте YES / NO / UNKNOWN для одного реального workflow. Ничего не отправляется на сервер. Результат — список unresolved decision gates, не certification и не numerical safety rating.</p><a class="button" href="/ru/doctrine">Доктрина →</a></div></div></section>
<section class="section-tight section-rule"><div class="container diag-grid"><form id="ruDiagnostic" class="questions panel">{questions.map((item,i)=><fieldset data-id={item.id}><legend><span>{String(i+1).padStart(2,'0')}</span><div><small>{item.gate}</small><strong>{item.q}</strong></div></legend><div class="choices"><label><input type="radio" name={item.id} value="YES"/> YES</label><label><input type="radio" name={item.id} value="NO"/> NO</label><label><input type="radio" name={item.id} value="UNKNOWN"/> UNKNOWN</label></div></fieldset>)}<div class="form-actions"><button class="button button-primary" type="submit">Собрать decision-gap brief →</button><button class="button" type="reset">Reset</button></div></form><aside class="result panel"><div class="result-head"><div><div class="eyebrow">Local result</div><h2>Decision-gap brief</h2></div><span id="state">Incomplete</span></div><div id="empty" class="empty"><strong>Результата ещё нет.</strong><p>Заполните все семь gates. NO и UNKNOWN сохраняются как unresolved evidence, а не превращаются в PASS.</p></div><div id="output" hidden><div class="summary"><small>INTERPRETATION</small><h3 id="headline"></h3><p id="summary"></p></div><div id="gaps" class="gaps"></div><div class="boundary"><span>BOUNDARY</span><p>All-YES означает только, что description layer достаточно явен для подготовки scope. Это не safety pass и не testing authorization. Written Rules of Engagement обязательны до test execution.</p></div><div class="result-actions"><button id="copy" class="button" type="button">Copy brief</button><a class="button button-primary" href="/ru/audit-intake">Превратить gaps в scope ↗</a><a class="button" href="/mapper">Mapper (EN)</a></div></div></aside></div></section>
<section class="section section-rule"><div class="container explain"><div><div class="eyebrow">Interpretation</div><h2 class="section-title">UNKNOWN — допустимый инженерный ответ.</h2></div><div><article><span>YES</span><p>Gate явно описан и может поддержать scope preparation; testing всё равно требует отдельного written RoE.</p></article><article><span>NO</span><p>Gate отсутствует или текущая behavior не удовлетворяет ему.</p></article><article><span>UNKNOWN</span><p>Команда пока не может доказать gate. Неопределённость сохраняется до разрешения.</p></article></div></div></section>
</RuLayout>
<script define:vars={{questions}}>
const form=document.getElementById('ruDiagnostic');const output=document.getElementById('output');const empty=document.getElementById('empty');const gaps=document.getElementById('gaps');const headline=document.getElementById('headline');const summary=document.getElementById('summary');const state=document.getElementById('state');const copy=document.getElementById('copy');let latest='';
form?.addEventListener('submit',e=>{e.preventDefault();const results=questions.map(item=>({...item,answer:form.querySelector(`input[name="${item.id}"]:checked`)?.value||null}));if(results.some(r=>!r.answer)){state.textContent='Complete all gates';return;}const unresolved=results.filter(r=>r.answer!=='YES');headline.textContent=unresolved.length===0?'Все семь decision gates явно описаны.':`Unresolved gates: ${unresolved.length}/7.`;summary.textContent=unresolved.length===0?'Это SCOPE-ready description, не safety PASS. Следующий шаг — written scope + Rules of Engagement.':'NO и UNKNOWN становятся конкретными инженерными вопросами до расширения authority.';gaps.innerHTML='';if(!unresolved.length){gaps.innerHTML='<article><span>SCOPE</span><div><strong>Claims explicit</strong><p>Подготовьте written scope, RoE и agreed failure scenarios. Test execution остаётся отдельно authorized.</p></div></article>';}else unresolved.forEach(r=>{const el=document.createElement('article');el.innerHTML=`<span>${r.answer}</span><div><strong>${r.gate}</strong><p>${r.why}</p></div>`;gaps.appendChild(el);});latest=['=== BITEVO RU AUTHORITY & EVIDENCE DIAGNOSTIC ===',`Generated: ${new Date().toISOString()}`,'No trust score. No certification. Testing authorization: NOT GRANTED.','',...results.map(r=>`${r.answer} — ${r.gate}: ${r.q}`),'',`Unresolved: ${unresolved.length}/7`,...unresolved.map(r=>`- ${r.gate} [${r.answer}]: ${r.why}`)].join('\n');empty.hidden=true;output.hidden=false;state.textContent='Ready';});
form?.addEventListener('reset',()=>requestAnimationFrame(()=>{output.hidden=true;empty.hidden=false;state.textContent='Incomplete';latest='';}));copy?.addEventListener('click',async()=>{if(!latest)return;await navigator.clipboard.writeText(latest);const old=copy.textContent;copy.textContent='Copied';setTimeout(()=>copy.textContent=old,1000);});
</script>
<style>.hero{padding-top:clamp(68px,9vw,118px)}.split{display:grid;grid-template-columns:1fr 1fr;gap:clamp(38px,7vw,96px);align-items:end}.diag-grid{display:grid;grid-template-columns:1.05fr .95fr;gap:18px;align-items:start}.questions{padding:0 26px}.questions fieldset{border:0;margin:0;padding:22px 0;border-bottom:1px solid var(--line)}legend{width:100%;display:grid;grid-template-columns:34px 1fr;gap:10px}legend>span{color:var(--green);font:500 .6rem var(--mono)}legend div{display:flex;flex-direction:column;gap:4px}legend small{color:var(--muted);font:500 .56rem var(--mono);text-transform:uppercase}legend strong{font-size:.86rem}.choices{display:flex;gap:8px;flex-wrap:wrap;margin:14px 0 0 44px}.choices label{display:flex;gap:6px;align-items:center;padding:7px 10px;border:1px solid var(--line);border-radius:999px;color:var(--muted);font:500 .6rem var(--mono);cursor:pointer}.choices label:has(input:checked){color:var(--ink);border-color:rgba(127,208,177,.5)}.choices input{accent-color:var(--green)}.form-actions{display:flex;gap:8px;flex-wrap:wrap;padding:22px 0}.result{position:sticky;top:96px;padding:24px}.result-head{display:flex;justify-content:space-between}.result-head h2{margin:0}.result-head>span{color:var(--muted);font:500 .56rem var(--mono)}.empty{min-height:300px;display:flex;justify-content:center;flex-direction:column;border-top:1px solid var(--line);margin-top:18px}.empty p,.summary p,.boundary p,.gaps p{color:var(--muted)}.summary{margin-top:18px;padding-top:18px;border-top:1px solid var(--line)}.summary small,.boundary span{color:var(--gold);font:500 .56rem var(--mono)}.gaps{border-top:1px solid var(--line)}.gaps article{display:grid;grid-template-columns:65px 1fr;gap:12px;padding:14px 0;border-bottom:1px solid var(--line)}.gaps article>span{color:var(--green);font:500 .58rem var(--mono)}.gaps p{margin:3px 0 0;font-size:.75rem}.boundary{margin-top:16px}.result-actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:18px}.explain{display:grid;grid-template-columns:.75fr 1.25fr;gap:70px}.explain article{display:grid;grid-template-columns:85px 1fr;gap:18px;padding:18px 0;border-bottom:1px solid var(--line)}.explain article span{color:var(--green);font:500 .6rem var(--mono)}.explain article p{margin:0;color:var(--muted)}@media(max-width:900px){.split,.diag-grid,.explain{grid-template-columns:1fr}.result{position:static}}@media(max-width:620px){.questions{padding:0 17px}.choices{margin-left:0}.result-actions .button{width:100%}}</style>
