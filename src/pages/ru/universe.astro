---
import RuLayout from '../../layouts/RuLayout.astro';

const modules = [
  {
    lane: 'BUILD',
    name: 'BitEvo',
    status: 'LIVE',
    href: '/ru/build',
    internal: true,
    text: 'Создание, аудит и hardening AI-workflows с явными authority, evidence и recovery boundaries.'
  },
  {
    lane: 'LEARN',
    name: 'AI Skill Lab',
    status: 'RELEASE PREP',
    href: null,
    internal: false,
    text: 'Практическое обучение AI для личного, семейного и бизнес-использования через видимую работу, а не black-box обещания.'
  },
  {
    lane: 'VISION',
    name: 'VisionAssist',
    status: 'PRIVATE LAB',
    href: null,
    internal: false,
    text: 'Visual-intelligence tooling и operator workflows. Публичный безопасный demo-layer планируется; private runtime остаётся private.'
  },
  {
    lane: 'CRYPTO',
    name: 'Crypto Guides',
    status: 'LIVE · REVIEW',
    href: 'https://cryptoguidessite.vercel.app/',
    internal: false,
    text: 'Публичный crypto knowledge portal. Сайт live, но taxonomy, currentness и evidence boundaries продолжают проходить review.'
  },
  {
    lane: 'ARENA',
    name: 'Sovereign Arena',
    status: 'RECOVERY',
    href: 'https://sovereign-arena-site.vercel.app/',
    internal: false,
    text: 'Публичная research/proof surface. Recovery и source-binding ещё идут; runtime health отсюда не выводится.'
  },
  {
    lane: 'LABS',
    name: 'BitEvo Labs',
    status: 'PUBLIC RESEARCH',
    href: '/ru/guides',
    internal: true,
    text: 'Bounded experiments, research notes и public evidence, которые полезны до превращения в полноценные продукты.'
  }
];

const flow = [
  { step: '01', name: 'Учиться', text: 'Развивать навык и judgment через AI Skill Lab.' },
  { step: '02', name: 'Строить', text: 'Превращать этот навык в bounded workflows и продукты через BitEvo.' },
  { step: '03', name: 'Специализироваться', text: 'Использовать Vision, Crypto, Arena и Labs как отдельные domain surfaces.' }
];

const evidence = [
  ['SOURCE', 'Какой код или материал существует.'],
  ['BUILD', 'Что реально было из него собрано.'],
  ['DEPLOYMENT', 'Что принял provider.'],
  ['READBACK', 'Что возвращает публичная или protected surface.'],
  ['EFFECT', 'Что системе реально разрешено делать.']
];
---

<RuLayout
  title="BitEvo Universe — AI-продукты, обучение, research и evidence"
  description="Публичная экосистема BitEvo: BUILD, AI Skill Lab, VisionAssist, Crypto Guides, Sovereign Arena и bounded research без публикации private operator state."
  enPath="/universe"
  ruPath="/ru/universe"
>
  <section class="section universe-hero">
    <div class="container hero-grid">
      <div>
        <div class="eyebrow">BitEvo Universe</div>
        <h1 class="display">Одна экосистема. Шесть понятных входов.</h1>
      </div>
      <div>
        <p class="lede">Стройте AI-workflows, учитесь практическому AI, разбирайте visual evidence, исследуйте crypto, проверяйте идеи в Arena или заходите в bounded Labs. Выберите нужную lane; private operator state остаётся private.</p>
        <div class="hero-actions">
          <a class="button button-primary" href="#universe-modules">Выбрать направление <span aria-hidden="true">↘</span></a>
          <a class="button" href="/ru/build">Что реально построено <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </div>
  </section>

  <section class="section-tight section-rule">
    <div class="container map-shell panel" aria-label="Карта продуктов BitEvo Universe">
      <div class="map-core">
        <small>PUBLIC ECOSYSTEM</small>
        <strong>BitEvo Universe</strong>
        <p>Learn · Build · Vision · Crypto · Arena · Labs</p>
      </div>
      <div class="map-routes">
        {modules.map(module => (
          <div class="map-route">
            <span>{module.lane}</span>
            <strong>{module.name}</strong>
          </div>
        ))}
      </div>
      <p class="map-help">Каждый node — отдельная product lane, а не live-control channel. Public product открывается там, где он реально опубликован; private и recovery surfaces остаются явно bounded.</p>
    </div>
  </section>

  <section class="section section-rule" id="universe-modules">
    <div class="container section-head">
      <div>
        <div class="eyebrow">Шесть product lanes</div>
        <h2 class="section-title">Начните с того, что хотите сделать.</h2>
      </div>
      <p class="lede">Первый слой — ценность продукта. Status и provenance остаются видимыми, но не конкурируют с причиной существования каждой surface.</p>
    </div>

    <div class="container module-grid">
      {modules.map((module, i) => {
        const content = <>
          <div class="module-top">
            <span>{String(i + 1).padStart(2, '0')}</span>
            <span class="status">{module.status}</span>
          </div>
          <div>
            <small>{module.lane}</small>
            <h3>{module.name}</h3>
            <p>{module.text}</p>
          </div>
          <div class="module-foot">{module.href ? 'Открыть surface ↗' : 'Public route пока не опубликован'}</div>
        </>;
        return module.href
          ? <a class="module-card panel" href={module.href} target={module.internal ? undefined : '_blank'} rel={module.internal ? undefined : 'noopener'}>{content}</a>
          : <article class="module-card panel module-card-muted">{content}</article>;
      })}
    </div>
  </section>

  <section class="section section-rule">
    <div class="container section-head">
      <div>
        <div class="eyebrow">Как всё связано</div>
        <h2 class="section-title">Учиться. Строить. Затем специализироваться.</h2>
      </div>
      <p class="lede">Universe — путь через продукты, а не набор случайных сайтов. Обучение ведёт в implementation, а specialist surfaces продолжают работу в отдельных доменах.</p>
    </div>

    <div class="container flow-grid">
      {flow.map(item => (
        <article class="flow-card">
          <span>{item.step}</span>
          <h3>{item.name}</h3>
          <p>{item.text}</p>
        </article>
      ))}
    </div>

    <div class="container twin-panel panel">
      <div>
        <div class="eyebrow">Private context layer</div>
        <h3>Sovereign Twin</h3>
      </div>
      <div>
        <p>Private/local context для memory, continuity и decision support по всей экосистеме. Raw personal memory не является функцией публичного сайта, а этот слой не подразумевает autonomous execution authority.</p>
        <span class="private-badge">PRIVATE BY DEFAULT</span>
      </div>
    </div>
  </section>

  <section class="section section-rule evidence-section">
    <div class="container section-head">
      <div>
        <div class="eyebrow">Evidence boundary</div>
        <h2 class="section-title">Public status без cosplay под control room.</h2>
      </div>
      <p class="lede">URL, branch или успешный build не доказывают runtime health. Universe делает release chain понятным, но не публикует private infrastructure, credentials или operator controls.</p>
    </div>

    <div class="container evidence-grid">
      {evidence.map(([name, text]) => (
        <article>
          <strong>{name}</strong>
          <p>{text}</p>
        </article>
      ))}
    </div>

    <div class="container boundary-note">
      <strong>SOURCE ≠ BUILD ≠ DEPLOYMENT ≠ READBACK ≠ EXTERNAL EFFECT.</strong>
      <p>Trading-facing и research surfaces на этой странице не получают trading permission, performance validation или capital authorization.</p>
    </div>
  </section>
</RuLayout>

<style>
  .universe-hero{padding-top:clamp(68px,9vw,118px)}
  .hero-grid,.section-head{display:grid;grid-template-columns:1fr 1fr;gap:clamp(38px,7vw,96px);align-items:end}
  .hero-grid .lede,.section-head .lede{margin:0}
  .hero-actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:24px}

  .map-shell{padding:clamp(24px,4vw,42px);background:radial-gradient(circle at 18% 20%,rgba(127,208,177,.10),transparent 22rem),linear-gradient(180deg,rgba(13,25,27,.84),rgba(7,13,15,.88))}
  .map-core{max-width:720px;margin:0 auto 26px;text-align:center;padding:20px}
  .map-core small{display:block;color:var(--green);font:600 .57rem var(--mono);letter-spacing:.12em}
  .map-core strong{display:block;margin:8px 0 5px;font-size:clamp(1.45rem,3vw,2.35rem);letter-spacing:-.04em}
  .map-core p{margin:0;color:var(--muted)}
  .map-routes{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}
  .map-route{min-height:92px;padding:16px;border:1px solid var(--line);border-radius:14px;background:rgba(8,17,18,.7);display:flex;flex-direction:column;justify-content:space-between}
  .map-route span{color:var(--green);font:600 .54rem var(--mono);letter-spacing:.11em}
  .map-route strong{font-size:.86rem}
  .map-help{max-width:780px;margin:22px auto 0;text-align:center;color:var(--muted);font-size:.76rem}

  .section-head{margin-bottom:36px}
  .module-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}
  .module-card{min-height:310px;padding:24px;display:flex;flex-direction:column;justify-content:space-between;transition:transform .18s ease,border-color .18s ease,background .18s ease}
  .module-card[href]:hover{transform:translateY(-4px);border-color:rgba(127,208,177,.34);background:linear-gradient(180deg,rgba(15,30,31,.94),rgba(8,16,18,.92))}
  .module-card-muted{opacity:.88}
  .module-top{display:flex;justify-content:space-between;align-items:center;color:#66726f;font:500 .58rem var(--mono)}
  .status{padding:5px 8px;border:1px solid rgba(127,208,177,.16);border-radius:999px;color:#9cb7b0;font:600 .51rem var(--mono);letter-spacing:.06em}
  .module-card small{display:block;color:var(--green);font:600 .56rem var(--mono);letter-spacing:.11em;margin-bottom:8px}
  .module-card h3{margin:0 0 10px;font-size:1.16rem;letter-spacing:-.02em}
  .module-card p{margin:0;color:var(--muted);font-size:.8rem}
  .module-foot{margin-top:24px;color:var(--ink-soft);font-size:.74rem;font-weight:650}

  .flow-grid{display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
  .flow-card{padding:28px 24px;min-height:210px;border-right:1px solid var(--line)}
  .flow-card:last-child{border-right:0}
  .flow-card>span{color:var(--green);font:600 .56rem var(--mono);letter-spacing:.1em}
  .flow-card h3{margin:30px 0 10px;font-size:1.18rem}
  .flow-card p{margin:0;color:var(--muted)}
  .twin-panel{margin-top:18px;padding:26px;display:grid;grid-template-columns:.8fr 1.2fr;gap:30px;align-items:start}
  .twin-panel h3{margin:6px 0 0;font-size:1.28rem}
  .twin-panel p{margin:0 0 16px;color:var(--muted)}
  .private-badge{display:inline-block;padding:6px 9px;border:1px solid var(--line);border-radius:999px;color:#94a7a2;font:600 .53rem var(--mono);letter-spacing:.08em}

  .evidence-section{background:linear-gradient(180deg,transparent,rgba(127,208,177,.015),transparent)}
  .evidence-grid{display:grid;grid-template-columns:repeat(5,1fr);border:1px solid var(--line);border-radius:16px;overflow:hidden}
  .evidence-grid article{padding:20px;min-height:150px;border-right:1px solid var(--line)}
  .evidence-grid article:last-child{border-right:0}
  .evidence-grid strong{font:700 .62rem var(--mono);letter-spacing:.08em;color:var(--green)}
  .evidence-grid p{margin:16px 0 0;color:var(--muted);font-size:.74rem}
  .boundary-note{margin-top:20px;padding-top:20px;border-top:1px solid var(--line)}
  .boundary-note strong{font:650 .72rem var(--mono);letter-spacing:.04em}
  .boundary-note p{margin:9px 0 0;color:var(--muted)}

  @media(max-width:900px){
    .hero-grid,.section-head,.twin-panel{grid-template-columns:1fr;align-items:start}
    .map-routes,.module-grid{grid-template-columns:1fr 1fr}
    .evidence-grid{grid-template-columns:1fr 1fr}
    .evidence-grid article:nth-child(2n){border-right:0}
    .evidence-grid article{border-bottom:1px solid var(--line)}
    .evidence-grid article:last-child{border-bottom:0}
  }
  @media(max-width:620px){
    .hero-actions{display:grid;grid-template-columns:1fr}
    .hero-actions .button{width:100%;justify-content:center}
    .map-shell{padding:20px}
    .map-routes,.module-grid,.flow-grid,.evidence-grid{grid-template-columns:1fr}
    .map-route{min-height:76px}
    .module-card{min-height:250px}
    .flow-grid{border-bottom:0}
    .flow-card{min-height:0;border-right:0;border-bottom:1px solid var(--line);padding:24px 6px}
    .flow-card h3{margin-top:18px}
    .evidence-grid article{min-height:0;border-right:0}
  }
