---
import RuLayout from '../../layouts/RuLayout.astro';
import '../../styles/agent-incidents.css';
import incidents from '../../data/agent-incidents.json';
import sourceDates from '../../data/agent-incident-source-dates.json';
import localized from '../../data/agent-incidents.ru.json';
const gateRu = { 'Authority Budget':'Лимит полномочий','Evidence Before Effect':'Доказательства до эффекта','Object binding':'Привязка объекта','Freshness':'Актуальность','External confirmation':'Внешнее подтверждение','Recovery':'Восстановление','Authority owner':'Владелец полномочий' };
const labelsRu = {'Self-reported':'По заявлению участника','Disputed':'Оспаривается'};

const gateOptions = [
  'Authority Budget',
  'Evidence Before Effect',
  'Object binding',
  'Freshness',
  'External confirmation',
  'Recovery',
  'Authority owner'
];

const asiOptions = ['ASI01','ASI02','ASI03','ASI04','ASI05','ASI06','ASI07','ASI08','ASI09','ASI10'];

const organizationsById = {
  'INC-01': 'Replit · SaaStr',
  'INC-02': 'PocketOS · Cursor · Railway',
  'INC-03': 'Google Antigravity',
  'INC-04': 'OpenClaw',
  'INC-05': 'Meta',
  'INC-06': 'AWS · Kiro',
  'INC-07': 'Amazon Q Developer',
  'INC-08': 'Cline',
  'INC-09': 'Salesloft Drift · Salesforce',
  'INC-10': 'OpenAI Operator · Instacart',
  'INC-11': 'Air Canada',
  'INC-12': 'GitHub MCP'
};

const flagsById = {
  'INC-03': ['Self-reported'],
  'INC-04': ['Self-reported'],
  'INC-06': ['Disputed']
};

const sourceLabel = (url) => new URL(url).hostname.replace(/^www\./, '');
const sourceDate = (url) => sourceDates[url] ?? '';
const formatDate = (value) => new Intl.DateTimeFormat('ru-RU', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
  timeZone: 'UTC'
}).format(new Date(`${value}T00:00:00Z`));
---

<RuLayout
  title="Инциденты ИИ-агентов: полномочия и восстановление | BitEvo"
  description="12 случаев и демонстраций с публичными источниками: полномочия ИИ-агентов, последствия, доказательства и семь контрольных рубежей."
  enPath="/agent-incidents"
  ruPath="/ru/agent-incidents"
>
  <section class="section incident-hero">
    <div class="narrow">
      <div class="eyebrow">Библиотека публичных случаев · 12 случаев с источниками</div>
      <h1 class="display">Инциденты ИИ-агентов: последствия действий и доказательства</h1>
      <p class="lede">Случаи и исследовательские демонстрации с публичными источниками, где агент действовал без должного контроля или было показано, что это возможно. Для каждого указаны обстоятельства, затронутые рубежи BitEvo, риски OWASP Agentic и доказательства, необходимые для проверки.</p>
    </div>
  </section>

  <section class="section-tight section-rule">
    <div class="container filter-shell panel" data-incident-filters>
      <div class="filter-heading">
        <div>
          <div class="eyebrow">Фильтр по критериям проверки</div>
          <h2 class="section-title">Рубеж BitEvo и риск OWASP</h2>
        </div>
        <button type="button" class="filter-reset button" data-filter-reset aria-pressed="true">Все случаи</button>
      </div>

      <div class="filter-group" aria-label="Фильтр по рубежу BitEvo">
        <strong>Рубеж</strong>
        <div class="filter-options">
          {gateOptions.map((gate) => (
            <button type="button" data-gate-filter={gate} aria-pressed="false">{gateRu[gate] ?? gate}</button>
          ))}
        </div>
      </div>

      <div class="filter-group" aria-label="Фильтр по риску OWASP Agentic">
        <strong>OWASP ASI</strong>
        <div class="filter-options filter-options-asi">
          {asiOptions.map((asi) => (
            <button type="button" data-asi-filter={asi} aria-pressed="false">{asi}</button>
          ))}
        </div>
      </div>

      <p class="filter-status" data-filter-status aria-live="polite">Показаны все 12 случаев.</p>
    </div>
  </section>

  <div data-incident-library>
    {incidents.map((incident) => (
      <section class="section-tight section-rule" data-incident-section>
        <article
          class="container incident-card panel"
          data-incident-card
          data-incident-id={incident.id}
          data-gates={incident.gates.join('|')}
          data-asi={incident.owasp_asi.join('|')}
        >
          <div class="incident-main">
            <div class="incident-meta">
              <span class="incident-id">{incident.id}</span>
              <span>{incident.date}</span>
              <span>{organizationsById[incident.id]}</span>
            </div>
            <div class="incident-labels">
              <span>{incident.type === 'demonstration' ? 'Демонстрация' : 'Инцидент'}</span>
              {(flagsById[incident.id] ?? []).map((flag) => <span>{labelsRu[flag] ?? flag}</span>)}
            </div>
            <h2>{localized[incident.id]?.title ?? incident.title}</h2>
            <p class="incident-summary">{localized[incident.id]?.what_happened ?? incident.what_happened}</p>

            <div class="incident-tags">
              <div>
                <strong>Карта семи рубежей</strong>
                <div class="tags">{incident.gates.map((gate) => <span>{gateRu[gate] ?? gate}</span>)}</div>
              </div>
              <div>
                <strong>OWASP Agentic</strong>
                <div class="tags tags-asi">{incident.owasp_asi.map((asi) => <span>{asi}</span>)}</div>
              </div>
            </div>
          </div>

          <aside class="incident-evidence">
            <div>
              <span class="evidence-kicker">Какие доказательства проверить</span>
              <p>{localized[incident.id]?.evidence_we_check ?? incident.evidence_we_check}</p>
            </div>
            <div class="source-list">
              <span class="evidence-kicker">Источники</span>
              <ul>
                {incident.sources.map((source) => (
                  <li>
                    <a href={source} target="_blank" rel="noopener noreferrer">{sourceLabel(source)}</a>
                    <time datetime={sourceDate(source)}>{formatDate(sourceDate(source))}</time>
                  </li>
                ))}
              </ul>
            </div>
          </aside>
        </article>
      </section>
    ))}
  </div>

  <section class="section section-rule">
    <div class="container incident-footer panel">
      <div>
        <div class="eyebrow">Границы и исправления</div>
        <h2 class="section-title">Публичные источники, ограниченные утверждения.</h2>
      </div>
      <div>
        <p>Случаи изложены по связанным публичным источникам на 1 октября 2026 года. BitEvo не участвовала ни в одном из них. События и демонстрации не следует смешивать; спорные утверждения остаются спорными.</p>
        <p>Исправления: <a class="text-link" href="mailto:robert@bitevo.work">robert@bitevo.work</a>.</p>
      </div>
    </div>
  </section>
</RuLayout>

<script is:inline src="/agent-incidents.js" defer></script>
