---
import RuLayout from '../../layouts/RuLayout.astro';

const actionClasses = [
  ['crm', 'CRM / record write'],
  ['message', 'Outbound message'],
  ['deployment', 'Deployment / config change'],
  ['custom', 'Custom external effect']
];
const gates = [
  ['objectBinding', 'Object binding', 'Может ли workflow доказать exact target object / recipient / environment до исполнения?'],
  ['approvalEvidence', 'Approval evidence', 'Может ли он доказать, что exact action сейчас разрешён?'],
  ['freshness', 'Freshness / validity', 'Может ли он определить, когда evidence или approval стали stale?'],
  ['versionContext', 'Version context', 'Привязано ли решение к ожидаемой workflow / policy / config version?'],
  ['externalConfirmation', 'External confirmation', 'Может ли workflow независимо подтвердить intended effect на том же target?'],
  ['recovery', 'Recovery', 'Входит ли ambiguity в constrained/reconcile/rollback state вместо blind retry?']
];
---
<RuLayout title="Authority Mapper — русский локальный инструмент | BitEvo" description="Русский schema-compatible Authority Mapper v2: Authority Ledger, Evidence Contract, failure plan и owner decision prompt локально в браузере." enPath="/mapper" ruPath="/ru/mapper">
<section class="section hero"><div class="container split"><div><div class="eyebrow">Local mini-product · Authority Mapper v2 · RU</div><h1 class="display">Сначала смэппить authority. Потом позволять агенту её тратить.</h1></div><div><p class="lede">Опишите одно consequential action. Mapper создаст draft <strong>Authority Ledger + Evidence Contract + failure plan + owner decision prompt</strong>. Данные остаются в браузере.</p><div class="actions"><a class="button" href="/ru/proof">Proof Matrix</a><a class="button" href="/ru/workspace">Decision Workspace</a><a class="button" href="/ru/diagnostic">7-gate diagnostic</a></div></div></div></section>
<section class="section-tight section-rule">
<div class="container warning panel"><span>!</span><div><strong>No secrets. No authorization. No score.</strong><p>Не вводите credentials, tokens, private keys, wallet seeds, production secrets или customer data. Artifact — только local planning material.</p></div></div>
<div class="container mapper-grid"><form id="ruMapper" class="form panel">
<section><header><span>01</span><div><h2>External effect</h2><p>Начните с того, что workflow может изменить вне себя.</p></div></header><label>Action class<select id="actionClass" required>{actionClasses.map(([v,l])=><option value={v}>{l}</option>)}</select></label><label>Workflow name<input id="workflowName" required placeholder="Lead Qualification Agent"/></label><label>Exact critical action<textarea id="criticalAction" required rows="3"></textarea></label><label>Exact target binding<textarea id="targetBinding" required rows="3"></textarea></label><div class="two"><label>Authority owner<input id="authorityOwner" required/></label><label>Environment<input id="environment" required placeholder="staging / test / isolated lab"/></label></div><label>Allowed authority<textarea id="allowed" required rows="3"></textarea></label><label>Authority, которая должна оставаться невозможной<textarea id="prohibited" required rows="3"></textarea></label></section>
<section><header><span>02</span><div><h2>Evidence Before Effect</h2><p>Что должно оставаться valid в момент исполнения.</p></div></header><label>Required pre-action evidence<textarea id="preEvidence" required rows="3"></textarea></label><label>Freshness / validity rule<textarea id="freshnessRule" required rows="3"></textarea></label><label>Approval evidence<textarea id="approvalRule" required rows="3"></textarea></label><label>Version / configuration context<textarea id="versionRule" required rows="3"></textarea></label><label>External confirmation<textarea id="confirmationRule" required rows="3"></textarea></label><label>Ambiguity / recovery behavior<textarea id="recoveryRule" required rows="3"></textarea></label></section>
<section><header><span>03</span><div><h2>Decision gates</h2><p>YES означает только description-ready для scope/retest. Это не authorization.</p></div></header><div class="gate-list">{gates.map(([id,label,q],i)=><fieldset><legend><span>{String(i+1).padStart(2,'0')}</span><div><small>{label}</small><strong>{q}</strong></div></legend><div class="choices"><label><input type="radio" name={id} value="YES" required/> YES</label><label><input type="radio" name={id} value="NO"/> NO</label><label><input type="radio" name={id} value="UNKNOWN"/> UNKNOWN</label></div></fieldset>)}</div></section>
<section><header><span>04</span><div><h2>Consequence boundary</h2><p>Сделайте failure business-relevant.</p></div></header><label>Most expensive plausible error<textarea id="expensiveError" required rows="3"></textarea></label><label>Named recovery owner<input id="recoveryOwner" required/></label></section>
<div class="form-actions"><button class="button button-primary" type="submit">Build authority map →</button><button class="button" type="reset">Reset</button><label class="button import">Import JSON<input id="importJson" type="file" accept="application/json,.json"/></label></div></form>
<aside class="output panel"><div class="output-head"><div><div class="eyebrow">Local artifact</div><h2>Authority map</h2></div><span id="outputState">Not generated</span></div><div id="empty" class="empty"><strong>One action in. Decision structure out.</strong><p>Сгенерируйте карту, затем export, сравните checkpoints или передайте seed в RU Intake.</p></div><div id="result" hidden><div class="posture"><small>PLANNING POSTURE</small><h3 id="posture"></h3><p id="postureWhy"></p></div><div class="tabs"><button type="button" data-view="ledger" class="active">Authority Ledger</button><button type="button" data-view="contract">Evidence Contract</button><button type="button" data-view="failures">Failure Plan</button><button type="button" data-view="brief">Full Brief</button></div><pre id="artifactText"></pre><div class="output-actions"><button id="copy" type="button" class="button">Copy view</button><button id="downloadTxt" type="button" class="button">TXT</button><button id="downloadJson" type="button" class="button">JSON</button><button id="workspace" type="button" class="button">Save / compare ↗</button><button id="handoff" type="button" class="button button-primary">Continue to RU Intake ↗</button></div><div class="boundary"><span>LOCAL HANDOFFS</span><p>Handoff использует sessionStorage. Никакой workflow content не помещается в URL и не становится testing authorization.</p></div></div></aside></div></section>
</RuLayout>
<script define:vars={{gates}}>
const form=document.getElementById('ruMapper');const result=document.getElementById('result');const empty=document.getElementById('empty');const outputState=document.getElementById('outputState');const postureEl=document.getElementById('posture');const postureWhy=document.getElementById('postureWhy');const artifactText=document.getElementById('artifactText');const importJson=document.getElementById('importJson');const workspace=document.getElementById('workspace');const handoff=document.getElementById('handoff');const copy=document.getElementById('copy');const downloadTxt=document.getElementById('downloadTxt');const downloadJson=document.getElementById('downloadJson');const tabs=[...document.querySelectorAll('[data-view]')];let generated=null;let currentView='ledger';
const value=id=>document.getElementById(id)?.value?.trim()||'-';const setValue=(id,v='')=>{const el=document.getElementById(id);if(el)el.value=v||''};const setGate=(id,a='UNKNOWN')=>{const el=form.querySelector(`input[name="${id}"][value="${a}"]`);if(el)el.checked=true};
const scenarios={crm:[['F01','Object mismatch','Target resolves to a different record.'],['F02','Stale source evidence','Required source state violates freshness.'],['F03','False Green','Internal success exists without same-object read-back.'],['F04','Duplicate mutation','Ambiguous write is replayed before reconciliation.']],message:[['F01','Recipient drift','Resolved recipient differs from approved identity.'],['F02','Approval revision drift','Content differs from approved revision.'],['F03','Ambiguous provider ACK','ACK is not attributable to exact recipient/message.'],['F04','Expired send window','Approval expires before effect.']],deployment:[['F01','Environment mismatch','Target environment differs from approval.'],['F02','Baseline drift','Config baseline changed after approval.'],['F03','Partial effect','Reported success but intended state is partial.'],['F04','Rollback unavailable','Declared recovery path is unavailable.']],custom:[['F01','Target binding failure','Target differs from evidence-bound object.'],['F02','Evidence freshness failure','Required evidence is stale or invalid.'],['F03','Unconfirmed external effect','Internal success lacks independent confirmation.'],['F04','Unsafe replay','Retry occurs before reconciliation.']]};
function build(){const actionClass=value('actionClass');const gateResults=gates.map(([id,label,q])=>({id,label,question:q,answer:form.querySelector(`input[name="${id}"]:checked`)?.value||'UNKNOWN'}));const unresolved=gateResults.filter(g=>g.answer!=='YES');const posture=unresolved.length?'CONSTRAIN':'SCOPE';const reason=unresolved.length?`${unresolved.length} unresolved gate(s); authority expansion не обоснована.`:'Все description-layer gates explicit; можно готовить written scope/RoE, но testing не authorized.';const failureScenarios=(scenarios[actionClass]||scenarios.custom).map(([id,title,trigger])=>({id,title,trigger,expected_control:'Stop/constrain/reconcile before another external effect.'}));const a={workflow:value('workflowName'),critical_action:value('criticalAction'),target_binding:value('targetBinding'),authority_owner:value('authorityOwner'),environment:value('environment'),allowed_authority:value('allowed'),prohibited_authority:value('prohibited'),recovery_owner:value('recoveryOwner'),expensive_error:value('expensiveError')};const e={pre_action_evidence:value('preEvidence'),freshness_rule:value('freshnessRule'),approval_evidence:value('approvalRule'),version_context:value('versionRule'),external_confirmation:value('confirmationRule'),recovery_behavior:value('recoveryRule')};const ledger=['=== AUTHORITY LEDGER ===',`Workflow: ${a.workflow}`,`Action class: ${actionClass}`,`Critical action: ${a.critical_action}`,`Target binding: ${a.target_binding}`,`Authority owner: ${a.authority_owner}`,`Environment: ${a.environment}`,`Allowed authority: ${a.allowed_authority}`,`Prohibited authority: ${a.prohibited_authority}`,`Recovery owner: ${a.recovery_owner}`,`Most expensive plausible error: ${a.expensive_error}`].join('\n');const contract=['=== EVIDENCE CONTRACT ===',`Pre-action evidence: ${e.pre_action_evidence}`,`Freshness rule: ${e.freshness_rule}`,`Approval evidence: ${e.approval_evidence}`,`Version context: ${e.version_context}`,`External confirmation: ${e.external_confirmation}`,`Recovery behavior: ${e.recovery_behavior}`].join('\n');const failures=['=== FAILURE PLAN ===',...failureScenarios.flatMap(x=>[`${x.id} · ${x.title}`,`Trigger: ${x.trigger}`,`Expected control: ${x.expected_control}`,''])].join('\n');const brief=[ledger,'',contract,'',failures,'','=== DECISION GATES ===',...gateResults.map(g=>`${g.answer} · ${g.label}`),'',`PLANNING POSTURE: ${posture}`,`WHY: ${reason}`,'Testing authorization: NOT GRANTED.'].join('\n');return{schema:'bitevo.authority-map.v2',generated_at:new Date().toISOString(),boundary:{local_only:true,testing_authorization:false,certification:false,trust_score:false},action_class:actionClass,authority_ledger:a,evidence_contract:e,gates:gateResults,unresolved_gates:unresolved,failure_scenarios:failureScenarios,owner_decision:{posture,reason,allowed_decisions:['EXPAND','CONSTRAIN','REPAIR','RETEST']},views:{ledger,contract,failures,brief}}}
function render(){if(!generated)return;artifactText.textContent=generated.views[currentView];tabs.forEach(b=>b.classList.toggle('active',b.dataset.view===currentView))}form?.addEventListener('submit',e=>{e.preventDefault();if(!form.reportValidity())return;generated=build();postureEl.textContent=generated.owner_decision.posture;postureWhy.textContent=generated.owner_decision.reason;currentView='ledger';render();empty.hidden=true;result.hidden=false;outputState.textContent='Ready'});form?.addEventListener('reset',()=>requestAnimationFrame(()=>{generated=null;result.hidden=true;empty.hidden=false;outputState.textContent='Not generated';artifactText.textContent=''}));tabs.forEach(b=>b.addEventListener('click',()=>{currentView=b.dataset.view;render()}));
importJson?.addEventListener('change',async()=>{const f=importJson.files?.[0];if(!f)return;try{const map=JSON.parse(await f.text());if(!map?.authority_ledger||!map?.evidence_contract||!Array.isArray(map.gates))throw new Error();const a=map.authority_ledger,e=map.evidence_contract;setValue('actionClass',map.action_class||'custom');setValue('workflowName',a.workflow);setValue('criticalAction',a.critical_action);setValue('targetBinding',a.target_binding);setValue('authorityOwner',a.authority_owner);setValue('environment',a.environment);setValue('allowed',a.allowed_authority);setValue('prohibited',a.prohibited_authority);setValue('recoveryOwner',a.recovery_owner);setValue('expensiveError',a.expensive_error);setValue('preEvidence',e.pre_action_evidence);setValue('freshnessRule',e.freshness_rule);setValue('approvalRule',e.approval_evidence);setValue('versionRule',e.version_context);setValue('confirmationRule',e.external_confirmation);setValue('recoveryRule',e.recovery_behavior);gates.forEach(([id])=>setGate(id,map.gates.find(g=>g.id===id)?.answer||'UNKNOWN'));outputState.textContent='Imported · review then generate';}catch{outputState.textContent='Import rejected'}finally{importJson.value=''}});
const download=(name,body,type)=>{const blob=new Blob([body],{type});const url=URL.createObjectURL(blob);const a=document.createElement('a');a.href=url;a.download=name;a.click();URL.revokeObjectURL(url)};copy?.addEventListener('click',async()=>{if(!generated)return;await navigator.clipboard.writeText(generated.views[currentView]);const o=copy.textContent;copy.textContent='Copied';setTimeout(()=>copy.textContent=o,1000)});downloadTxt?.addEventListener('click',()=>generated&&download('bitevo-ru-authority-map.txt',generated.views.brief,'text/plain;charset=utf-8'));downloadJson?.addEventListener('click',()=>{if(!generated)return;const p={...generated};delete p.views;download('bitevo-authority-map.json',JSON.stringify(p,null,2),'application/json;charset=utf-8')});workspace?.addEventListener('click',()=>{if(!generated)return;const p={...generated};delete p.views;sessionStorage.setItem('bitevo.mapper.workspace.v1',JSON.stringify(p));location.href='/ru/workspace?from=mapper'});handoff?.addEventListener('click',()=>{if(!generated)return;const p={...generated};delete p.views;sessionStorage.setItem('bitevo.mapper.handoff.v1',JSON.stringify(p));location.href='/ru/audit-intake?from=mapper'});
</script>
<style>.hero{padding-top:clamp(68px,9vw,118px)}.split{display:grid;grid-template-columns:1fr 1fr;gap:clamp(38px,7vw,96px);align-items:end}.actions,.form-actions,.output-actions{display:flex;gap:9px;flex-wrap:wrap}.warning{max-width:1180px;margin-bottom:18px;padding:18px;display:grid;grid-template-columns:34px 1fr;gap:12px;border-color:rgba(215,197,143,.25)}.warning>span{color:var(--gold)}.warning p{margin:4px 0 0;color:var(--muted)}.mapper-grid{max-width:1180px;display:grid;grid-template-columns:1.08fr .92fr;gap:18px;align-items:start}.form{padding:0 28px}.form section{padding:27px 0;border-bottom:1px solid var(--line)}header{display:grid;grid-template-columns:34px 1fr;gap:12px;margin-bottom:20px}header>span,legend>span{color:var(--green);font:500 .62rem var(--mono)}header h2{margin:0}header p{margin:4px 0 0;color:var(--muted)}.two{display:grid;grid-template-columns:1fr 1fr;gap:12px}label{display:flex;flex-direction:column;gap:7px;margin-bottom:14px;color:var(--muted);font:500 .62rem var(--mono);text-transform:uppercase}input,textarea,select{width:100%;border:1px solid var(--line-strong);border-radius:10px;background:rgba(255,255,255,.025);color:var(--ink);padding:10px 11px;font:.82rem/1.5 var(--sans);text-transform:none;outline:none}.gate-list{border-top:1px solid var(--line)}fieldset{border:0;margin:0;padding:19px 0;border-bottom:1px solid var(--line)}legend{width:100%;display:grid;grid-template-columns:34px 1fr;gap:12px}legend div{display:flex;flex-direction:column;gap:4px}legend small{color:var(--muted);font:500 .55rem var(--mono)}legend strong{font-size:.82rem}.choices{display:flex;gap:8px;margin:12px 0 0 46px}.choices label{display:flex;flex-direction:row;align-items:center;gap:6px;border:1px solid var(--line);border-radius:999px;padding:7px 10px;margin:0}.choices input{width:auto;accent-color:var(--green)}.form-actions{padding:24px 0}.import{cursor:pointer}.import input{display:none}.output{position:sticky;top:96px;padding:24px}.output-head{display:flex;justify-content:space-between}.output-head h2{margin:0}.output-head>span{color:var(--muted);font:500 .55rem var(--mono)}.empty{min-height:420px;display:flex;flex-direction:column;justify-content:center;border-top:1px solid var(--line);margin-top:18px}.empty p,.posture p,.boundary p{color:var(--muted)}.posture{padding:20px 0;border-top:1px solid var(--line);margin-top:18px}.posture small,.boundary span{color:var(--gold);font:500 .55rem var(--mono)}.posture h3{color:var(--green);font-size:1.5rem;margin:6px 0}.tabs{display:flex;gap:6px;flex-wrap:wrap;padding:14px 0;border-top:1px solid var(--line)}.tabs button{border:1px solid var(--line);border-radius:999px;background:transparent;color:var(--muted);padding:7px 9px}.tabs button.active{color:var(--ink);border-color:rgba(127,208,177,.4)}pre{min-height:360px;max-height:540px;overflow:auto;padding:16px;border:1px solid var(--line);border-radius:10px;white-space:pre-wrap;color:var(--ink-soft);font:.65rem/1.6 var(--mono)}.boundary{margin-top:16px;padding-top:16px;border-top:1px solid var(--line)}@media(max-width:940px){.split,.mapper-grid{grid-template-columns:1fr}.output{position:static}}@media(max-width:620px){.two{grid-template-columns:1fr}.form{padding:0 17px}.choices{margin-left:0;flex-wrap:wrap}}</style>
