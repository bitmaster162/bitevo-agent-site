---
import RuLayout from '../../layouts/RuLayout.astro';
const notes=[
 ['Security','Security Sandboxing','/ru/guides/security-sandboxing','Русская проверенная заметка про isolation boundaries и tool-execution controls без раскрытия private infrastructure.'],
 ['Operations','Fleet Coordinator Drift Monitoring','/ru/guides/fleet-coordinator-drift-monitoring','Русская архитектурная заметка про drift, baseline, freshness и provenance — не live internal telemetry.'],
 ['Contract','Tool-I/O Bridge Contract','/ru/guides/d3-tool-io-bridge-contract','Русская проверенная interface note про object/effect binding без private operator-control routes и внутренних endpoints.']
];
---
<RuLayout title="Библиотека исследований BitEvo — русский индекс проверенных заметок" description="Русский индекс и semantic-parity версии четырёх reviewed public BitEvo notes: authority method, sandboxing, drift monitoring и tool-I/O contracts." enPath="/guides" ruPath="/ru/guides">
<section class="section hero"><div class="container split"><div><div class="eyebrow">Проверенные публичные исследования</div><h1 class="display">Публиковать меньше. Отвечать за большее.</h1></div><p class="lede">RU index теперь ведёт на русские semantic-parity версии текущего проверенного публичного corpus. Граница claims остаётся той же: research не превращается в customer proof, certification или current runtime state.</p></div></section>
<section class="section-tight section-rule"><div class="container boundary panel"><div><span>PUBLICATION POLICY</span><strong>Проверено до публичной индексации</strong></div><p>Research ≠ customer proof, certification, legal advice или current runtime claim. Time-sensitive facts нужно повторно проверять по primary sources перед operational use.</p></div></section>
<section class="section section-rule"><div class="container notes">{notes.map(([type,title,href,text],i)=><a class="panel" href={href}><div class="top"><span>{String(i+1).padStart(2,'0')}</span><small>{type} · RU NOTE</small></div><div><h2>{title}</h2><p>{text}</p></div><strong>Открыть проверенную заметку ↗</strong></a>)}</div></section>
<section class="section section-rule"><div class="container split"><div><div class="eyebrow">Архив legacy-материалов</div><h2 class="section-title">Исторические заметки не выдаются за current evidence.</h2></div><div><p class="lede">Старые материалы смешивали research, historical metrics и time-sensitive technology claims. Они возвращаются в public surface только после повторной проверки.</p><p class="lede">Удаление public route не удаляет Git history.</p></div></div></section>
<section class="section section-rule"><div class="narrow"><div class="eyebrow">Коммерческая граница</div><h2 class="section-title">Аудит использует scoped evidence, а не public research как proof.</h2><p class="lede">Commercial findings создаются против agreed workflow, Rules of Engagement и reproducible evidence criteria.</p><a class="button button-primary" href="/ru/agent-authority-audit">Audit methodology →</a></div></section>
</RuLayout>
<style>.hero{padding-top:clamp(68px,9vw,118px)}.split{display:grid;grid-template-columns:1fr 1fr;gap:clamp(38px,7vw,96px);align-items:start}.boundary{padding:22px;display:grid;grid-template-columns:.7fr 1.3fr;gap:25px}.boundary>div{display:flex;flex-direction:column;gap:4px}.boundary span{color:var(--green);font:500 .58rem var(--mono)}.boundary p{margin:0;color:var(--muted)}.notes{display:grid;grid-template-columns:1fr 1fr;gap:12px}.notes>a{padding:24px;min-height:280px;display:flex;flex-direction:column;justify-content:space-between}.top{display:flex;justify-content:space-between}.top span{color:var(--green);font:500 .58rem var(--mono)}.top small{color:var(--muted);font:500 .55rem var(--mono)}.notes h2{margin:0 0 9px;font-size:1.12rem}.notes p{margin:0;color:var(--muted)}.notes>a>strong{font-size:.74rem}@media(max-width:820px){.split,.boundary,.notes{grid-template-columns:1fr}}</style>
