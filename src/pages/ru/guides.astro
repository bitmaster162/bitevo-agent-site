---
import RuLayout from '../../layouts/RuLayout.astro';
import generated from '../../generated/research-notes.json';

const notes = [
  ['01','Безопасность','Изоляция и ограниченный запуск инструментов','/ru/guides/security-sandboxing','Публичная заметка о границах изоляции, ограниченных полномочиях инструментов и явных точках одобрения без раскрытия внутренней инфраструктуры.'],
  ['02','Операции','Мониторинг дрейфа координатора','/ru/guides/fleet-coordinator-drift-monitoring','Архитектурная заметка о дрейфе, базовой линии, свежести и происхождении доказательств — без заявлений о живой внутренней телеметрии.'],
  ['03','Контракт','Контракт ввода-вывода инструментов','/ru/guides/d3-tool-io-bridge-contract','Проверенная заметка об интерфейсном контракте, привязке объекта и эффекта без публикации внутренних маршрутов управления и закрытых адресов.'],
  ...generated.notes.filter((note) => note.lang === 'ru').map((note) => {
    const [title, ...summary] = note.card_text.split(' — ');
    return [note.card_number, note.card_type, title, note.path, summary.join(' — ') || note.description];
  })
].sort((a,b) => a[0].localeCompare(b[0]));
---

<RuLayout title="Исследовательская библиотека BitEvo — русский индекс проверенных заметок" description="Русский индекс проверенных публичных заметок BitEvo: метод полномочий, изоляция, мониторинг дрейфа и контракты ввода-вывода инструментов." enPath="/guides" ruPath="/ru/guides">
<section class="section hero"><div class="container split"><div><div class="eyebrow">Проверенные публичные заметки</div><h1 class="display">Публиковать меньше. Отвечать за большее.</h1></div><p class="lede">Здесь остаются только заметки, проверенные для текущей публичной границы доказательств. Исторические материалы возвращаются в публичную библиотеку только после повторной проверки фактов, которые могут устареть.</p></div></section>
<section class="section-tight section-rule"><div class="container boundary panel"><div><span>ПОЛИТИКА ПУБЛИКАЦИИ</span><strong>Проверено перед индексацией</strong></div><p>Проверено перед индексацией. Исследование — не доказательство для клиента, не сертификация, не юридическая консультация и не описание текущей среды выполнения. Факты, которые зависят от времени, перед использованием сверяйте с первоисточниками.</p></div></section>
<section class="section section-rule"><div class="container notes">{notes.map(([number,type,title,href,text])=><a class="panel" href={href}><div class="top"><span>{number}</span><small>{type}</small></div><div><h2>{title}</h2><p>{text}</p></div><strong>Открыть заметку →</strong></a>)}</div></section>
<section class="section section-rule"><div class="container split"><div><div class="eyebrow">Архив</div><h2 class="section-title">Исторические заметки не выдаются за актуальные доказательства.</h2></div><div><p class="lede">Старые материалы могли смешивать исследования, исторические метрики и факты, которые меняются со временем. В публичную библиотеку они возвращаются только после повторной проверки.</p><p class="lede">Удаление публичного маршрута не удаляет историю Git.</p></div></div></section>
<section class="section section-rule"><div class="narrow"><div class="eyebrow">Коммерческая граница</div><h2 class="section-title">Аудит опирается на согласованные доказательства, а не на публичные исследования как на доказательство клиента.</h2><p class="lede">Коммерческие выводы формируются для согласованного процесса, письменных правил проведения работ и воспроизводимых критериев доказательств.</p><a class="button button-primary" href="/ru/agent-authority-audit">Метод аудита →</a></div></section>
</RuLayout>
<style>.hero{padding-top:clamp(68px,9vw,118px)}.split{display:grid;grid-template-columns:1fr 1fr;gap:clamp(38px,7vw,96px);align-items:start}.boundary{padding:22px;display:grid;grid-template-columns:.7fr 1.3fr;gap:25px}.boundary>div{display:flex;flex-direction:column;gap:4px}.boundary span{color:var(--green);font:500 .58rem var(--mono)}.boundary p{margin:0;color:var(--muted)}.notes{display:grid;grid-template-columns:1fr 1fr;gap:12px}.notes>a{padding:24px;min-height:280px;display:flex;flex-direction:column;justify-content:space-between}.top{display:flex;justify-content:space-between}.top span{color:var(--green);font:500 .58rem var(--mono)}.top small{color:var(--muted);font:500 .55rem var(--mono)}.notes h2{margin:0 0 9px;font-size:1.12rem}.notes p{margin:0;color:var(--muted)}.notes>a>strong{font-size:.74rem}@media(max-width:820px){.split,.boundary,.notes{grid-template-columns:1fr}}</style>
