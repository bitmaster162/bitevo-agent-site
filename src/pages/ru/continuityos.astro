---
import RuLayout from '../../layouts/RuLayout.astro';
const caps=[['01','Долговечные записи','Структурированные facts, rules, notes и provenance остаются в local store, который можно проверять независимо от одной model session.'],['02','Retrieval с provenance','Namespaces и retrieval context помогают отличать recalled material от неподтверждённого inference.'],['03','Разделение полномочий','Remembered content может информировать решение, но не создаёт permission на tool call, state mutation, capital spend или production change.']];
---
<RuLayout title="ContinuityOS — русский обзор публичного исходного кода | BitEvo" description="Русский обзор ContinuityOS: durable local memory, provenance и governance-oriented agent workflows с явной границей memory ≠ permission." enPath="/continuityos" ruPath="/ru/continuityos">
<section class="section hero"><div class="container split"><div><div class="eyebrow">Публичный исходный код · local-first</div><h1 class="display">ContinuityOS</h1><p class="lede">Public-source проект для структурированной memory, provenance и governance context вне одной model session — при явном разделении памяти и полномочий на действие.</p><div class="actions"><a class="button button-primary" href="https://github.com/bitmaster162/continuityos" target="_blank" rel="noopener">Public source ↗</a><a class="button" href="/ru/agent-authority-audit">Authority audit</a></div></div><aside class="status panel"><div><span>ПУБЛИЧНЫЙ СТАТУС</span><strong>Исходный код доступен</strong></div><div><span>Путь установки</span><strong>Исходный код GitHub</strong></div><div><span>Модель памяти</span><strong>Локальная / проверяемая</strong></div><div><span>Допущение о полномочиях</span><strong>Память ≠ permission</strong></div><p>Package-manager install намеренно не рекламируется, пока public package/release и clean installation не verified отдельно.</p></aside></div></section>
<section class="section section-rule"><div class="container split"><div><div class="eyebrow">Основная идея</div><h2 class="section-title">Continuity без притворства, что память = истина.</h2></div><p class="lede">Persistent context полезен, только если provenance и границы полномочий видимы. Retrieved context не становится автоматически корректным или полным.</p></div><div class="container caps">{caps.map(([n,title,text])=><article class="panel"><span>{n}</span><h3>{title}</h3><p>{text}</p></article>)}</div></section>
<section class="section section-rule"><div class="container flow panel" role="region" tabindex="0" aria-label="Концептуальный поток ContinuityOS"><div><small>01</small><strong>Source</strong><span>fact · note · rule · artifact</span></div><b>→</b><div><small>02</small><strong>Record</strong><span>structured + provenance</span></div><b>→</b><div><small>03</small><strong>Retrieve</strong><span>query + context</span></div><b>→</b><div class="accent"><small>04</small><strong>Decision context</strong><span>not execution authority</span></div></div></section>
<section class="section section-rule"><div class="container boundaries"><article class="panel"><div class="eyebrow">Граница доказательств</div><h2>Что можно утверждать.</h2><p>Структурированная memory + provenance делают stored context более проверяемым и уменьшают неоднозначность retrieval.</p></article><article class="panel"><div class="eyebrow">Что нельзя утверждать</div><h2>Нет автоматической корректности.</h2><p>ContinuityOS не устраняет ошибки модели, не превращает memory в permission, не сертифицирует downstream decisions и не гарантирует полноту retrieval.</p></article></div></section>
</RuLayout>
<style>.hero{padding-top:clamp(68px,9vw,118px)}.split{display:grid;grid-template-columns:1fr .8fr;gap:clamp(38px,7vw,96px);align-items:center}.actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:24px}.status{padding:22px}.status>div{display:flex;justify-content:space-between;gap:15px;padding:12px 0;border-bottom:1px solid var(--line)}.status span{color:var(--muted);font-size:.74rem}.status strong{font-size:.74rem}.status p{color:var(--muted);font-size:.72rem}.caps{margin-top:36px;display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.caps article{padding:24px;min-height:240px;display:flex;flex-direction:column}.caps span{color:var(--green);font:500 .6rem var(--mono)}.caps h3{margin:auto 0 9px}.caps p{margin:0;color:var(--muted)}.flow{padding:18px;display:flex;align-items:stretch;gap:8px}.flow>div{flex:1;min-width:0;padding:18px;border:1px solid var(--line);border-radius:12px;display:flex;flex-direction:column;gap:5px}.flow b{display:grid;place-items:center;color:var(--muted)}.flow small{color:var(--green);font:500 .55rem var(--mono)}.flow span{color:var(--muted);font-size:.68rem}.flow .accent{border-color:rgba(127,208,177,.35)}.boundaries{display:grid;grid-template-columns:1fr 1fr;gap:12px}.boundaries article{padding:28px}.boundaries h2{margin:5px 0 10px}.boundaries p{margin:0;color:var(--muted)}@media(max-width:900px){.split{grid-template-columns:1fr}.caps{grid-template-columns:1fr}.flow{overflow-x:auto}.flow>div{min-width:150px}.boundaries{grid-template-columns:1fr}}</style>
