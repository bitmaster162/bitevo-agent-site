---
import RuLayout from '../../layouts/RuLayout.astro';
const artifacts = [
  ['A1','Authority Ledger','Определяет consequential actions, target/object binding, authority owner, approval path, allowed/prohibited transitions, retry/replay rights и recovery owner.','Какая authority существует сейчас и что должно expand / constrain / remain conditional?'],
  ['A2','Evidence Contract','Фиксирует required input, provenance, freshness, object binding, approval evidence, version/config context, external confirmation и missing-evidence behavior.','Что должно быть true до того, как workflow тратит Authority Budget?'],
  ['A3','Finding Record','Сохраняет trigger, authority, observed evidence, external effect, recovery, reproduction, consequence и uncertainty без превращения hypothesis в conclusion.','Достаточно ли finding значим, чтобы CONSTRAIN / REPAIR / RETEST?'],
  ['A4','Decision Memo','Переводит evidence в bounded owner action: decision, supporting evidence, uncertainty, control change, authority after decision, retest criterion и named owner.','EXPAND / CONSTRAIN / REPAIR / RETEST.']
];
const primary=['Executive report','Authority / effect map','Test inventory and scenario results','Reproducible evidence pack','Finding cards with impact, evidence, limitations and confidence','Prioritized repair backlog','One retest','Evidence manifest / hashes where applicable'];
---
<RuLayout title="Audit Artifacts — русский обзор | BitEvo" description="Русская анатомия Authority Ledger, Evidence Contract, Finding Record и Decision Memo, плюс полный восьмичастный Primary Audit delivery package." enPath="/artifacts" ruPath="/ru/artifacts">
<section class="section hero"><div class="container split"><div><div class="eyebrow">Audit artifacts</div><h1 class="display">Метод заканчивается inspectable artifacts, а не trust score.</h1></div><div><p class="lede">A1–A4 показывают decision structure. Это templates и worked structure, не customer evidence или certification.</p><div class="actions"><a class="button button-primary" href="/mapper">Draft A1 + A2 (EN Mapper) ↗</a><a class="button" href="/ru/proof">Proof Matrix</a></div></div></div></section>
<section class="section-tight section-rule"><div class="container stack">{artifacts.map(([code,name,purpose,decision])=><article class="panel artifact"><span class="code">{code}</span><div><div class="eyebrow">Decision-grade artifact</div><h2>{name}</h2><p>{purpose}</p></div><div class="decision"><small>OWNER QUESTION</small><strong>{decision}</strong></div></article>)}</div></section>
<section class="section section-rule"><div class="container split"><div><div class="eyebrow">Commercial delivery boundary</div><h2 class="section-title">A1–A4 — spine, но не весь коммерческий пакет.</h2></div><p class="lede">Primary Audit exhaustive at eight deliverable classes. Нельзя сокращать публичное обещание до четырёх внутренних artifacts.</p></div><div class="container package">{primary.map((x,i)=><article><span>{String(i+1).padStart(2,'0')}</span><strong>{x}</strong></article>)}</div></section>
<section class="section section-rule"><div class="container chain panel"><div><div class="eyebrow">Local artifact chain</div><h2>Draft → compare → scope. Finding не фабрикуется формой.</h2></div><div class="steps"><a href="/mapper"><span>01</span><strong>Mapper</strong><p>Draft Authority Ledger + Evidence Contract.</p></a><a href="/workspace"><span>02</span><strong>Workspace</strong><p>Compare checkpoints + bounded Decision Memo.</p></a><a href="/ru/audit-intake"><span>03</span><strong>RU Intake</strong><p>Owner + access + data + RoE boundaries.</p></a></div></div></section>
<section class="section section-rule"><div class="narrow"><div class="eyebrow">Evidence boundary</div><h2 class="section-title">Finding Record требует scoped testing evidence.</h2><p class="lede">Публичная форма может подготовить структуру решения, но не имеет права создавать observed finding там, где observation не было.</p><a class="button button-primary" href="/ru/audit-intake">Подготовить scope →</a></div></section>
</RuLayout>
<style>.hero{padding-top:clamp(68px,9vw,118px)}.split{display:grid;grid-template-columns:1fr 1fr;gap:clamp(38px,7vw,96px);align-items:start}.actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:22px}.stack{display:grid;gap:12px}.artifact{display:grid;grid-template-columns:55px .9fr 1.1fr;gap:26px;padding:28px}.code{color:var(--green);font:500 .64rem var(--mono)}.artifact h2{margin:4px 0 8px}.artifact p{margin:0;color:var(--muted)}.decision{padding-left:22px;border-left:1px solid var(--line)}.decision small{display:block;color:var(--muted);font:500 .55rem var(--mono);letter-spacing:.08em}.decision strong{display:block;margin-top:8px}.package{margin-top:36px;display:grid;grid-template-columns:1fr 1fr;border:1px solid var(--line);border-radius:var(--radius);overflow:hidden}.package article{display:grid;grid-template-columns:45px 1fr;gap:10px;padding:19px;border-right:1px solid var(--line);border-bottom:1px solid var(--line)}.package article:nth-child(2n){border-right:0}.package article:nth-last-child(-n+2){border-bottom:0}.package span{color:var(--green);font:500 .58rem var(--mono)}.chain{padding:30px;display:grid;grid-template-columns:.75fr 1.25fr;gap:45px}.chain h2{margin:4px 0}.steps{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.steps a{padding:18px;border:1px solid var(--line);border-radius:12px}.steps span{color:var(--green);font:500 .55rem var(--mono)}.steps strong{display:block;margin:30px 0 6px}.steps p{margin:0;color:var(--muted);font-size:.75rem}@media(max-width:900px){.split,.chain{grid-template-columns:1fr}.artifact{grid-template-columns:45px 1fr}.decision{grid-column:2}}@media(max-width:620px){.artifact{grid-template-columns:1fr}.code{display:none}.decision{grid-column:auto;padding-left:0;padding-top:16px;border-left:0;border-top:1px solid var(--line)}.package,.steps{grid-template-columns:1fr}.package article{border-right:0}.package article:nth-last-child(-n+2){border-bottom:1px solid var(--line)}.package article:last-child{border-bottom:0}}</style>
