---
import RuLayout from '../../layouts/RuLayout.astro';
const artifacts = [
  ['A1','Authority Ledger','Определяет consequential actions, target/object binding, owner полномочий, путь approval, разрешённые/запрещённые transitions, права retry/replay и recovery owner.','Какие полномочия существуют сейчас и что должно расшириться, сузиться или остаться условным?'],
  ['A2','Evidence Contract','Фиксирует required input, provenance, freshness, object binding, доказательство approval, version/config context, external confirmation и поведение при отсутствии evidence.','Что должно быть истинно до того, как workflow тратит Authority Budget?'],
  ['A3','Finding Record','Сохраняет trigger, полномочия, observed evidence, внешний эффект, recovery, reproduction, consequence и uncertainty без превращения hypothesis в conclusion.','Достаточно ли finding значим, чтобы CONSTRAIN / REPAIR / RETEST?'],
  ['A4','Decision Memo','Переводит evidence в ограниченное действие owner: decision, supporting evidence, uncertainty, изменение control, полномочия после решения, критерий retest и named owner.','EXPAND / CONSTRAIN / REPAIR / RETEST.']
];
const primary=['Executive report','Карта authority / effect','Инвентарь тестов и результаты сценариев','Воспроизводимый evidence pack','Карточки findings с impact, evidence, limitations и confidence','Приоритизированный repair backlog','Один retest','Evidence manifest / hashes where applicable'];
---
<RuLayout title="Артефакты аудита — русский обзор | BitEvo" description="Русская анатомия Authority Ledger, Evidence Contract, Finding Record и Decision Memo, плюс полный восьмичастный Primary Audit delivery package." enPath="/artifacts" ruPath="/ru/artifacts">
<section class="section hero"><div class="container split"><div><div class="eyebrow">Артефакты аудита</div><h1 class="display">Метод заканчивается проверяемыми артефактами, а не trust score.</h1></div><div><p class="lede">A1–A4 показывают структуру решения. Это templates и worked structure, не customer evidence и не certification.</p><div class="actions"><a class="button button-primary" href="/mapper">Draft A1 + A2 (EN Mapper) ↗</a><a class="button" href="/ru/proof">Proof Matrix</a></div></div></div></section>
<section class="section-tight section-rule"><div class="container stack">{artifacts.map(([code,name,purpose,decision])=><article class="panel artifact"><span class="code">{code}</span><div><div class="eyebrow">Артефакт для решения</div><h2>{name}</h2><p>{purpose}</p></div><div class="decision"><small>ВОПРОС OWNER</small><strong>{decision}</strong></div></article>)}</div></section>
<section class="section section-rule"><div class="container split"><div><div class="eyebrow">Граница коммерческого delivery</div><h2 class="section-title">A1–A4 — spine, но не весь коммерческий пакет.</h2></div><p class="lede">Primary Audit включает восемь классов deliverables. Нельзя сокращать публичное обещание до четырёх внутренних артефактов.</p></div><div class="container package">{primary.map((x,i)=><article><span>{String(i+1).padStart(2,'0')}</span><strong>{x}</strong></article>)}</div></section>
<section class="section section-rule"><div class="container chain panel"><div><div class="eyebrow">Локальная цепочка артефактов</div><h2>Черновик → сравнение → scope. Finding не фабрикуется формой.</h2></div><div class="steps"><a href="/mapper"><span>01</span><strong>Mapper</strong><p>Черновик Authority Ledger + Evidence Contract.</p></a><a href="/workspace"><span>02</span><strong>Workspace</strong><p>Сравнить checkpoints + ограниченный Decision Memo.</p></a><a href="/ru/audit-intake"><span>03</span><strong>RU Intake</strong><p>Owner + доступ + данные + границы RoE.</p></a></div></div></section>
<section class="section section-rule"><div class="narrow"><div class="eyebrow">Граница доказательств</div><h2 class="section-title">Finding Record требует доказательства scoped testing.</h2><p class="lede">Публичная форма может подготовить структуру решения, но не имеет права создавать observed finding там, где не было наблюдения.</p><a class="button button-primary" href="/ru/audit-intake">Подготовить scope →</a></div></section>
</RuLayout>
<style>.hero{padding-top:clamp(68px,9vw,118px)}.split{display:grid;grid-template-columns:1fr 1fr;gap:clamp(38px,7vw,96px);align-items:start}.actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:22px}.stack{display:grid;gap:12px}.artifact{display:grid;grid-template-columns:55px .9fr 1.1fr;gap:26px;padding:28px}.code{color:var(--green);font:500 .64rem var(--mono)}.artifact h2{margin:4px 0 8px}.artifact p{margin:0;color:var(--muted)}.decision{padding-left:22px;border-left:1px solid var(--line)}.decision small{display:block;color:var(--muted);font:500 .55rem var(--mono);letter-spacing:.08em}.decision strong{display:block;margin-top:8px}.package{margin-top:36px;display:grid;grid-template-columns:1fr 1fr;border:1px solid var(--line);border-radius:var(--radius);overflow:hidden}.package article{display:grid;grid-template-columns:45px 1fr;gap:10px;padding:19px;border-right:1px solid var(--line);border-bottom:1px solid var(--line)}.package article:nth-child(2n){border-right:0}.package article:nth-last-child(-n+2){border-bottom:0}.package span{color:var(--green);font:500 .58rem var(--mono)}.chain{padding:30px;display:grid;grid-template-columns:.75fr 1.25fr;gap:45px}.chain h2{margin:4px 0}.steps{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.steps a{padding:18px;border:1px solid var(--line);border-radius:12px}.steps span{color:var(--green);font:500 .55rem var(--mono)}.steps strong{display:block;margin:30px 0 6px}.steps p{margin:0;color:var(--muted);font-size:.75rem}@media(max-width:900px){.split,.chain{grid-template-columns:1fr}.artifact{grid-template-columns:45px 1fr}.decision{grid-column:2}}@media(max-width:620px){.artifact{grid-template-columns:1fr}.code{display:none}.decision{grid-column:auto;padding-left:0;padding-top:16px;border-left:0;border-top:1px solid var(--line)}.package,.steps{grid-template-columns:1fr}.package article{border-right:0}.package article:nth-last-child(-n+2){border-bottom:1px solid var(--line)}.package article:last-child{border-bottom:0}}</style>
