---
import RuLayout from '../../layouts/RuLayout.astro';

const risks = [
  { id:'ASI01', name:'Agent Goal Hijack', gates:['Authority Budget','Evidence Before Effect'], evidence:'The attempted action and the rule that allowed or refused it', scope:'We test what a hijacked agent can still do, not whether the model resists injected text' },
  { id:'ASI02', name:'Tool Misuse and Exploitation', gates:['Authority Budget','Object binding'], evidence:'The object ID checked before execution, and the ID that actually changed', scope:'Core scope' },
  { id:'ASI03', name:'Identity and Privilege Abuse', gates:['Authority owner','Authority Budget'], evidence:'The grant or approval record that links the role to the action', scope:'Core scope' },
  { id:'ASI04', name:'Agentic Supply Chain Vulnerabilities', gates:['Authority Budget'], evidence:'Which third-party tools and MCP servers can act, and with what permissions', scope:'We map their authority; we do not audit their code' },
  { id:'ASI05', name:'Unexpected Code Execution (RCE)', gates:['Authority Budget'], evidence:'Whether code execution is an allowed action at all, and for which inputs', scope:'Exploit development is out of scope' },
  { id:'ASI06', name:'Memory & Context Poisoning', gates:['Freshness','Evidence Before Effect'], evidence:'Time, source and version of each item the agent relied on at decision time', scope:'We test whether stale or unverified context can trigger an action' },
  { id:'ASI07', name:'Insecure Inter-Agent Communication', gates:['Authority owner','External confirmation'], evidence:'Who delegated authority between agents, and independent confirmation of the effect', scope:'Within the one workflow in scope' },
  { id:'ASI08', name:'Cascading Failures', gates:['Recovery','External confirmation'], evidence:'The state change when confirmation is missing, and who released the workflow', scope:'Core scope: retries, resume, duplicate effects' },
  { id:'ASI09', name:'Human-Agent Trust Exploitation', gates:['External confirmation','Authority owner'], evidence:'Whether "done" was reported before the external system confirmed it, and what the approver was shown', scope:'We test approval evidence, not user training' },
  { id:'ASI10', name:'Rogue Agents', gates:['Authority Budget','Recovery'], evidence:'Actions outside the agreed budget, and the stop or constrained state that follows', scope:'Detection tooling is out of scope' }
];
---

<RuLayout
  title="OWASP Agentic Top 10 (ASI01–ASI10) и тесты полномочий AI-агентов — BitEvo"
  description="Сопоставление десяти рисков OWASP Top 10 for Agentic Applications с семью воротами BitEvo, проверяемыми доказательствами и границами scope."
  enPath="/owasp-agentic-top-10"
  ruPath="/ru/owasp-agentic-top-10"
>
  <section class="section">
    <div class="narrow">
      <div class="eyebrow">OWASP / СОПОСТАВЛЕНИЕ AGENTIC SECURITY</div>
      <h1 class="display">OWASP Top 10 for Agentic Applications — как это сопоставлено с тестами BitEvo</h1>
      <p class="lede">OWASP опубликовал Top 10 for Agentic Applications 9 декабря 2025 года. BitEvo проверяет цепочку действий одного workflow в staging или test. Таблица показывает, какие из семи ворот BitEvo относятся к каждому риску, какие доказательства мы ищем и где заканчивается scope.</p>
    </div>
  </section>

  <section class="section-tight section-rule">
    <div class="narrow">
      <div class="eyebrow">ASI01–ASI10</div>
      <h2 class="section-title">Риск → ворота → доказательства → граница scope</h2>
    </div>
  </section>

  {risks.map((risk) => (
    <section class="dogfood-context section-rule">
      <article class="container dogfood-context-card panel" data-asi={risk.id}>
        <div lang="en">
          <div class="eyebrow">{risk.id} · OWASP risk</div>
          <h2>{risk.name}</h2>
          <p><strong>BitEvo gates:</strong> {risk.gates.join(' · ')}</p>
        </div>
        <div class="dogfood-context-side" lang="en">
          <span>Evidence we look for</span>
          <p>{risk.evidence}</p>
          <span>Scope note</span>
          <p>{risk.scope}</p>
        </div>
      </article>
    </section>
  ))}

  <section class="dogfood-context section-rule">
    <div class="container dogfood-context-card panel">
      <div>
        <div class="eyebrow">Граница сопоставления</div>
        <h2>Сопоставление BitEvo предназначено для определения scope.</h2>
        <p>Это не сертификация и не одобрение OWASP.</p>
      </div>
      <div class="dogfood-context-side">
        <span>Официальный источник</span>
        <a class="button" href="https://genai.owasp.org/resource/owasp-top-10-for-agentic-applications-for-2026/" lang="en">OWASP GenAI Security Project — Top 10 for Agentic Applications 2026</a>
      </div>
    </div>
  </section>
</RuLayout>
