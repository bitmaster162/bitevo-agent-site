---
const buildSha = import.meta.env.VERCEL_GIT_COMMIT_SHA || 'local-preview';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="robots" content="noindex,nofollow" />
  <meta name="theme-color" content="#071013" />
  <title>Site Agent Copilot Lab | BitEvo</title>
  <style>
    :root{--bg:#071013;--panel:#0e1a1e;--line:#284047;--text:#f1f7f8;--muted:#9eb2b7;--accent:#a5f3d0;--warn:#f2d58a}*{box-sizing:border-box}body{margin:0;background:linear-gradient(180deg,#071013,#0a1518);color:var(--text);font:15px/1.55 Inter,system-ui,sans-serif}.w{width:min(1050px,calc(100% - 28px));margin:auto;padding:28px 0 80px}a{color:var(--accent)}h1{font-size:clamp(42px,7vw,74px);line-height:.94;letter-spacing:-.055em;margin:32px 0 15px}.lead{color:var(--muted);font-size:19px;max-width:850px}.grid{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:24px}.card{border:1px solid var(--line);background:var(--panel);border-radius:24px;padding:22px}.card h2{margin-top:0}.row{display:flex;gap:8px;flex-wrap:wrap}.btn,select{border:1px solid var(--line);background:#101f23;color:var(--text);border-radius:12px;padding:10px 13px;font:inherit}.btn{cursor:pointer;font-weight:800}.primary{background:var(--accent);color:#082118;border-color:var(--accent)}textarea,pre{width:100%;min-height:310px;border:1px solid var(--line);border-radius:15px;background:#050b0d;color:#dce8eb;padding:14px;font:13px/1.5 ui-monospace,SFMono-Regular,Menlo,monospace;white-space:pre-wrap;overflow:auto}.status{padding:12px 14px;border-radius:13px;background:#0a1518;border:1px solid var(--line);margin:12px 0;color:var(--muted)}.warn{color:var(--warn)}footer{margin-top:24px;color:var(--muted);font-size:12px}@media(max-width:800px){.grid{grid-template-columns:1fr}}
  </style>
</head>
<body><main class="w"><a href="/site-agent-lab">← Site Agent Lab</a><h1>Owner Copilot Lab.</h1><p class="lead">Paste or generate a <code>SITE_AGENT_ENVELOPE_V1</code>. This browser-local lab loads the public policy pack, validates the envelope, identifies missing information / risk flags and creates a deterministic owner-review draft. No submission, CRM write, message or external effect.</p><div class="row"><select id="lane"><option value="dar">Dar</option><option value="pharaohs">Pharaohs Rawai</option><option value="yakov">Yakov</option><option value="ivan">Ivan</option><option value="stas">Stas</option><option value="haven">HAVEN</option><option value="creator">Creator Partner</option><option value="bitevo">BitEvo</option></select><button class="btn" id="sample">Load safe sample</button><button class="btn primary" id="run">Run owner-copilot review</button><button class="btn" id="clear">Clear</button></div><div class="status" id="status">Policy not loaded yet.</div><div class="grid"><section class="card"><h2>Input envelope</h2><textarea id="input" spellcheck="false" placeholder='{"schema_version":"SITE_AGENT_ENVELOPE_V1", ...}'></textarea></section><section class="card"><h2>Owner copilot output</h2><pre id="output">No review yet.</pre><div class="row"><button class="btn" id="copy">Copy output JSON</button><button class="btn" id="download">Download output</button></div></section></div><section class="card"><h2>Effect boundary</h2><p class="warn">This lab cannot send, reply, book, order, pay, write CRM, access accounts or publish. It does not turn a lead into a conversion. All proposed replies and next actions require human review.</p></section><footer>Build: {buildSha} · noindex · browser-local deterministic QA</footer></main><script src="/site-agent-copilot-lab.js" defer></script></body></html>
