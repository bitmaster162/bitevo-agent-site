---
import Layout from '../layouts/Layout.astro';

const concepts = [
  {
    code: '01',
    name: 'Authority Budget',
    thesis: 'Capability is not free authority.',
    text: 'Every write permission, integration, autonomous step, retry path and approval shortcut expands the authority surface. BitEvo treats authority as something a workflow must earn and continuously justify with controls and evidence.',
    test: 'What new external effect becomes possible, who owns that permission, and what evidence is required before the workflow may spend it?'
  },
  {
    code: '02',
    name: 'Evidence Before Effect',
    thesis: 'Proof after the fact is not an action gate.',
    text: 'A critical action should depend on evidence available at decision time: the right object, current source state, valid approval, expected version context and a defined confirmation path. Post-hoc logs help reconstruct an event; they do not retroactively justify it.',
    test: 'If one required piece of evidence disappears or becomes stale, does the workflow stop, constrain itself or continue anyway?'
  },
  {
    code: '03',
    name: 'False Green',
    thesis: 'Healthy-looking is not the same as proven healthy.',
    text: 'A workflow can report success while source freshness has stopped, a tool response was never confirmed externally, a retry duplicated an effect, or the observed state belongs to the wrong object. BitEvo calls this class of operational ambiguity a false green.',
    test: 'What independent evidence turns an internal success signal into a trusted external result?'
  }
];

const artifacts = [
  ['Authority Ledger', 'Records the action, target object, authority owner, approvals, allowed transitions, prohibited transitions and replay/recovery rights.'],
  ['Evidence Contract', 'Defines what must be present, fresh, attributable and object-bound before a critical effect is allowed.'],
  ['Finding Record', 'Preserves trigger, authority, evidence, external effect, recovery and uncertainty so another engineer can reproduce the claim.'],
  ['Decision Memo', 'Converts accepted evidence into one bounded owner action: expand, constrain, repair or retest.']
];

const rules = [
  ['Scope before access', 'No public form or conversation authorizes testing. The workflow, actions, data ceiling and prohibited transitions are written down first.'],
  ['Authority follows evidence', 'A workflow should not gain more consequential capability than the team can justify, reconstruct and contain.'],
  ['External effect closes the loop', 'Internal completion, model output or tool acknowledgement is not sufficient when the intended result lives in another system.'],
  ['Uncertainty changes behavior', 'Missing evidence, stale state and ambiguous confirmation should produce an explicit constrained or recovery state — not silent continuation.'],
  ['A finding must change a decision', 'Accepted findings end in an owner action: expand, constrain, repair or retest. Hypotheses remain hypotheses until reproduced.']
];
---

<Layout title="BitEvo Doctrine — Authority, Evidence and False Green" description="The BitEvo engineering doctrine for action-capable AI workflows: Authority Budget, Evidence Before Effect and False Green.">
  <section class="doctrine-hero section">
    <div class="container hero-grid">
      <div>
        <div class="eyebrow">BitEvo Doctrine</div>
        <h1 class="display">Authority is a claim. Evidence is what earns it.</h1>
      </div>
      <div>
        <p class="lede">BitEvo is built around a narrow operating question: <strong>what must be true before an AI workflow is allowed to create a real external effect?</strong> The doctrine below gives that question a consistent engineering vocabulary.</p>
        <a class="button button-primary" href="/agent-authority-audit">See how it is audited <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>

  <section class="section-tight section-rule">
    <div class="container concept-stack">
      {concepts.map(concept => (
        <article class="concept panel">
          <div class="concept-code">{concept.code}</div>
          <div class="concept-name"><div class="eyebrow">Core concept</div><h2>{concept.name}</h2><strong>{concept.thesis}</strong></div>
          <div class="concept-copy"><p>{concept.text}</p><div class="test"><span>TEST QUESTION</span><p>{concept.test}</p></div></div>
        </article>
      ))}
    </div>
  </section>

  <section class="section section-rule">
    <div class="container loop-grid">
      <div>
        <div class="eyebrow">The operating loop</div>
        <h2 class="section-title">Intent → Authority → Evidence → Effect → Recovery → Decision.</h2>
        <p class="lede">The workflow is not judged by whether a model produced a plausible answer. It is judged at the point where intention becomes an external consequence.</p>
      </div>
      <ol class="loop panel">
        <li><span>01</span><div><strong>Intent</strong><p>What change is being proposed, to which object, and for what reason?</p></div></li>
        <li><span>02</span><div><strong>Authority</strong><p>Is that exact change within the workflow’s current permission and approval boundary?</p></div></li>
        <li><span>03</span><div><strong>Evidence</strong><p>Is the minimum decision evidence present, fresh and attached to the right object?</p></div></li>
        <li><span>04</span><div><strong>Effect</strong><p>Did the intended external system actually reach the expected state?</p></div></li>
        <li><span>05</span><div><strong>Recovery</strong><p>If certainty breaks, does the workflow stop, retry safely, roll back or escalate?</p></div></li>
        <li><span>06</span><div><strong>Decision</strong><p>Does the evidence justify expanding authority, constraining it, repairing the chain or retesting?</p></div></li>
      </ol>
    </div>
  </section>

  <section class="section section-rule artifacts-section">
    <div class="container section-head">
      <div><div class="eyebrow">Doctrine → artifact</div><h2 class="section-title">The vocabulary becomes four inspectable work products.</h2></div>
      <div><p class="lede">The doctrine is only useful if it changes how the workflow is described, tested and governed. These artifacts carry the model from scope to owner decision.</p><a href="/artifacts" class="artifact-link">Inspect the artifact anatomy →</a></div>
    </div>
    <div class="container artifact-grid">
      {artifacts.map(([title, text], i) => (
        <article class="artifact-card panel"><span>{String(i + 1).padStart(2,'0')}</span><h3>{title}</h3><p>{text}</p></article>
      ))}
    </div>
  </section>

  <section class="section section-rule false-green">
    <div class="container fg-grid panel">
      <div><div class="eyebrow">Failure class</div><div class="fg-label">FALSE GREEN</div></div>
      <div>
        <h2>A system can look healthy while the decision is already untrustworthy.</h2>
        <p>Examples include stale source state behind a healthy service, an internal success flag without external confirmation, a retry path that can duplicate a write, or an approval that belongs to a different object than the action being executed.</p>
        <p class="boundary">“False Green” is BitEvo terminology for an operational evidence mismatch. It is not a claim that every such mismatch is a security vulnerability.</p>
      </div>
    </div>
  </section>

  <section class="section section-rule">
    <div class="container rules-grid">
      <div><div class="eyebrow">Operating rules</div><h2 class="section-title">Five rules keep the doctrine falsifiable.</h2></div>
      <div class="rules">
        {rules.map(([title, text], i) => (
          <article><span>{String(i + 1).padStart(2,'0')}</span><div><strong>{title}</strong><p>{text}</p></div></article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-rule">
    <div class="narrow final">
      <div class="eyebrow">Commercial translation</div>
      <h2 class="section-title">The audit buys a decision about authority.</h2>
      <p class="lede">The primary engagement applies this doctrine to one staging/test workflow and returns a bounded evidence package for an owner decision — not a universal trust score.</p>
      <div class="actions"><a class="button button-primary" href="/mapper">Map one workflow <span aria-hidden="true">↗</span></a><a class="button button-ghost" href="/artifacts">See the work products</a></div>
    </div>
  </section>
</Layout>

<style>
  .doctrine-hero{padding-top:clamp(78px,10vw,132px)}.hero-grid{display:grid;grid-template-columns:1.08fr .92fr;gap:clamp(42px,8vw,110px);align-items:end}.hero-grid .lede{margin:0 0 26px}.hero-grid .lede strong{color:var(--ink)}
  .concept-stack{display:grid;gap:14px}.concept{display:grid;grid-template-columns:55px .72fr 1.28fr;gap:28px;padding:32px;align-items:start}.concept-code{color:#586561;font:500 .66rem var(--mono)}.concept-name h2{font-size:clamp(1.6rem,3vw,2.6rem);letter-spacing:-.04em;margin:4px 0 10px}.concept-name>strong{display:block;color:var(--green);font-size:.86rem}.concept-copy>p{margin:0;color:var(--muted);font-size:.92rem}.test{margin-top:22px;padding-top:18px;border-top:1px solid var(--line)}.test span{color:var(--gold);font:500 .58rem var(--mono);letter-spacing:.1em}.test p{margin:7px 0 0;color:var(--ink-soft);font-size:.82rem}
  .loop-grid{display:grid;grid-template-columns:.72fr 1.28fr;gap:clamp(44px,8vw,110px);align-items:start}.loop{list-style:none;margin:0;padding:6px 24px}.loop li{display:grid;grid-template-columns:42px 1fr;gap:18px;padding:18px 0;border-bottom:1px solid var(--line)}.loop li:last-child{border-bottom:0}.loop li>span{color:var(--green);font:500 .62rem var(--mono)}.loop strong{font-size:.9rem}.loop p{margin:4px 0 0;color:var(--muted);font-size:.81rem}
  .section-head{display:grid;grid-template-columns:.78fr 1.22fr;gap:clamp(44px,8vw,110px);margin-bottom:34px}.section-head .lede{margin:2px 0 14px}.artifact-link{color:var(--ink);font-weight:700;font-size:.82rem}.artifact-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}.artifact-card{min-height:260px;padding:24px;display:flex;flex-direction:column}.artifact-card>span{color:var(--green);font:500 .62rem var(--mono)}.artifact-card h3{margin:auto 0 10px;font-size:1.15rem}.artifact-card p{margin:0;color:var(--muted);font-size:.8rem}
  .fg-grid{display:grid;grid-template-columns:.66fr 1.34fr;gap:clamp(40px,7vw,90px);padding:clamp(30px,5vw,58px);background:radial-gradient(circle at 0 0,rgba(239,186,92,.08),transparent 38%),rgba(8,16,18,.75)}.fg-label{font-size:clamp(2.8rem,7vw,6.2rem);font-weight:750;letter-spacing:-.065em;line-height:.9;margin-top:16px;color:var(--gold)}.fg-grid h2{font-size:clamp(1.7rem,3vw,2.8rem);line-height:1.08;letter-spacing:-.04em;margin:0 0 18px}.fg-grid p{color:var(--muted)}.fg-grid .boundary{font-size:.76rem;margin-top:26px;padding-top:18px;border-top:1px solid var(--line)}
  .rules-grid{display:grid;grid-template-columns:.72fr 1.28fr;gap:clamp(44px,8vw,110px)}.rules{border-top:1px solid var(--line)}.rules article{display:grid;grid-template-columns:42px 1fr;gap:18px;padding:20px 0;border-bottom:1px solid var(--line)}.rules article>span{color:#586561;font:500 .62rem var(--mono)}.rules strong{font-size:.9rem}.rules p{margin:5px 0 0;color:var(--muted);font-size:.82rem}.final{text-align:center}.final .section-title{margin-inline:auto}.final .lede{margin:18px auto 28px}.actions{display:flex;gap:10px;justify-content:center;flex-wrap:wrap}
  @media(max-width:1000px){.artifact-grid{grid-template-columns:1fr 1fr}}
  @media(max-width:900px){.hero-grid,.loop-grid,.fg-grid,.rules-grid,.section-head{grid-template-columns:1fr}.concept{grid-template-columns:42px 1fr}.concept-copy{grid-column:2}.fg-label{font-size:3.8rem}}
  @media(max-width:620px){.concept{grid-template-columns:1fr;padding:24px}.concept-code{display:none}.concept-copy{grid-column:auto}.fg-label{font-size:3rem}.artifact-grid{grid-template-columns:1fr}.artifact-card{min-height:210px}}
</style>
