---
import Layout from '../layouts/Layout.astro';

const auditAxes = [
  { n: '01', title: 'Authority', text: 'Define what the workflow is permitted to change, which object that permission applies to, and where human authorization is required.' },
  { n: '02', title: 'Evidence', text: 'Identify the minimum evidence required before an action is allowed: inputs, approvals, source freshness, tool state and version context.' },
  { n: '03', title: 'Effect', text: 'Verify the external result instead of treating an internal run status or tool response as proof that the intended change actually happened.' },
  { n: '04', title: 'Recovery', text: 'Test what happens when certainty disappears: retry, interruption, partial execution, stale state, duplicate actions and rollback.' }
];

const doctrine = [
  ['Authority Budget', 'Every write permission, integration, autonomous step and retry path expands the authority surface. Capability does not automatically justify permission.'],
  ['Evidence Before Effect', 'Critical effects should depend on evidence available at decision time. Logs after the fact can reconstruct an event; they cannot retroactively justify it.'],
  ['False Green', 'A workflow can look healthy or successful while required evidence is stale, missing, attached to the wrong object or never confirmed externally.']
];

const decisionMoments = [
  ['Before authority expands', 'A workflow is about to gain a new write-capable tool, integration, approval path or external side effect.'],
  ['When evidence lags capability', 'The agent can do more than the team can reliably reconstruct, confirm or explain after the fact.'],
  ['Before a pilot becomes infrastructure', 'A useful workflow is becoming operationally important, but duplicate execution, stale state or ambiguous approval would still be hard to contain.']
];

const deliverables = [
  ['Authority Ledger', 'A bounded map of critical actions, tools, objects, approvals and explicitly prohibited transitions.'],
  ['Evidence Contract', 'The evidence that must exist before, during and after each critical action for the result to be trusted.'],
  ['Finding Record', 'Reproducible findings tied to observed consequence, evidence quality and recovery behavior — with hypotheses kept separate.'],
  ['Decision Memo', 'A bounded owner decision with supporting evidence, residual uncertainty, required control change and retest criterion.']
];

const proofSurfaces = [
  ['/proof', 'Proof Matrix', 'Synthetic worked packs plus an explicit evidence-strength ladder showing what method, build and observed evidence can — and cannot — establish.'],
  ['/build', 'Build + 10/10 Standard', 'The public engineering index and reusable quality contract, with machine gates kept separate from human visual review.'],
  ['/doctrine', 'BitEvo Doctrine', 'Authority Budget, Evidence Before Effect and False Green — the vocabulary behind the audit model.'],
  ['/agent-authority-audit', 'Audit methodology', 'The four-plane model, finding anatomy, failure plan and Rules of Engagement.'],
  ['/guides', 'Reviewed research', 'A curated public set of engineering notes on agent reliability, isolation, drift and tool boundaries.'],
  ['/universe', 'BitEvo Universe', 'A static map of current public projects and proof surfaces — not a live operations dashboard.']
];

const faq = [
  ['What exactly is being audited?', 'A concrete agent workflow with an external effect. The object of the audit is the action chain — not an abstract model score.'],
  ['What is an Authority Budget?', 'A BitEvo concept: consequential capability is treated as a finite permission surface that should expand only when evidence, confirmation and recovery controls justify the expansion.'],
  ['What is a False Green?', 'A BitEvo term for an operational evidence mismatch: the workflow appears healthy or successful while a required source, confirmation or state condition is no longer trustworthy.'],
  ['Is this a penetration test?', 'No. The standard engagement is a bounded engineering review in an agreed staging/test workflow. Production penetration testing is not included by default.'],
  ['Do you certify an agent as safe?', 'No. The result is scoped engineering evidence and owner decisions — not certification, a universal trust score, or a guarantee of security or defect absence.'],
  ['Do you need production secrets?', 'No. Public intake excludes credentials and customer secrets. Access, data boundaries and replay conditions are agreed separately in writing.']
];

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Agent Authority & Evidence Audit',
  provider: { '@type': 'Organization', name: 'BitEvo', url: 'https://bitevoagentsite.vercel.app' },
  serviceType: 'AI agent authority, evidence and failure-control engineering audit',
  areaServed: 'Worldwide',
  url: 'https://bitevoagentsite.vercel.app/agent-authority-audit',
  offers: { '@type': 'Offer', price: '4900', priceCurrency: 'USD', url: 'https://bitevoagentsite.vercel.app/pricing' }
};
---

<Layout title="BitEvo — Authority Engineering for AI Agent Workflows" description="BitEvo audits the authority, evidence, external effects and recovery behavior of write-capable AI-agent workflows.">
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <section class="hero section">
    <div class="container hero-grid">
      <div class="hero-copy reveal">
        <div class="eyebrow">Authority · evidence · effect · recovery</div>
        <h1 class="display">An agent should earn authority with evidence.</h1>
        <p class="lede">BitEvo audits the action layer of AI systems: what a workflow is allowed to change, what evidence must exist before it acts, how the external result is confirmed, and what the system does when certainty disappears.</p>
        <div class="hero-actions">
          <a href="/mapper" class="button button-primary" data-funnel="home-primary">Map one workflow <span aria-hidden="true">↗</span></a>
          <a href="/proof" class="button button-ghost" data-funnel="home-proof">See worked proof</a>
        </div>
        <div class="hero-boundary"><span class="dot"></span> Browser-local mapping first · staging/test by default · written Rules of Engagement before testing</div>
      </div>

      <div class="hero-console panel reveal delay-1" aria-label="Synthetic example authority and evidence chain">
        <div class="console-top"><span>DECISION TRACE / SYNTHETIC LAB-001</span><span class="status"><i></i> SYNTHETIC WORKED CASE</span></div>
        <div class="trace-line"><span class="index">01</span><div><small>INTENT</small><strong>external change proposed</strong></div><span class="state ok">captured</span></div>
        <div class="trace-line"><span class="index">02</span><div><small>AUTHORITY</small><strong>scope + approval matched</strong></div><span class="state ok">bounded</span></div>
        <div class="trace-line"><span class="index">03</span><div><small>EVIDENCE</small><strong>source freshness stopped advancing</strong></div><span class="state warn">insufficient</span></div>
        <div class="trace-line"><span class="index">04</span><div><small>DECISION</small><strong>do not expand authority</strong></div><span class="state warn">constrain</span></div>
        <div class="trace-result"><small>WORKED FINDING CLASS</small><strong>Capability exceeded the evidence available to justify the action.</strong><p>Synthetic worked scenario only. No customer environment, production execution or observed private infrastructure is represented.</p></div>
      </div>
    </div>
  </section>

  <section class="section-tight section-rule" aria-labelledby="start-path-title">
    <div class="container split-head">
      <div><div class="eyebrow">Start with the smallest step</div><h2 class="section-title" id="start-path-title">Map. Challenge. Then scope.</h2></div>
      <p class="lede">You do not need to buy an audit to understand the model. Draft one action chain locally, inspect worked evidence, and only turn the unresolved gates into scope when the decision is worth testing.</p>
    </div>
    <div class="container moment-grid">
      <a class="moment-card panel" href="/mapper" data-funnel="map"><span>01 · LOCAL</span><h3>Map one workflow</h3><p>Draft the Authority Ledger and Evidence Contract in the browser. No testing authorization is created.</p></a>
      <a class="moment-card panel" href="/proof" data-funnel="proof"><span>02 · PROOF</span><h3>Challenge the model</h3><p>Inspect three synthetic worked action classes and see how evidence changes an owner decision.</p></a>
      <a class="moment-card panel" href="/audit-intake" data-funnel="scope"><span>03 · SCOPE</span><h3>Turn gaps into scope</h3><p>When the unresolved gates matter, prepare a bounded scope brief. The public intake still does not authorize testing.</p></a>
    </div>
  </section>

  <section class="signal-strip section-rule" aria-label="Audit principles">
    <div class="container strip-grid">
      <div><small>OBJECT</small><strong>One action-capable workflow</strong></div>
      <div><small>QUESTION</small><strong>What may it do — and why?</strong></div>
      <div><small>TEST</small><strong>10–20 agreed failure scenarios</strong></div>
      <div><small>DECISION</small><strong>Expand · constrain · repair · retest</strong></div>
    </div>
  </section>

  <section class="section doctrine-section">
    <div class="container split-head">
      <div><div class="eyebrow">BitEvo vocabulary</div><h2 class="section-title">Three concepts define the operating philosophy.</h2></div>
      <div><p class="lede">The terminology is intentionally narrow. It describes recurring control problems in action-capable workflows without pretending every problem is a vulnerability or every passing test is a safety guarantee.</p><a href="/doctrine" class="text-link doctrine-link">Read the full doctrine →</a></div>
    </div>
    <div class="container doctrine-grid">
      {doctrine.map(([title, text], i) => (
        <article class="doctrine-card panel"><span>{String(i + 1).padStart(2, '0')}</span><h3>{title}</h3><p>{text}</p></article>
      ))}
    </div>
  </section>

  <section class="section section-rule">
    <div class="container split-head">
      <div><div class="eyebrow">The operating problem</div><h2 class="section-title">Capability grows faster than proof.</h2></div>
      <p class="lede">Every new tool, write permission and autonomous step increases the authority surface. If the evidence chain does not grow with it, the team accumulates authority it cannot reliably justify, reconstruct or contain. BitEvo treats that gap as an engineering problem.</p>
    </div>
    <div class="container moment-grid">
      {decisionMoments.map(([title, text], i) => (
        <article class="moment-card panel"><span>{String(i + 1).padStart(2, '0')}</span><h3>{title}</h3><p>{text}</p></article>
      ))}
    </div>
  </section>

  <section class="section section-rule">
    <div class="container split-head">
      <div><div class="eyebrow">The control loop</div><h2 class="section-title">Permission is only the first gate.</h2></div>
      <p class="lede">A reliable workflow needs four linked answers: was the action authorized, was the evidence sufficient, did the intended external effect occur, and can the system recover when any of those answers becomes uncertain?</p>
    </div>
    <div class="container axis-grid">
      {auditAxes.map(axis => (
        <article class="axis-card"><span class="axis-number">{axis.n}</span><h3>{axis.title}</h3><p>{axis.text}</p></article>
      ))}
    </div>
  </section>

  <section class="section section-rule proof-section">
    <div class="container split-head">
      <div><div class="eyebrow">Proof discipline</div><h2 class="section-title">A finding must change a decision.</h2></div>
      <p class="lede">BitEvo does not sell a generic “AI safety” score. A useful finding connects an observed failure to the authority boundary, the evidence available at decision time, the external effect and the owner action that follows.</p>
    </div>
    <div class="container proof-grid">
      <article class="lab-proof panel">
        <div class="lab-top"><span>LAB-001</span><span>SYNTHETIC · WORKED</span></div>
        <h3>False Green: healthy surface, stale truth.</h3>
        <p>In this worked scenario, a service surface is treated as apparently healthy while source freshness stops advancing. The modeled finding is not “the agent is unsafe.” It is that the workflow could appear operable after the evidence required to justify action had become stale. The modeled owner decision is therefore to constrain the Authority Budget until freshness and confirmation are made explicit.</p>
        <a href="/proof" class="text-link">Inspect evidence strength →</a>
      </article>
      <div class="proof-links">
        {proofSurfaces.map(([href, title, text]) => (
          <a href={href} class="proof-link"><span>{title}</span><p>{text}</p><i aria-hidden="true">↗</i></a>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-rule">
    <div class="container split-head">
      <div><div class="eyebrow">What you receive</div><h2 class="section-title">Not a score. A decision package.</h2></div>
      <p class="lede">The deliverable is designed for an owner who must decide what the workflow may do next. Evidence is preserved at the level needed to reproduce accepted findings and separate facts from assumptions.</p>
    </div>
    <div class="container deliverable-list">
      {deliverables.map(([title, text], i) => (
        <article><span>{String(i + 1).padStart(2, '0')}</span><h3>{title}</h3><p>{text}</p></article>
      ))}
    </div>
  </section>

  <section class="section section-rule">
    <div class="container process-wrap panel">
      <div class="process-intro">
        <div class="eyebrow">5 working days</div>
        <h2 class="section-title">Move from “it works” to “we know why it may act.”</h2>
        <p>No testing begins from a public form alone. Scope, access approval, allowed tests, prohibited actions, data handling and replay conditions are agreed first.</p>
        <a class="button" href="/agent-authority-audit">See the full method →</a>
      </div>
      <ol class="process-list">
        <li><span>Day 0</span><div><strong>Lock the decision boundary</strong><p>Define the workflow, external effects, owners, prohibited transitions, data ceiling and failure plan.</p></div></li>
        <li><span>Days 1–2</span><div><strong>Map authority + evidence</strong><p>Trace what may happen, what evidence justifies it and where confirmation must come from.</p></div></li>
        <li><span>Days 3–4</span><div><strong>Break the assumptions</strong><p>Replay agreed failure paths and separate reproducible findings from noisy symptoms and hypotheses.</p></div></li>
        <li><span>Day 5</span><div><strong>Make the owner decision</strong><p>Deliver the evidence package and a prioritized expand / constrain / repair decision backlog.</p></div></li>
        <li><span>After fix</span><div><strong>Retest the claim</strong><p>Re-run the agreed finding criteria after relevant remediation is available.</p></div></li>
      </ol>
    </div>
  </section>

  <section class="section section-rule">
    <div class="container offer-grid">
      <div class="offer-copy">
        <div class="eyebrow">Primary engagement</div>
        <h2 class="section-title">Agent Authority & Evidence Audit</h2>
        <p class="lede">For teams that need to decide whether one write-capable workflow is ready for more authority — or needs to be constrained first.</p>
        <div class="offer-price"><strong>$4,900</strong><span>fixed · 5 working days</span></div>
        <div class="hero-actions"><a class="button button-primary" href="/mapper">Map the workflow <span aria-hidden="true">↗</span></a><a class="button button-ghost" href="/pricing">Compare decision scopes</a></div>
      </div>
      <div class="scope-card panel">
        <div class="scope-row"><span>Object</span><strong>1 staging/test workflow</strong></div>
        <div class="scope-row"><span>Authority Budget</span><strong>Up to 3 tools / APIs / MCP servers</strong></div>
        <div class="scope-row"><span>Failure plan</span><strong>10–20 agreed scenarios</strong></div>
        <div class="scope-row"><span>Evidence</span><strong>Authority Ledger + Evidence Contract + reproducible Finding Records</strong></div>
        <div class="scope-row"><span>Decision</span><strong>Expand / constrain / repair backlog</strong></div>
        <div class="scope-row"><span>Verification</span><strong>One retest</strong></div>
      </div>
    </div>
  </section>

  <section class="section section-rule">
    <div class="container faq-grid">
      <div class="faq-head"><div class="eyebrow">FAQ</div><h2 class="section-title">The boundary is part of the product.</h2></div>
      <div class="faq-list">
        {faq.map(([q, a]) => <details><summary>{q}<span aria-hidden="true">+</span></summary><p>{a}</p></details>)}
      </div>
    </div>
  </section>

  <div class="mobile-dock" aria-label="Audit quick action"><span><small>PRIMARY AUDIT</small><strong>$4,900 · 5 days</strong></span><a href="/mapper">Map it ↗</a></div>
</Layout>

<style>
  .hero{padding-top:clamp(76px,10vw,136px)}.hero-grid{display:grid;grid-template-columns:minmax(0,1.18fr) minmax(390px,.82fr);gap:clamp(42px,7vw,92px);align-items:center}.hero-copy .display{max-width:820px}.hero-copy .lede{margin:26px 0 0;max-width:720px}.hero-actions{display:flex;gap:11px;flex-wrap:wrap;margin-top:30px}.hero-boundary{margin-top:22px;color:var(--muted);font:500 .72rem/1.5 var(--mono);display:flex;align-items:center;gap:9px}.hero-boundary .dot{width:7px;height:7px;border-radius:50%;background:var(--green);box-shadow:0 0 16px rgba(127,208,177,.45)}
  .hero-console{position:relative;padding:14px;box-shadow:var(--shadow);overflow:hidden}.hero-console::before{content:'';position:absolute;inset:-1px;pointer-events:none;background:linear-gradient(135deg,rgba(127,208,177,.08),transparent 32%,rgba(115,185,216,.05));opacity:.7}.hero-console>*{position:relative}.console-top{display:flex;justify-content:space-between;gap:20px;padding:4px 6px 14px;color:var(--muted);font:500 .65rem/1 var(--mono);letter-spacing:.08em}.status{display:flex;align-items:center;gap:6px}.status i{width:6px;height:6px;background:var(--gold);border-radius:50%}.trace-line{display:grid;grid-template-columns:28px 1fr auto;gap:12px;align-items:center;padding:15px 6px;border-top:1px solid var(--line)}.trace-line .index{color:#51605d;font:500 .65rem var(--mono)}.trace-line div{display:flex;flex-direction:column;gap:3px}.trace-line small,.trace-result small{color:var(--muted);font:500 .58rem var(--mono);letter-spacing:.12em}.trace-line strong{font-size:.82rem;font-weight:650}.state{font:500 .62rem var(--mono);padding:4px 7px;border-radius:999px;border:1px solid var(--line)}.state.ok{color:var(--green)}.state.warn{color:var(--high)}.trace-result{margin-top:4px;padding:18px;border-radius:13px;background:rgba(255,255,255,.025);border:1px solid var(--line)}.trace-result strong{display:block;margin:7px 0;font-size:.92rem}.trace-result p{margin:0;color:var(--muted);font-size:.75rem}
  .signal-strip{padding:0}.strip-grid{display:grid;grid-template-columns:repeat(4,1fr)}.strip-grid div{padding:22px 18px;border-left:1px solid var(--line)}.strip-grid div:last-child{border-right:1px solid var(--line)}.strip-grid small{display:block;color:#64716e;font:500 .58rem var(--mono);letter-spacing:.12em;margin-bottom:5px}.strip-grid strong{font-size:.79rem;font-weight:650;color:var(--ink-soft)}
  .split-head{display:grid;grid-template-columns:.9fr 1.1fr;gap:clamp(40px,8vw,110px);align-items:start;margin-bottom:44px}.split-head .lede{margin:3px 0 0}.doctrine-link{display:inline-block;margin-top:16px}.doctrine-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.doctrine-card{min-height:300px;padding:26px;display:flex;flex-direction:column;background:radial-gradient(circle at 100% 0,rgba(127,208,177,.055),transparent 42%),rgba(8,16,18,.5)}.doctrine-card>span{color:var(--green);font:500 .64rem var(--mono)}.doctrine-card h3{margin:auto 0 12px;font-size:clamp(1.3rem,2.3vw,1.85rem);letter-spacing:-.035em}.doctrine-card p{margin:0;color:var(--muted);font-size:.84rem}
  .moment-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.moment-card{min-height:250px;padding:25px;display:flex;flex-direction:column;transition:transform .22s ease,border-color .22s ease,background .22s ease}.moment-card:hover{transform:translateY(-4px);border-color:rgba(127,208,177,.28);background:linear-gradient(180deg,rgba(14,27,29,.95),rgba(8,16,18,.92))}.moment-card>span{color:#596763;font:500 .64rem var(--mono)}.moment-card h3{margin:auto 0 10px;font-size:1.18rem;letter-spacing:-.02em}.moment-card p{margin:0;color:var(--muted);font-size:.84rem}
  .axis-grid{display:grid;grid-template-columns:repeat(4,1fr);border:1px solid var(--line);border-radius:var(--radius);overflow:hidden}.axis-card{min-height:270px;padding:26px;display:flex;flex-direction:column;border-right:1px solid var(--line);background:rgba(8,16,18,.5);transition:background .2s ease}.axis-card:hover{background:rgba(14,27,29,.78)}.axis-card:last-child{border-right:0}.axis-number{color:#53615e;font:500 .66rem var(--mono)}.axis-card h3{margin:auto 0 10px;font-size:1.2rem}.axis-card p{margin:0;color:var(--muted);font-size:.86rem;line-height:1.7}
  .proof-grid{display:grid;grid-template-columns:1.05fr .95fr;gap:18px}.lab-proof{padding:clamp(26px,4vw,44px);min-height:390px;display:flex;flex-direction:column;background:radial-gradient(circle at 100% 0,rgba(127,208,177,.08),transparent 45%),linear-gradient(180deg,rgba(14,27,29,.84),rgba(8,16,18,.9))}.lab-top{display:flex;justify-content:space-between;gap:15px;color:var(--green);font:500 .62rem var(--mono);letter-spacing:.1em}.lab-top span:last-child{color:var(--muted)}.lab-proof h3{margin:auto 0 16px;font-size:clamp(1.8rem,3.6vw,3.2rem);line-height:1.02;letter-spacing:-.045em}.lab-proof p{margin:0 0 24px;color:var(--muted);max-width:650px}.text-link{font-size:.82rem;font-weight:700;color:var(--ink)}.proof-links{display:grid;border-top:1px solid var(--line)}.proof-link{position:relative;padding:20px 42px 20px 4px;border-bottom:1px solid var(--line);transition:padding-left .18s ease}.proof-link:hover{padding-left:12px}.proof-link>span{font-weight:700;font-size:.94rem}.proof-link p{margin:4px 0 0;color:var(--muted);font-size:.78rem;max-width:530px}.proof-link i{position:absolute;right:4px;top:22px;color:var(--green);font-style:normal}
  .deliverable-list{border-top:1px solid var(--line)}.deliverable-list article{display:grid;grid-template-columns:70px .75fr 1.25fr;gap:28px;align-items:start;padding:24px 4px;border-bottom:1px solid var(--line)}.deliverable-list article>span{color:#53615e;font:500 .65rem var(--mono)}.deliverable-list h3{margin:0;font-size:1rem}.deliverable-list p{margin:0;color:var(--muted);max-width:620px}
  .process-wrap{display:grid;grid-template-columns:.8fr 1.2fr;gap:clamp(40px,7vw,90px);padding:clamp(28px,5vw,58px)}.process-intro p{color:var(--muted);max-width:480px;margin:20px 0 26px}.process-list{list-style:none;margin:0;padding:0}.process-list li{display:grid;grid-template-columns:84px 1fr;gap:22px;padding:17px 0;border-bottom:1px solid var(--line)}.process-list li:first-child{padding-top:0}.process-list li:last-child{border-bottom:0;padding-bottom:0}.process-list li>span{color:var(--green);font:500 .66rem var(--mono)}.process-list strong{font-size:.9rem}.process-list p{margin:4px 0 0;color:var(--muted);font-size:.8rem}
  .offer-grid{display:grid;grid-template-columns:1fr .9fr;gap:clamp(42px,8vw,110px);align-items:center}.offer-copy .lede{margin:18px 0}.offer-price{display:flex;align-items:baseline;gap:13px;margin-top:30px}.offer-price strong{font-size:clamp(2.4rem,5vw,4.4rem);line-height:1;letter-spacing:-.05em}.offer-price span{color:var(--muted);font:500 .7rem var(--mono)}.scope-card{padding:8px 24px}.scope-row{display:flex;justify-content:space-between;gap:24px;padding:17px 2px;border-bottom:1px solid var(--line)}.scope-row:last-child{border-bottom:0}.scope-row span{color:var(--muted);font:500 .65rem var(--mono)}.scope-row strong{font-size:.78rem;text-align:right}
  .faq-grid{display:grid;grid-template-columns:.72fr 1.28fr;gap:clamp(42px,8vw,120px)}.faq-list details{border-top:1px solid var(--line)}.faq-list details:last-child{border-bottom:1px solid var(--line)}.faq-list summary{list-style:none;cursor:pointer;display:flex;justify-content:space-between;gap:24px;padding:20px 0;font-weight:650}.faq-list summary::-webkit-details-marker{display:none}.faq-list summary span{color:var(--green);font-size:1.2rem;transition:transform .18s ease}.faq-list details[open] summary span{transform:rotate(45deg)}.faq-list p{max-width:700px;margin:0 0 22px;color:var(--muted);font-size:.88rem}
