---
import Layout from '../layouts/Layout.astro';

const auditAxes = [
  { n: '01', title: 'Authority', text: 'Map what the agent may call, write, send, approve or mutate — and where human authorization begins.' },
  { n: '02', title: 'Evidence', text: 'Reconstruct decisions from inputs, approvals, source freshness, tool responses and observed external effects.' },
  { n: '03', title: 'Failure controls', text: 'Replay agreed failure scenarios and verify that missing evidence, retries and ambiguity fail closed instead of drifting.' },
  { n: '04', title: 'Recovery', text: 'Check interruption, duplicate execution, state drift and whether the workflow can return to a known safe state.' }
];

const decisionMoments = [
  ['Before authority expands', 'A workflow is about to gain a new write-capable tool, integration, approval path or external side effect.'],
  ['After a false green', 'The run says “success”, but logs, source freshness, retries or the external system leave room for a different story.'],
  ['Before a fragile workflow scales', 'A pilot works, but the team cannot yet reconstruct who authorized what, which evidence was fresh, or how duplicate execution is contained.']
];

const deliverables = [
  ['Authority map', 'A bounded map of critical actions, tools, approvals and prohibited transitions.'],
  ['Evidence pack', 'Reproducible traces for each accepted finding — not screenshots without provenance.'],
  ['Repair backlog', 'Prioritized remediation tied to the observed failure mode and business consequence.'],
  ['One retest', 'Verification against the same agreed finding criteria after relevant remediation is available.']
];

const proofSurfaces = [
  ['/agent-authority-audit', 'Audit methodology', 'Scope, evidence planes, failure plan and Rules of Engagement.'],
  ['/guides', 'Reviewed research', 'A curated public set of engineering notes rather than an unbounded content archive.'],
  ['/continuityos', 'ContinuityOS', 'Public source project exploring durable local memory and governance-oriented workflows.'],
  ['/universe', 'BitEvo Universe', 'A static public map of current projects and proof surfaces — not a live operations dashboard.']
];

const faq = [
  ['Is this a penetration test?', 'No. The standard audit is a bounded engineering review in an agreed staging/test workflow. Production penetration testing is not included by default.'],
  ['Do you certify an agent as safe?', 'No. The output is evidence and engineering findings within the tested scope — not certification or a guarantee of security or defect absence.'],
  ['Do you need production secrets?', 'No. Public intake explicitly excludes credentials and customer secrets. Access, data boundaries and replay conditions are agreed separately in writing.'],
  ['What makes a workflow a good fit?', 'A workflow with a concrete external effect — for example a CRM write, message, code change, record update or other action whose authority and evidence chain can be tested.']
];

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Agent Authority & Evidence Audit',
  provider: { '@type': 'Organization', name: 'BitEvo', url: 'https://bitevoagentsite.vercel.app' },
  serviceType: 'AI agent authority, evidence and failure-control engineering audit',
  areaServed: 'Worldwide',
  url: 'https://bitevoagentsite.vercel.app/agent-authority-audit',
  offers: { '@type': 'Offer', price: '4900', priceCurrency: 'USD', url: 'https://bitevoagentsite.vercel.app/pricing' }
};
---

<Layout title="BitEvo — Authority & Evidence Engineering for AI Agents" description="BitEvo audits AI-agent authority, evidence chains, failure controls and operational traceability in bounded staging workflows.">
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <section class="hero section">
    <div class="container hero-grid">
      <div class="hero-copy reveal">
        <div class="eyebrow">Authority · evidence · failure control</div>
        <h1 class="display">AI agents should not get more authority than evidence.</h1>
        <p class="lede">BitEvo reviews write-capable agent workflows before ambiguity becomes an incident: what the agent was allowed to do, what it actually did, what proves the result, and how the system behaves when evidence is missing.</p>
        <div class="hero-actions">
          <a href="/agent-authority-audit" class="button button-primary">Explore the audit <span aria-hidden="true">↗</span></a>
          <a href="/audit-intake" class="button button-ghost">Scope a workflow</a>
        </div>
        <div class="hero-boundary"><span class="dot"></span> Staging/test by default · written Rules of Engagement · no safety guarantee</div>
      </div>

      <div class="hero-console panel reveal delay-1" aria-label="Example evidence chain">
        <div class="console-top"><span>TRACE / LAB-001</span><span class="status"><i></i> REDACTED LAB CASE</span></div>
        <div class="trace-line"><span class="index">01</span><div><small>REQUEST</small><strong>critical action proposed</strong></div><span class="state ok">captured</span></div>
        <div class="trace-line"><span class="index">02</span><div><small>AUTHORITY</small><strong>scope + approval checked</strong></div><span class="state ok">bounded</span></div>
        <div class="trace-line"><span class="index">03</span><div><small>SOURCE</small><strong>freshness stopped advancing</strong></div><span class="state warn">stale</span></div>
        <div class="trace-line"><span class="index">04</span><div><small>SERVICE</small><strong>surface still appeared healthy</strong></div><span class="state warn">false green</span></div>
        <div class="trace-result"><small>FINDING CLASS</small><strong>Evidence state diverged from apparent service health.</strong><p>Public internal-lab example only. No customer environment or private infrastructure is represented.</p></div>
      </div>
    </div>
  </section>

  <section class="signal-strip section-rule" aria-label="Audit principles">
    <div class="container strip-grid">
      <div><small>MODE</small><strong>Bounded engineering audit</strong></div>
      <div><small>PRIMARY SCOPE</small><strong>1 staging workflow</strong></div>
      <div><small>FAILURE PLAN</small><strong>10–20 agreed scenarios</strong></div>
      <div><small>OUTPUT</small><strong>Reproducible evidence</strong></div>
    </div>
  </section>

  <section class="section">
    <div class="container split-head">
      <div><div class="eyebrow">Decision moments</div><h2 class="section-title">Audit before ambiguity becomes operating policy.</h2></div>
      <p class="lede">The best time to review authority is not after a major incident. It is when the workflow is about to become more capable, more connected or harder to reconstruct.</p>
    </div>
    <div class="container moment-grid">
      {decisionMoments.map(([title, text], i) => (
        <article class="moment-card panel">
          <span>{String(i + 1).padStart(2, '0')}</span>
          <h3>{title}</h3>
          <p>{text}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section section-rule">
    <div class="container split-head">
      <div><div class="eyebrow">The problem</div><h2 class="section-title">“The run succeeded” is not enough.</h2></div>
      <p class="lede">Agent systems cross boundaries that ordinary chat interfaces do not. They write to external systems, retry operations, inherit credentials and make decisions from changing sources. The audit focuses on the gap between apparent success and provable execution.</p>
    </div>
    <div class="container axis-grid">
      {auditAxes.map(axis => (
        <article class="axis-card">
          <span class="axis-number">{axis.n}</span>
          <h3>{axis.title}</h3>
          <p>{axis.text}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section section-rule proof-section">
    <div class="container split-head">
      <div><div class="eyebrow">Proof without theatre</div><h2 class="section-title">Show the method. Label the boundary.</h2></div>
      <p class="lede">The public site does not turn internal lab work into fake customer proof. What is public is separated into reviewed methodology, reviewed research, source projects and explicitly redacted lab evidence.</p>
    </div>
    <div class="container proof-grid">
      <article class="lab-proof panel">
        <div class="lab-top"><span>LAB-001</span><span>INTERNAL · REDACTED</span></div>
        <h3>Healthy service, stale truth.</h3>
        <p>A service surface appeared healthy while source freshness had stopped advancing. The useful finding is not “the agent is unsafe”; it is the narrower reproducible class: apparent service health diverged from the evidence state required to trust the workflow.</p>
        <a href="/agent-authority-audit#method" class="text-link">Inspect the methodology →</a>
      </article>
      <div class="proof-links">
        {proofSurfaces.map(([href, title, text]) => (
          <a href={href} class="proof-link">
            <span>{title}</span><p>{text}</p><i aria-hidden="true">↗</i>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-rule">
    <div class="container split-head">
      <div><div class="eyebrow">What you receive</div><h2 class="section-title">Evidence that can survive a second look.</h2></div>
      <p class="lede">Every deliverable is tied to the agreed workflow and failure plan. The goal is not a broad “trust score”; it is a compact body of evidence that engineering and product owners can inspect, reproduce and use to decide what to repair.</p>
    </div>
    <div class="container deliverable-list">
      {deliverables.map(([title, text], i) => (
        <article><span>{String(i + 1).padStart(2, '0')}</span><h3>{title}</h3><p>{text}</p></article>
      ))}
    </div>
  </section>

  <section class="section section-rule">
    <div class="container process-wrap panel">
      <div class="process-intro">
        <div class="eyebrow">5 working days</div>
        <h2 class="section-title">A short audit with hard boundaries.</h2>
        <p>No testing begins from a public form alone. Scope, access approval, allowed tests, prohibited actions, data handling and replay conditions are agreed first.</p>
        <a class="button" href="/agent-authority-audit">See full scope →</a>
      </div>
      <ol class="process-list">
        <li><span>Day 0</span><div><strong>Scope & Rules of Engagement</strong><p>Lock the workflow, authority boundaries, data ceiling and failure scenarios.</p></div></li>
        <li><span>Days 1–2</span><div><strong>Map & reproduce</strong><p>Build the action/evidence map and replay agreed failure paths in staging/test.</p></div></li>
        <li><span>Days 3–4</span><div><strong>Verify findings</strong><p>Separate reproducible defects from assumptions, noisy symptoms and unproven hypotheses.</p></div></li>
        <li><span>Day 5</span><div><strong>Evidence & repair decisions</strong><p>Deliver executive readout, evidence pack and prioritized backlog.</p></div></li>
        <li><span>After fix</span><div><strong>One retest</strong><p>Re-run the agreed finding criteria when remediation is ready.</p></div></li>
      </ol>
    </div>
  </section>

  <section class="section section-rule">
    <div class="container offer-grid">
      <div class="offer-copy">
        <div class="eyebrow">Primary engagement</div>
        <h2 class="section-title">Agent Authority & Evidence Audit</h2>
        <p class="lede">For teams operating an agent workflow that can create a real external effect and need a bounded, inspectable answer before expanding authority.</p>
        <div class="offer-price"><strong>$4,900</strong><span>fixed · 5 working days</span></div>
        <div class="hero-actions"><a class="button button-primary" href="/audit-intake">Open audit intake <span aria-hidden="true">↗</span></a><a class="button button-ghost" href="/pricing">Compare scopes</a></div>
      </div>
      <div class="scope-card panel">
        <div class="scope-row"><span>Workflow</span><strong>1 staging/test workflow</strong></div>
        <div class="scope-row"><span>Integrations</span><strong>Up to 3 tools / APIs / MCP servers</strong></div>
        <div class="scope-row"><span>Failure plan</span><strong>10–20 agreed scenarios</strong></div>
        <div class="scope-row"><span>Evidence</span><strong>Executive report + reproducible pack</strong></div>
        <div class="scope-row"><span>Repair</span><strong>Prioritized backlog</strong></div>
        <div class="scope-row"><span>Verification</span><strong>One retest</strong></div>
      </div>
    </div>
  </section>

  <section class="section section-rule">
    <div class="container faq-grid">
      <div class="faq-head"><div class="eyebrow">FAQ</div><h2 class="section-title">Clear boundaries before access.</h2></div>
      <div class="faq-list">
        {faq.map(([q, a]) => <details><summary>{q}<span aria-hidden="true">+</span></summary><p>{a}</p></details>)}
      </div>
    </div>
  </section>

  <div class="mobile-dock" aria-label="Audit quick action"><span><small>PRIMARY AUDIT</small><strong>$4,900 · 5 days</strong></span><a href="/audit-intake">Scope it ↗</a></div>
</Layout>

<style>
  .hero{padding-top:clamp(76px,10vw,136px)}.hero-grid{display:grid;grid-template-columns:minmax(0,1.18fr) minmax(390px,.82fr);gap:clamp(42px,7vw,92px);align-items:center}.hero-copy .display{max-width:820px}.hero-copy .lede{margin:26px 0 0;max-width:720px}.hero-actions{display:flex;gap:11px;flex-wrap:wrap;margin-top:30px}.hero-boundary{margin-top:22px;color:var(--muted);font:500 .72rem/1.5 var(--mono);display:flex;align-items:center;gap:9px}.hero-boundary .dot{width:7px;height:7px;border-radius:50%;background:var(--green);box-shadow:0 0 16px rgba(127,208,177,.45)}
  .hero-console{position:relative;padding:14px;box-shadow:var(--shadow);overflow:hidden}.hero-console::before{content:'';position:absolute;inset:-1px;pointer-events:none;background:linear-gradient(135deg,rgba(127,208,177,.08),transparent 32%,rgba(115,185,216,.05));opacity:.7}.hero-console>*{position:relative}.console-top{display:flex;justify-content:space-between;gap:20px;padding:4px 6px 14px;color:var(--muted);font:500 .65rem/1 var(--mono);letter-spacing:.08em}.status{display:flex;align-items:center;gap:6px}.status i{width:6px;height:6px;background:var(--gold);border-radius:50%}.trace-line{display:grid;grid-template-columns:28px 1fr auto;gap:12px;align-items:center;padding:15px 6px;border-top:1px solid var(--line)}.trace-line .index{color:#51605d;font:500 .65rem var(--mono)}.trace-line div{display:flex;flex-direction:column;gap:3px}.trace-line small,.trace-result small{color:var(--muted);font:500 .58rem var(--mono);letter-spacing:.12em}.trace-line strong{font-size:.82rem;font-weight:650}.state{font:500 .62rem var(--mono);padding:4px 7px;border-radius:999px;border:1px solid var(--line)}.state.ok{color:var(--green)}.state.warn{color:var(--high)}.trace-result{margin-top:4px;padding:18px;border-radius:13px;background:rgba(255,255,255,.025);border:1px solid var(--line)}.trace-result strong{display:block;margin:7px 0;font-size:.92rem}.trace-result p{margin:0;color:var(--muted);font-size:.75rem}
  .signal-strip{padding:0}.strip-grid{display:grid;grid-template-columns:repeat(4,1fr)}.strip-grid div{padding:22px 18px;border-left:1px solid var(--line)}.strip-grid div:last-child{border-right:1px solid var(--line)}.strip-grid small{display:block;color:#64716e;font:500 .58rem var(--mono);letter-spacing:.12em;margin-bottom:5px}.strip-grid strong{font-size:.79rem;font-weight:650;color:var(--ink-soft)}
  .split-head{display:grid;grid-template-columns:.9fr 1.1fr;gap:clamp(40px,8vw,110px);align-items:start;margin-bottom:44px}.split-head .lede{margin:3px 0 0}
  .moment-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.moment-card{min-height:250px;padding:25px;display:flex;flex-direction:column;transition:transform .22s ease,border-color .22s ease,background .22s ease}.moment-card:hover{transform:translateY(-4px);border-color:rgba(127,208,177,.28);background:linear-gradient(180deg,rgba(14,27,29,.95),rgba(8,16,18,.92))}.moment-card>span{color:#596763;font:500 .64rem var(--mono)}.moment-card h3{margin:auto 0 10px;font-size:1.18rem;letter-spacing:-.02em}.moment-card p{margin:0;color:var(--muted);font-size:.84rem}
  .axis-grid{display:grid;grid-template-columns:repeat(4,1fr);border:1px solid var(--line);border-radius:var(--radius);overflow:hidden}.axis-card{min-height:270px;padding:26px;display:flex;flex-direction:column;border-right:1px solid var(--line);background:rgba(8,16,18,.5);transition:background .2s ease}.axis-card:hover{background:rgba(14,27,29,.78)}.axis-card:last-child{border-right:0}.axis-number{color:#53615e;font:500 .66rem var(--mono)}.axis-card h3{margin:auto 0 10px;font-size:1.2rem}.axis-card p{margin:0;color:var(--muted);font-size:.86rem;line-height:1.7}
  .proof-grid{display:grid;grid-template-columns:1.05fr .95fr;gap:18px}.lab-proof{padding:clamp(26px,4vw,44px);min-height:390px;display:flex;flex-direction:column;background:radial-gradient(circle at 100% 0,rgba(127,208,177,.08),transparent 45%),linear-gradient(180deg,rgba(14,27,29,.84),rgba(8,16,18,.9))}.lab-top{display:flex;justify-content:space-between;gap:15px;color:var(--green);font:500 .62rem var(--mono);letter-spacing:.1em}.lab-top span:last-child{color:var(--muted)}.lab-proof h3{margin:auto 0 16px;font-size:clamp(1.8rem,3.6vw,3.2rem);line-height:1.02;letter-spacing:-.045em}.lab-proof p{margin:0 0 24px;color:var(--muted);max-width:650px}.text-link{font-size:.82rem;font-weight:700;color:var(--ink)}.proof-links{display:grid;border-top:1px solid var(--line)}.proof-link{position:relative;padding:20px 42px 20px 4px;border-bottom:1px solid var(--line);transition:padding-left .18s ease}.proof-link:hover{padding-left:12px}.proof-link>span{font-weight:700;font-size:.94rem}.proof-link p{margin:4px 0 0;color:var(--muted);font-size:.78rem;max-width:530px}.proof-link i{position:absolute;right:4px;top:22px;color:var(--green);font-style:normal}
  .deliverable-list{border-top:1px solid var(--line)}.deliverable-list article{display:grid;grid-template-columns:70px .75fr 1.25fr;gap:28px;align-items:start;padding:24px 4px;border-bottom:1px solid var(--line)}.deliverable-list article>span{color:#53615e;font:500 .65rem var(--mono)}.deliverable-list h3{margin:0;font-size:1rem}.deliverable-list p{margin:0;color:var(--muted);max-width:620px}
  .process-wrap{display:grid;grid-template-columns:.8fr 1.2fr;gap:clamp(40px,7vw,90px);padding:clamp(28px,5vw,58px)}.process-intro p{color:var(--muted);max-width:480px;margin:20px 0 26px}.process-list{list-style:none;margin:0;padding:0}.process-list li{display:grid;grid-template-columns:84px 1fr;gap:22px;padding:17px 0;border-bottom:1px solid var(--line)}.process-list li:first-child{padding-top:0}.process-list li:last-child{border-bottom:0;padding-bottom:0}.process-list li>span{color:var(--green);font:500 .66rem var(--mono)}.process-list strong{font-size:.9rem}.process-list p{margin:4px 0 0;color:var(--muted);font-size:.8rem}
  .offer-grid{display:grid;grid-template-columns:1fr .9fr;gap:clamp(42px,8vw,110px);align-items:center}.offer-copy .lede{margin:18px 0}.offer-price{display:flex;align-items:baseline;gap:13px;margin-top:30px}.offer-price strong{font-size:clamp(2.4rem,5vw,4.4rem);line-height:1;letter-spacing:-.05em}.offer-price span{color:var(--muted);font:500 .7rem var(--mono)}.scope-card{padding:8px 24px}.scope-row{display:flex;justify-content:space-between;gap:24px;padding:17px 2px;border-bottom:1px solid var(--line)}.scope-row:last-child{border-bottom:0}.scope-row span{color:var(--muted);font:500 .65rem var(--mono)}.scope-row strong{font-size:.78rem;text-align:right}
  .faq-grid{display:grid;grid-template-columns:.72fr 1.28fr;gap:clamp(42px,8vw,120px)}.faq-list details{border-top:1px solid var(--line)}.faq-list details:last-child{border-bottom:1px solid var(--line)}.faq-list summary{list-style:none;cursor:pointer;display:flex;justify-content:space-between;gap:24px;padding:20px 0;font-weight:650}.faq-list summary::-webkit-details-marker{display:none}.faq-list summary span{color:var(--green);font-size:1.2rem;transition:transform .18s ease}.faq-list details[open] summary span{transform:rotate(45deg)}.faq-list p{max-width:700px;margin:0 0 22px;color:var(--muted);font-size:.88rem}
  .mobile-dock{display:none}.reveal{animation:rise .65s cubic-bezier(.2,.7,.2,1) both}.delay-1{animation-delay:.08s}@keyframes rise{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:none}}
  @media(max-width:980px){.hero-grid,.offer-grid,.proof-grid{grid-template-columns:1fr}.hero-console{max-width:700px}.axis-grid{grid-template-columns:1fr 1fr}.axis-card:nth-child(2){border-right:0}.axis-card:nth-child(-n+2){border-bottom:1px solid var(--line)}.process-wrap{grid-template-columns:1fr}.faq-grid{grid-template-columns:1fr;gap:30px}.moment-grid{grid-template-columns:1fr 1fr}.moment-card:last-child{grid-column:1/-1}}
  @media(max-width:720px){.strip-grid{grid-template-columns:1fr 1fr}.strip-grid div{border-bottom:1px solid var(--line)}.split-head{grid-template-columns:1fr;gap:24px}.moment-grid{grid-template-columns:1fr}.moment-card,.moment-card:last-child{grid-column:auto;min-height:200px}.axis-grid{grid-template-columns:1fr}.axis-card,.axis-card:nth-child(2){border-right:0;border-bottom:1px solid var(--line);min-height:210px}.axis-card:last-child{border-bottom:0}.deliverable-list article{grid-template-columns:38px 1fr;gap:10px 16px}.deliverable-list p{grid-column:2}.process-list li{grid-template-columns:68px 1fr}.scope-row{flex-direction:column;gap:5px}.scope-row strong{text-align:left}.mobile-dock{position:fixed;z-index:90;left:12px;right:12px;bottom:12px;display:flex;align-items:center;justify-content:space-between;gap:14px;padding:10px 11px 10px 14px;border:1px solid var(--line-strong);border-radius:18px;background:rgba(8,16,18,.94);backdrop-filter:blur(18px);box-shadow:0 18px 50px rgba(0,0,0,.42)}.mobile-dock span{display:flex;flex-direction:column}.mobile-dock small{color:var(--muted);font:500 .54rem var(--mono);letter-spacing:.11em}.mobile-dock strong{font-size:.75rem}.mobile-dock a{padding:9px 12px;border-radius:999px;background:var(--ink);color:#071012;font-size:.72rem;font-weight:800;white-space:nowrap}}
  @media(max-width:430px){.mobile-dock span{display:none}.mobile-dock a{width:100%;text-align:center}}
  @media(prefers-reduced-motion:reduce){.reveal{animation:none}.moment-card,.proof-link{transition:none}}
</style>