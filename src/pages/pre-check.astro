---
import Layout from '../layouts/Layout.astro';
import ScopeHandoffShort from '../components/ScopeHandoffShort.astro';

const TRIAGE_URL = 'https://cal.com/robert-dumanyan-vlck0x/free-20-minute-triage';
---

<Layout
  title="Authority Pre-Check — map agent authority before testing | BitEvo"
  description="Paste an AI-agent tool list, MCP manifest or description to map stated actions, authority unknowns and three testable hypotheses before audit scoping."
  robots="noindex, follow"
  canonical="/pre-check"
>
  <main data-precheck-root>
    <section class="section precheck-hero">
      <div class="container precheck-hero-grid">
        <div>
          <div class="eyebrow">Authority Pre-Check</div>
          <h1 class="display">Map your agent's authority before you test it.</h1>
          <p class="lede">Paste a tool list, an MCP server manifest or a plain description. You get an authority map, three testable hypotheses and the evidence each one needs.</p>
          <p class="precheck-boundary">Automated draft — not an audit finding.</p>
        </div>
        <aside class="panel precheck-sample" aria-label="Synthetic example">
          <div class="eyebrow">Example result · SAMPLE</div>
          <p class="copy">Synthetic support-agent input used only to show the output shape.</p>
          <div class="precheck-sample-grid">
            <div class="precheck-sample-row"><span>Action</span><strong>issue_refund</strong></div>
            <div class="precheck-sample-row"><span>Effect</span><strong>money</strong></div>
            <div class="precheck-sample-row"><span>Object</span><strong>unknown</strong></div>
            <div class="precheck-sample-row"><span>Owner</span><strong>unknown</strong></div>
          </div>
        </aside>
      </div>
    </section>

    <section class="section-tight section-rule">
      <div class="narrow">
        <div class="eyebrow">Choose a mode</div>
        <div class="precheck-result-actions" aria-label="Pre-Check mode">
          <button class="button button-primary" type="button" data-precheck-mode="authority" aria-pressed="true">Authority map</button>
          <button class="button button-ghost" type="button" data-precheck-mode="config" aria-pressed="false">Instruction / config scan</button>
        </div>
        <p class="lede">The instruction/config mode scans pasted text only in this browser. It does not call the Pre-Check API or a model.</p>
      </div>
    </section>

    <section class="section section-rule" data-precheck-authority-form-panel>
      <div class="narrow">
        <form class="panel precheck-form-panel" method="post" data-precheck-form>
          <label for="precheckInput">Tools, manifest or description (no secrets)</label>
          <textarea
            id="precheckInput"
            class="precheck-input"
            data-precheck-input
            maxlength="8000"
            required
            spellcheck="false"
            autocomplete="off"
            placeholder="Example: support agent with tool issue_refund; the action may only target the current staging ticket..."
          ></textarea>
          <div class="precheck-input-meta">
            <span>Up to 8,000 characters. Keys, tokens and credentials are rejected.</span>
            <span data-precheck-count>0 / 8,000</span>
          </div>
          <div class="precheck-form-actions">
            <button class="button button-primary" type="submit" data-precheck-run data-js-local-submit disabled>Run pre-check</button>
          </div>
          <p class="precheck-status" role="status" data-js-local-fallback>JavaScript is required to run Pre-Check. Submit is disabled; no input was sent.</p>
          <p class="precheck-status" data-precheck-status role="status" aria-live="polite" aria-atomic="true"></p>
        </form>
      </div>
    </section>

    <section class="section section-rule" data-config-scan-form-panel hidden>
      <div class="narrow">
        <form class="panel precheck-form-panel" method="post" data-config-scan-form>
          <label for="configScanInput">SKILL.md, CLAUDE.md, .cursorrules or mcp.json</label>
          <textarea
            id="configScanInput"
            class="precheck-input"
            data-config-scan-input
            required
            spellcheck="false"
            autocomplete="off"
            placeholder="Paste instruction or configuration text here..."
          ></textarea>
          <div class="precheck-input-meta">
            <span>Local static pattern scan. Nothing is sent and no model is called.</span>
            <span data-config-scan-count>0 characters</span>
          </div>
          <div class="precheck-form-actions">
            <button class="button button-primary" type="submit" data-js-local-submit disabled>Scan locally</button>
            <button class="button button-ghost" type="reset">Reset</button>
          </div>
          <p class="precheck-status" role="status" data-js-local-fallback>JavaScript is required for the local config scan. Submit is disabled; input was not sent.</p>
          <p class="precheck-status" data-config-scan-status role="status" aria-live="polite" aria-atomic="true"></p>
        </form>
      </div>
    </section>

    <section class="section section-rule precheck-result" data-precheck-authority-result-panel data-precheck-result hidden>
      <div class="container">
        <div class="precheck-result-head">
          <div>
            <div class="eyebrow">Automated draft</div>
            <h2 class="section-title">Authority map and testable hypotheses</h2>
            <p>Generated from the text you pasted. Not a finding, not a safety verdict, and not testing authorization.</p>
          </div>
        </div>

        <div class="precheck-columns">
          <section class="panel precheck-block precheck-block-wide">
            <h2>Authority map</h2>
            <div class="precheck-cards" data-precheck-actions></div>
          </section>

          <section class="panel precheck-block">
            <h2>Testable hypotheses</h2>
            <div class="precheck-cards" data-precheck-hypotheses></div>
          </section>

          <section class="panel precheck-block">
            <h2>Unknowns</h2>
            <ul class="precheck-unknowns" data-precheck-unknowns></ul>
          </section>

          <section class="panel precheck-block precheck-block-wide">
            <h2>Suggested next step</h2>
            <div class="precheck-next">
              <strong data-precheck-next-name></strong>
              <p data-precheck-next-why></p>
            </div>
            <div class="precheck-result-actions">
              <button class="button button-primary" type="button" data-precheck-send>Send to Robert</button>
              <a class="button button-ghost" href="/sample-audit">See sample report</a>
              <a class="button button-ghost" href={TRIAGE_URL} target="_blank" rel="noopener noreferrer">Book a free triage</a>
              <button class="button button-ghost" type="button" data-precheck-copy>Copy result</button>
            </div>
            <p class="precheck-note">“Send to Robert” places only a bounded JSON summary of the generated result into the existing Scope Handoff form. The text you pasted is not copied there, and the form still requires explicit consent before submission.</p>
          </section>
        </div>
      </div>
    </section>

    <section class="section section-rule precheck-result" data-config-scan-result-panel hidden>
      <div class="container">
        <div class="precheck-result-head">
          <div>
            <div class="eyebrow">Local static scan</div>
            <h2 class="section-title">Instruction and config warnings</h2>
            <p>Pattern matches are review signals only. They are not audit findings, a safety verdict or testing authorization.</p>
          </div>
          <strong data-config-scan-result-count>0 local warnings</strong>
        </div>
        <div class="precheck-columns">
          <section class="panel precheck-block precheck-block-wide">
            <h2>Matched patterns</h2>
            <div class="precheck-cards" data-config-scan-warnings></div>
          </section>
          <section class="panel precheck-block precheck-block-wide">
            <h2>Boundary</h2>
            <p>The pasted text stays in this browser. This mode makes zero network requests and zero model calls.</p>
            <div class="precheck-result-actions">
              <button class="button button-primary" type="button" data-config-scan-copy>Copy local report</button>
            </div>
          </section>
        </div>
      </div>
    </section>

    <div data-precheck-authority-scope-panel>
      <ScopeHandoffShort locale="en" offer="scope_review" id="precheck-send-scope" />
    </div>
  </main>
  <link rel="stylesheet" href="/pre-check-r1.css" />
  <script is:inline src="/pre-check-r1.js" defer></script>
  <script is:inline src="/pre-check-config-scan-r1.js" defer></script>
</Layout>
