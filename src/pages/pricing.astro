---
import Layout from '../layouts/Layout.astro';

const tiers = [
  {
    price: "Free",
    label: "20-minute scope / authority triage",
    desc: "Коротко определяем критическое действие агента, границы полномочий и пригодность staging/test среды. Без письменного security conclusion, exploit work и deep log analysis.",
    cta: "Start triage",
    href: "/audit-intake"
  },
  {
    price: "$1,500",
    label: "Reduced-scope entry audit",
    desc: "Одна критическая action chain, одна главная failure hypothesis, ограниченное воспроизведение и короткий finding memo. Без полной authority map и без включённого retest.",
    cta: "Scope entry audit",
    href: "/audit-intake"
  },
  {
    price: "$4,900",
    label: "Primary Agent Authority & Evidence Audit",
    desc: "5 рабочих дней; 1 staging/test workflow; до 3 tools / APIs / MCP servers; 10–20 согласованных failure scenarios; executive report; reproducible evidence pack; prioritized repair backlog; один retest.",
    cta: "Open audit intake",
    href: "/audit-intake",
    featured: true
  }
];
---

<Layout title="Pricing — Agent Authority & Evidence Audit | BitEvo" description="Evidence-bounded pricing for BitEvo Agent Authority & Evidence Audit.">
  <section class="hero-section">
    <div class="container hero-inner">
      <div class="kicker">Agent Authority & Evidence Audit</div>
      <h1>One bounded commercial ladder</h1>
      <p>Engineering review of agent authority, evidence, logging, traceability and operational controls. No certification, guaranteed security, or profit promise.</p>
    </div>
  </section>

  <section class="container legal">
    <strong>EU AI Act / Article 12.</strong>
    Article 12 sets record-keeping requirements for AI systems classified as high-risk. Applicability depends on the system, use case and the organization's legal role. Our work can provide engineering evidence for logging, traceability and control review, but it is not legal advice or certification.
  </section>

  <section class="container pricing-grid">
    {tiers.map(t => (
      <article class:list={["tier", t.featured && "featured"]}>
        <div class="price">{t.price}</div>
        <h2>{t.label}</h2>
        <p>{t.desc}</p>
        <a href={t.href}>{t.cta}</a>
      </article>
    ))}
  </section>

  <section class="container hardening">
    <h2>Hardening</h2>
    <p>Implementation/hardening is quoted separately only after verified findings exist. BitEvo does not publicly promise a fixed implementation price before the audit identifies the actual repair scope.</p>
  </section>

  <section class="container boundary">
    <strong>Scope boundary.</strong>
    Written scope and Rules of Engagement are required before testing. Production penetration testing is not included by default. Do not submit API keys, passwords, tokens, private keys, wallet seeds, production credentials or customer secrets through the public intake.
  </section>

  <style>
    .hero-section{padding:58px 0 24px}.hero-inner{text-align:center}.kicker{color:var(--gold);font-size:.75rem;font-weight:900;letter-spacing:.14em;text-transform:uppercase}.hero-inner h1{font-family:'Playfair Display',serif;font-size:clamp(2.2rem,5vw,3.4rem);margin:8px 0 12px}.hero-inner p{max-width:760px;margin:0 auto;color:var(--muted);font-family:'Lora',serif}.legal,.boundary,.hardening{max-width:980px;margin:18px auto;background:var(--paper-soft);border:1px solid var(--line);border-radius:12px;padding:20px;color:var(--muted)}.legal strong,.boundary strong{color:var(--gold)}.pricing-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;padding-block:22px}.tier{background:var(--paper-soft);border:1px solid var(--line);border-radius:14px;padding:24px;display:flex;flex-direction:column;gap:12px}.tier.featured{border-color:var(--gold)}.price{font-size:2rem;font-weight:900}.tier h2{font-family:'Playfair Display',serif;font-size:1.25rem;margin:0}.tier p{color:var(--muted);margin:0;flex:1}.tier a{display:block;text-align:center;padding:11px 16px;border:1px solid var(--line-strong);border-radius:8px;font-weight:800}.featured a{background:var(--gold);color:#080a0b}.hardening h2{margin:0 0 8px;color:var(--ink)}.hardening p{margin:0}@media(max-width:850px){.pricing-grid{grid-template-columns:1fr}}
  </style>
</Layout>
