---
import Layout from '../layouts/Layout.astro';

const flagship = {
  name: "AI-Agent Reliability Audit",
  tagline: "Флагман. Делаем production AI-агентов безопасными за 72 часа.",
  tiers: [
    { price: "Free", unit: "триаж", desc: "Бесплатная диагностика: быстрый обзор рисков агента (инъекции, отсутствие логов решений, нет rollback). Отчёт + приоритеты.", cta: "Начать бесплатно", href: "/intake" },
    { price: "$1,500", unit: "фикс", desc: "Полный аудит одного агента: стресс-тест prompt-инъекций, Decision Trace, проверка rollback-пути, отчёт под EU AI Act Article-12 (record-keeping).", cta: "Заказать аудит", href: "/intake", featured: true },
    { price: "$12,500", unit: "фикс", desc: "Аудит + внедрение: чиним найденное — гейт (Default-DENY), hash-chain журнал решений, capability-паспорта, rollback. Сдаём воспроизводимо.", cta: "Обсудить объём", href: "/intake" },
  ],
};

const subscriptions = [
  { name: "Edge Ledger API", price: "$10", unit: "/мес", free: "JSON — бесплатно", desc: "46 000+ сделок, edge-матрица по режимам рынка. PRO: CSV-экспорт + конфиги стратегий.", href: "/intake" },
  { name: "Alpha Gatekeeper", price: "$15", unit: "/мес", free: "100 событий/мес бесплатно", desc: "ML + regime-фильтр твоих TradingView-вебхуков. Блокирует входы против режима. PRO: unlimited.", href: "/intake" },
];

const innerCircle = [
  { price: "$97", unit: "/мес", name: "Signal", desc: "Inner Circle Telegram: research-заметки лаборатории + лента сигналов валидированных арена-ботов (entry/SL/TP/size)." },
  { price: "$297", unit: "/мес", name: "Research", desc: "Всё из Signal + внутренние отчёты, ранний доступ к находкам, Strategy-Autopsy разборы наших убытков.", featured: true },
  { price: "$797", unit: "/мес", name: "Direct", desc: "Всё из Research + прямой доступ (Q&A по стратегиям и агентам). Мест ограниченно." },
];
---

<Layout title="Pricing — BitEvo Universe (честные тиры)">
  <section class="hero-section">
    <div class="container" style="text-align:center;padding-block:56px 16px">
      <div class="kicker" style="color:var(--gold,#ffd166)">Честные цены · без скрытых цифр</div>
      <h1 style="font-family:'Playfair Display',serif;font-size:clamp(2.1rem,5vw,3.2rem);font-weight:900;margin:8px 0 0">Pricing</h1>
      <p style="max-width:680px;margin:14px auto 0;color:var(--muted);font-size:1.05rem;line-height:1.6">
        Каждая цифра реальная. Мы продаём <b>прозрачность и надёжность</b>, а не обещания прибыли —
        реальными деньгами мы не торгуем, всё на paper.
      </p>
    </div>
  </section>

  <!-- Article-12 hook -->
  <section class="container" style="max-width:960px;padding-block:4px 8px">
    <div style="background:#0d1526;border:1px solid var(--gold,#ffd166)33;border-radius:14px;padding:18px 22px;color:#cbd5e1;line-height:1.6">
      <b style="color:var(--gold,#ffd166)">⚖️ EU AI Act, Article 12 — record-keeping.</b>
      Production-агенты по закону обязаны вести логи решений (record-keeping/traceability). Наш AI-Audit ставит именно это:
      Decision Trace + hash-chain журнал, воспроизводимый под аудит. Штрафы за несоответствие — до 7% глобального оборота.
    </div>
  </section>

  <!-- Flagship: AI-Audit -->
  <section class="container" style="max-width:1040px;padding-block:26px 10px">
    <h2 style="font-family:'Playfair Display',serif;font-size:1.6rem;margin:0 0 4px">🎯 {flagship.name}</h2>
    <p style="color:var(--muted);margin:0 0 18px">{flagship.tagline}</p>
    <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:16px" class="tier-grid">
      {flagship.tiers.map(t => (
        <div style={`background:#0b1220;border:1px solid ${t.featured ? 'var(--gold,#ffd166)' : '#1e2b45'};border-radius:16px;padding:22px;display:flex;flex-direction:column;gap:10px`}>
          <div style="display:flex;align-items:baseline;gap:8px">
            <span style="font-size:1.9rem;font-weight:900;color:#e2e8f0;font-variant-numeric:tabular-nums">{t.price}</span>
            <span style="color:var(--muted);font-size:0.9rem">{t.unit}</span>
          </div>
          <p style="margin:0;color:var(--muted);font-size:0.93rem;line-height:1.55;flex:1">{t.desc}</p>
          <a href={t.href} style={`text-align:center;padding:10px 16px;border-radius:9px;font-weight:800;text-decoration:none;${t.featured ? 'background:var(--gold,#ffd166);color:#0a0a0a' : 'border:1px solid #2a3550;color:#e2e8f0'}`}>{t.cta}</a>
        </div>
      ))}
    </div>
  </section>

  <!-- Inner Circle -->
  <section class="container" style="max-width:1040px;padding-block:26px 10px">
    <h2 style="font-family:'Playfair Display',serif;font-size:1.6rem;margin:0 0 4px">💎 Inner Circle</h2>
    <p style="color:var(--muted);margin:0 0 18px">Доступ к лаборатории: research-заметки, ранние находки, лента сигналов валидированных ботов. Подробнее → <a href="/inner-circle" style="color:var(--gold,#ffd166)">/inner-circle</a></p>
    <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:16px" class="tier-grid">
      {innerCircle.map(t => (
        <div style={`background:#0b1220;border:1px solid ${t.featured ? 'var(--gold,#ffd166)' : '#1e2b45'};border-radius:16px;padding:22px;display:flex;flex-direction:column;gap:10px`}>
          <div style="color:#66ffe0;font-weight:700;font-size:0.85rem;text-transform:uppercase;letter-spacing:0.08em">{t.name}</div>
          <div style="display:flex;align-items:baseline;gap:8px">
            <span style="font-size:1.8rem;font-weight:900;color:#e2e8f0;font-variant-numeric:tabular-nums">{t.price}</span>
            <span style="color:var(--muted);font-size:0.9rem">{t.unit}</span>
          </div>
          <p style="margin:0;color:var(--muted);font-size:0.93rem;line-height:1.55;flex:1">{t.desc}</p>
          <a href="/inner-circle" style={`text-align:center;padding:10px 16px;border-radius:9px;font-weight:800;text-decoration:none;${t.featured ? 'background:var(--gold,#ffd166);color:#0a0a0a' : 'border:1px solid #2a3550;color:#e2e8f0'}`}>Вступить</a>
        </div>
      ))}
    </div>
  </section>

  <!-- Self-serve subscriptions -->
  <section class="container" style="max-width:1040px;padding-block:26px 10px">
    <h2 style="font-family:'Playfair Display',serif;font-size:1.6rem;margin:0 0 18px">🛠️ Self-serve инструменты</h2>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px" class="tier-grid">
      {subscriptions.map(s => (
        <div style="background:#0b1220;border:1px solid #1e2b45;border-radius:16px;padding:22px;display:flex;flex-direction:column;gap:10px">
          <h3 style="margin:0;font-size:1.1rem;color:#e2e8f0">{s.name}</h3>
          <div style="display:flex;align-items:baseline;gap:8px">
            <span style="font-size:1.6rem;font-weight:900;color:#e2e8f0">{s.price}</span>
            <span style="color:var(--muted);font-size:0.9rem">{s.unit}</span>
            <span style="margin-left:auto;color:#66ffe0;font-size:0.8rem">{s.free}</span>
          </div>
          <p style="margin:0;color:var(--muted);font-size:0.93rem;line-height:1.55">{s.desc}</p>
          <a href={s.href} style="text-align:center;padding:10px 16px;border-radius:9px;font-weight:800;text-decoration:none;border:1px solid #2a3550;color:#e2e8f0">Подключить</a>
        </div>
      ))}
    </div>
  </section>

  <!-- Digital Entity Setup -->
  <section class="container" style="max-width:1040px;padding-block:26px 10px">
    <div style="background:#0b1220;border:1px solid #1e2b45;border-radius:16px;padding:24px;display:flex;flex-wrap:wrap;gap:16px;align-items:center;justify-content:space-between">
      <div style="flex:1;min-width:280px">
        <h2 style="font-family:'Playfair Display',serif;font-size:1.4rem;margin:0 0 6px">🧬 Digital Entity Setup (DFY)</h2>
        <p style="margin:0;color:var(--muted);font-size:0.95rem;line-height:1.55">Строим тебе персональную AI-операционную систему под ключ: память (ContinuityOS), гейт, журнал, оркестратор. Объём и цена — по задаче.</p>
      </div>
      <a href="/digital-entity-setup" style="padding:12px 22px;background:var(--gold,#ffd166);color:#0a0a0a;font-weight:800;border-radius:9px;text-decoration:none;white-space:nowrap">Обсудить объём →</a>
    </div>
  </section>

  <!-- Honest disclaimer -->
  <section class="container" style="max-width:960px;padding-block:20px 48px">
    <div style="background:#160a1e;border:1px solid #ff00ea44;border-radius:16px;padding:22px;color:#d9c2e8;line-height:1.6">
      <b style="color:var(--gold,#ffd166)">Честный disclaimer.</b>
      Это не сигнал-сервис и не «AI предсказывает крипту». Мы — исследовательская лаборатория: 150+ ботов торгуют
      <b>виртуальным</b> капиталом на live-данных, логи публичны, поражения публичны. Реальными деньгами мы не торгуем.
      На сегодня OOS-подтверждён <b>1</b> эдж; lifetime paper-результат отрицательный — и мы это показываем открыто.
      Ничто здесь не является финансовым советом.
    </div>
  </section>

  <style>@media (max-width:820px){ .tier-grid { grid-template-columns:1fr !important; } }</style>
</Layout>
