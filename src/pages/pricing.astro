---
import Layout from '../layouts/Layout.astro';

const tiers = [
  {
    eyebrow: 'Qualification', price: 'Free', cadence: '20 minutes', title: 'Scope / Authority Triage',
    desc: 'Decide whether the workflow is a sensible audit target and identify the critical external action, authority boundary and usable staging/test environment.',
    includes: ['20-minute scope call', 'Critical action identification', 'Staging/test fit check'],
    excludes: ['No written security conclusion', 'No exploit work', 'No deep log analysis'],
    cta: 'Start triage', href: '/audit-intake'
  },
  {
    eyebrow: 'Reduced scope', price: '$1,500', cadence: 'fixed', title: 'Entry Audit',
    desc: 'One critical action chain and one primary failure hypothesis with bounded reproduction and a concise finding memo.',
    includes: ['1 critical action chain', '1 primary failure hypothesis', 'Limited reproduction', 'Concise finding memo'],
    excludes: ['No full authority map', 'No complete evidence pack', 'No included retest'],
    cta: 'Scope entry audit', href: '/audit-intake'
  },
  {
    eyebrow: 'Primary engagement', price: '$4,900', cadence: '5 working days', title: 'Agent Authority & Evidence Audit',
    desc: 'The complete bounded audit for one staging/test workflow with agreed failure scenarios, reproducible evidence and one retest.',
    includes: ['1 staging/test workflow', 'Up to 3 tools / APIs / MCP servers', '10–20 agreed failure scenarios', 'Executive report + evidence pack', 'Prioritized repair backlog', 'One retest'],
    excludes: ['No certification', 'No guaranteed security', 'No production penetration testing by default'],
    cta: 'Open audit intake', href: '/audit-intake', featured: true
  }
];

const comparison = [
  ['Primary question', 'Is this worth auditing?', 'Can we reproduce this one failure?', 'Can we trust this workflow’s authority + evidence chain within scope?'],
  ['Workflow breadth', 'Qualification only', '1 critical action chain', '1 staging/test workflow'],
  ['Failure coverage', 'None tested', '1 primary hypothesis', '10–20 agreed scenarios'],
  ['Evidence output', 'No written conclusion', 'Concise finding memo', 'Executive report + reproducible evidence pack'],
  ['Authority map', 'No', 'No full map', 'Included'],
  ['Repair backlog', 'No', 'Limited to the finding', 'Prioritized backlog'],
  ['Retest', 'No', 'Not included', '1 included'],
  ['Best owner decision', 'Audit / do not audit', 'Repair / reject hypothesis', 'Expand authority / repair / constrain / retest']
];
---

<Layout title="Pricing — Agent Authority & Evidence Audit | BitEvo" description="Transparent bounded pricing for BitEvo agent authority, evidence and failure-control engineering audits.">
  <section class="pricing-hero section">
    <div class="container hero-grid">
      <div><div class="eyebrow">Commercial scope</div><h1 class="display">Pay for a bounded answer, not an open-ended security promise.</h1></div>
      <div><p class="lede">Three entry points, one clear primary audit. Scope and evidence ceilings are explicit before testing; implementation is quoted only after verified findings exist.</p><a class="button" href="/agent-authority-audit">See audit methodology →</a></div>
    </div>
  </section>

  <section class="section-tight section-rule">
    <div class="container pricing-grid">
      {tiers.map(t => (
        <article class:list={['tier', 'panel', t.featured && 'featured']}>
          {t.featured && <div class="recommended">Primary</div>}
          <div class="tier-top"><span>{t.eyebrow}</span><div class="price">{t.price}</div><small>{t.cadence}</small><h2>{t.title}</h2><p>{t.desc}</p></div>
          <div class="feature-group"><strong>Included</strong><ul>{t.includes.map(item => <li>{item}</li>)}</ul></div>
          <div class="feature-group muted"><strong>Boundary</strong><ul>{t.excludes.map(item => <li>{item}</li>)}</ul></div>
          <a href={t.href} class:list={['button', t.featured && 'button-primary']}>{t.cta} <span aria-hidden="true">↗</span></a>
        </article>
      ))}
    </div>
  </section>

  <section class="section section-rule">
    <div class="container compare-grid">
      <div><div class="eyebrow">Decision rule</div><h2 class="section-title">Choose scope by the question you need answered.</h2></div>
      <div class="decision-list">
        <article><span>Free</span><div><strong>“Is this even the right workflow to audit?”</strong><p>Use triage to define the action and staging boundary before committing budget.</p></div></article>
        <article><span>$1.5k</span><div><strong>“Can we reproduce this one suspected failure?”</strong><p>Use reduced scope when one chain and one hypothesis dominate the decision.</p></div></article>
        <article><span>$4.9k</span><div><strong>“Can we trust this workflow’s authority and evidence chain?”</strong><p>Use the primary audit when you need a broader authority map, multiple failure scenarios, evidence pack and retest.</p></div></article>
      </div>
    </div>
  </section>

  <section class="section section-rule comparison-section">
    <div class="container section-head">
      <div><div class="eyebrow">Scope matrix</div><h2 class="section-title">The difference is evidence depth, not a bigger promise.</h2></div>
      <p class="lede">Use this matrix for an internal budget or procurement decision. Each tier has a deliberately different evidence ceiling.</p>
    </div>
    <div class="container table-shell panel" role="region" aria-label="Audit scope comparison" tabindex="0">
      <div class="comparison-table">
        <div class="table-row table-head"><strong>Dimension</strong><strong>Free triage</strong><strong>Entry audit</strong><strong>Primary audit</strong></div>
        {comparison.map(row => (
          <div class="table-row"><strong>{row[0]}</strong><span>{row[1]}</span><span>{row[2]}</span><span>{row[3]}</span></div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-rule">
    <div class="container boundary-grid">
      <div class="panel boundary-card"><div class="eyebrow">Hardening</div><h2>Quoted after findings.</h2><p>Implementation and hardening are scoped separately only after the audit identifies the actual repair surface. There is no public fixed implementation price before evidence exists.</p></div>
      <div class="panel boundary-card"><div class="eyebrow">Legal boundary</div><h2>Engineering evidence, not certification.</h2><p>Where EU AI Act record-keeping requirements are relevant, applicability depends on the system classification, use case and organizational role. BitEvo can provide engineering evidence for logging, traceability and control review; this is not legal advice or certification.</p></div>
    </div>
  </section>

  <section class="section section-rule">
    <div class="narrow final-note">
      <div class="eyebrow">Before access</div>
      <h2 class="section-title">Written Rules of Engagement are mandatory.</h2>
      <p class="lede">The public intake prepares a scope brief only. Do not submit credentials, private keys, wallet seeds, production secrets or customer secrets.</p>
      <a href="/audit-intake" class="button button-primary">Prepare scope brief <span aria-hidden="true">↗</span></a>
    </div>
  </section>
</Layout>

<style>
  .pricing-hero{padding-top:clamp(78px,10vw,132px)}.hero-grid{display:grid;grid-template-columns:1.15fr .85fr;gap:clamp(42px,8vw,110px);align-items:end}.hero-grid .lede{margin:0 0 24px}.pricing-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.tier{position:relative;padding:28px;display:flex;flex-direction:column;min-height:690px;transition:transform .2s ease,border-color .2s ease}.tier:hover{transform:translateY(-3px);border-color:rgba(127,208,177,.24)}.tier.featured{border-color:rgba(127,208,177,.4);box-shadow:0 30px 90px rgba(0,0,0,.28), inset 0 1px 0 rgba(127,208,177,.08)}.recommended{position:absolute;right:18px;top:18px;padding:5px 9px;border:1px solid rgba(127,208,177,.3);border-radius:999px;color:var(--green);font:500 .58rem var(--mono);letter-spacing:.1em;text-transform:uppercase}.tier-top>span{color:var(--muted);font:500 .63rem var(--mono);letter-spacing:.1em;text-transform:uppercase}.price{margin-top:22px;font-size:clamp(2.8rem,5vw,4.5rem);line-height:1;font-weight:700;letter-spacing:-.06em}.tier-top small{display:block;color:var(--green);font:500 .64rem var(--mono);margin:7px 0 24px}.tier h2{font-size:1.15rem;margin:0 0 10px}.tier p{margin:0;color:var(--muted);font-size:.84rem}.feature-group{padding-top:20px;margin-top:22px;border-top:1px solid var(--line)}.feature-group strong{color:var(--ink-soft);font:500 .62rem var(--mono);letter-spacing:.1em;text-transform:uppercase}.feature-group ul{list-style:none;margin:11px 0 0;padding:0}.feature-group li{position:relative;padding:5px 0 5px 17px;color:var(--ink-soft);font-size:.78rem}.feature-group li::before{content:'+';position:absolute;left:0;color:var(--green);font-family:var(--mono)}.feature-group.muted li{color:var(--muted)}.feature-group.muted li::before{content:'–';color:#697673}.tier>.button{margin-top:auto}
  .compare-grid,.section-head{display:grid;grid-template-columns:.82fr 1.18fr;gap:clamp(42px,8vw,110px)}.decision-list{border-top:1px solid var(--line)}.decision-list article{display:grid;grid-template-columns:72px 1fr;gap:22px;padding:22px 0;border-bottom:1px solid var(--line)}.decision-list article>span{color:var(--green);font:500 .66rem var(--mono)}.decision-list strong{font-size:.92rem}.decision-list p{margin:5px 0 0;color:var(--muted);font-size:.82rem}.section-head{margin-bottom:34px}.section-head .lede{margin:2px 0 0}
  .table-shell{padding:0;overflow:auto}.comparison-table{min-width:900px}.table-row{display:grid;grid-template-columns:.78fr 1fr 1fr 1.2fr}.table-row>*{padding:16px 18px;border-right:1px solid var(--line);border-bottom:1px solid var(--line);font-size:.78rem;line-height:1.5}.table-row>*:last-child{border-right:0}.table-row:last-child>*{border-bottom:0}.table-row>strong:first-child{color:var(--ink)}.table-row span{color:var(--muted)}.table-head{position:sticky;top:0;background:rgba(11,21,23,.98);z-index:1}.table-head strong{color:var(--green)!important;font:500 .62rem var(--mono);letter-spacing:.09em;text-transform:uppercase}
  .boundary-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px}.boundary-card{padding:32px}.boundary-card h2{margin:2px 0 12px;font-size:1.3rem}.boundary-card p{margin:0;color:var(--muted)}.final-note{text-align:center}.final-note .section-title{margin-inline:auto}.final-note .lede{margin:20px auto 28px}
  @media(max-width:980px){.pricing-grid{grid-template-columns:1fr}.tier{min-height:auto}.tier>.button{margin-top:28px}.hero-grid,.compare-grid,.section-head{grid-template-columns:1fr}.boundary-grid{grid-template-columns:1fr}}
  @media(prefers-reduced-motion:reduce){.tier{transition:none}}
</style>