---
import Layout from '../layouts/Layout.astro';

const builtSurfaces = [
  {
    kind: 'Decision system',
    name: 'Authority Mapper',
    href: '/mapper',
    state: 'PUBLIC PRODUCT',
    text: 'Turns one action-capable workflow into a draft Authority Ledger, Evidence Contract, failure plan and unresolved decision gates without transmitting workflow content.'
  },
  {
    kind: 'Decision system',
    name: 'Decision Workspace',
    href: '/workspace',
    state: 'PUBLIC PRODUCT',
    text: 'Stores local checkpoints, compares exact before/after authority and evidence changes, and drafts a bounded Decision Memo without inventing a trust score.'
  },
  {
    kind: 'Diagnostic',
    name: '7-gate Diagnostic',
    href: '/diagnostic',
    state: 'PUBLIC PRODUCT',
    text: 'Exposes unresolved authority, evidence, freshness, confirmation and recovery gates before a workflow is treated as ready for deeper testing.'
  },
  {
    kind: 'Source project',
    name: 'ContinuityOS',
    href: '/continuityos',
    state: 'PUBLIC SOURCE PATH',
    text: 'Public-facing work on durable local memory, provenance and governance-oriented agent workflows, with source claims kept separate from runtime claims.'
  },
  {
    kind: 'Research',
    name: 'Reviewed Research',
    href: '/guides',
    state: 'CURATED PUBLIC SET',
    text: 'A deliberately small reviewed set of engineering notes. Historical dynamic guide generation is not treated as equivalent to reviewed research.'
  },
  {
    kind: 'Navigator',
    name: 'BitEvo Universe',
    href: '/universe',
    state: 'PUBLIC MAP',
    text: 'Connects BitEvo services, source projects and external research surfaces without presenting changing private state as public telemetry.'
  }
];

const buildPrinciples = [
  ['Bound the object', 'Start from one concrete workflow, artifact or public surface. Scope must be specific enough that another engineer can challenge the claim.'],
  ['Separate source from runtime', 'A repository state, a successful build and an observed external effect are different evidence classes. They are never collapsed into one “works” claim.'],
  ['Expose the decision path', 'Public tools should make the authority question, missing evidence and next owner decision easier to see — not hide them behind a score.'],
  ['Publish only what is defensible', 'Synthetic examples stay synthetic. Internal telemetry stays internal. Public claims stop at the strongest evidence that can actually be shown.']
];

const pipeline = ['Hypothesis', 'Artifact', 'Evidence', 'Decision', 'Retest', 'Publish'];
---

<Layout title="Build — Public Works & Engineering Proof | BitEvo" description="BitEvo Build is the public index of shipped decision tools, source projects and research surfaces — with source, build and runtime evidence kept distinct.">
  <section class="build-hero section">
    <div class="container hero-grid">
      <div>
        <div class="eyebrow">Public works · shipped artifacts</div>
        <h1 class="display">Build the proof surface, not the theatre.</h1>
      </div>
      <div class="hero-side">
        <p class="lede">BitEvo Build is the public engineering layer behind the audit offer: decision tools, source projects, research surfaces and navigators that make authority and evidence inspectable.</p>
        <div class="hero-actions"><a class="button button-primary" href="#surfaces">Inspect the build <span aria-hidden="true">↘</span></a><a class="button button-ghost" href="/universe">Open Universe</a></div>
      </div>
    </div>
  </section>

  <section class="signal-strip section-rule" aria-label="Build boundary">
    <div class="container signal-grid">
      <div><small>PUBLIC</small><strong>Artifact + method</strong></div>
      <div><small>VERIFIABLE</small><strong>Source / build / route</strong></div>
      <div><small>NOT IMPLIED</small><strong>Live private state</strong></div>
      <div><small>RULE</small><strong>Evidence class stays explicit</strong></div>
    </div>
  </section>

  <section class="section section-rule" id="surfaces">
    <div class="container section-head">
      <div><div class="eyebrow">Shipped surfaces</div><h2 class="section-title">The product is more than a landing page.</h2></div>
      <p class="lede">Each surface has a different job. Decision products help structure owner choices. Source projects expose bounded implementation paths. Research surfaces explain the engineering model. None of them is presented as proof of private runtime health.</p>
    </div>
    <div class="container surface-grid">
      {builtSurfaces.map((surface, i) => (
        <a class="surface-card panel" href={surface.href}>
          <div class="card-top"><span>{String(i + 1).padStart(2, '0')}</span><small>{surface.state}</small></div>
          <div><div class="kind">{surface.kind}</div><h3>{surface.name}</h3><p>{surface.text}</p></div>
          <div class="open">Open surface <span aria-hidden="true">↗</span></div>
        </a>
      ))}
    </div>
  </section>

  <section class="section section-rule">
    <div class="container section-head">
      <div><div class="eyebrow">Build contract</div><h2 class="section-title">Four constraints keep public engineering honest.</h2></div>
      <p class="lede">A polished surface is useful only when the claim behind it remains inspectable. The same discipline used in the audit model applies to what BitEvo publishes about its own work.</p>
    </div>
    <div class="container principle-grid">
      {buildPrinciples.map(([title, text], i) => (
        <article class="principle panel"><span>{String(i + 1).padStart(2, '0')}</span><h3>{title}</h3><p>{text}</p></article>
      ))}
    </div>
  </section>

  <section class="section section-rule">
    <div class="container pipeline-shell panel">
      <div class="pipeline-copy">
        <div class="eyebrow">Working loop</div>
        <h2 class="section-title">Ship through an evidence chain.</h2>
        <p>A build is not finished when code exists. The public loop ends only when the artifact, its evidence class and the decision it supports are explicit.</p>
      </div>
      <ol class="pipeline">
        {pipeline.map((step, i) => <li><span>{String(i + 1).padStart(2, '0')}</span><strong>{step}</strong></li>)}
      </ol>
    </div>
  </section>

  <section class="section section-rule">
    <div class="container split-card">
      <article class="panel source-card">
        <div class="eyebrow">Open path</div>
        <h2>ContinuityOS has a public source boundary.</h2>
        <p>Where a public repository is part of the evidence, the source link is exposed directly instead of substituting a marketing summary for inspectable implementation.</p>
        <div class="actions"><a class="button" href="/continuityos">Project surface</a><a class="button button-ghost" href="https://github.com/bitmaster162/continuityos" target="_blank" rel="noopener">GitHub source ↗</a></div>
      </article>
      <article class="panel universe-card">
        <div class="eyebrow">Next layer</div>
        <h2>Universe maps where each build belongs.</h2>
        <p>The Universe separates service, product, source and research surfaces. That taxonomy becomes the migration path for bringing the wider BitEvo ecosystem onto one coherent standard.</p>
        <a class="button button-primary" href="/universe">Explore BitEvo Universe <span aria-hidden="true">↗</span></a>
      </article>
    </div>
  </section>

  <section class="section section-rule">
    <div class="narrow boundary-note">
      <div class="eyebrow">Boundary</div>
      <h2 class="section-title">This is an index of public artifacts, not a live operations dashboard.</h2>
      <p class="lede">Build status, source state and runtime evidence are intentionally separate. Private infrastructure identifiers, credentials, internal telemetry and operator controls are not published through this surface.</p>
    </div>
  </section>
</Layout>

<style>
  .build-hero{padding-top:clamp(78px,10vw,132px)}.hero-grid{display:grid;grid-template-columns:1.08fr .92fr;gap:clamp(42px,8vw,110px);align-items:end}.hero-side .lede{margin:0 0 26px}.hero-actions,.actions{display:flex;gap:10px;flex-wrap:wrap}.signal-strip{padding-block:18px}.signal-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:18px}.signal-grid div{display:flex;flex-direction:column;gap:4px}.signal-grid small{color:#61706d;font:500 .58rem var(--mono);letter-spacing:.11em}.signal-grid strong{font-size:.78rem}.section-head{display:grid;grid-template-columns:.82fr 1.18fr;gap:clamp(42px,8vw,110px);margin-bottom:38px}.section-head .lede{margin:2px 0 0}.surface-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.surface-card{min-height:330px;padding:24px;display:flex;flex-direction:column;justify-content:space-between;transition:transform .18s ease,border-color .18s ease}.surface-card:hover{transform:translateY(-3px);border-color:rgba(127,208,177,.32)}.card-top{display:flex;justify-content:space-between;gap:12px;color:#5a6865;font:500 .58rem var(--mono)}.card-top small{color:var(--green);letter-spacing:.08em;text-align:right}.kind{margin-bottom:8px;color:var(--muted);font:500 .62rem var(--mono);letter-spacing:.09em;text-transform:uppercase}.surface-card h3{margin:0 0 10px;font-size:1.28rem;letter-spacing:-.025em}.surface-card p{margin:0;color:var(--muted);font-size:.82rem}.open{color:var(--ink-soft);font-size:.76rem;font-weight:700}.principle-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}.principle{min-height:300px;padding:24px;display:flex;flex-direction:column}.principle>span{color:var(--green);font:500 .6rem var(--mono)}.principle h3{margin:auto 0 10px;font-size:1.08rem}.principle p{margin:0;color:var(--muted);font-size:.8rem}.pipeline-shell{padding:32px;display:grid;grid-template-columns:.72fr 1.28fr;gap:clamp(38px,7vw,90px);align-items:center}.pipeline-copy p{color:var(--muted);max-width:520px}.pipeline{list-style:none;margin:0;padding:0;border-top:1px solid var(--line)}.pipeline li{display:grid;grid-template-columns:42px 1fr;gap:14px;padding:15px 0;border-bottom:1px solid var(--line)}.pipeline span{color:#5d6b68;font:500 .6rem var(--mono)}.pipeline strong{font-size:.88rem}.split-card{display:grid;grid-template-columns:1fr 1fr;gap:18px}.source-card,.universe-card{padding:32px;min-height:330px;display:flex;flex-direction:column;align-items:flex-start}.source-card h2,.universe-card h2{font-size:1.65rem;line-height:1.12;letter-spacing:-.035em;margin:0 0 14px}.source-card p,.universe-card p{color:var(--muted);margin:0 0 26px}.source-card .actions,.universe-card>.button{margin-top:auto}.boundary-note{text-align:center}.boundary-note .section-title{margin-inline:auto}.boundary-note .lede{margin:20px auto 0}@media(max-width:980px){.surface-grid{grid-template-columns:1fr 1fr}.principle-grid{grid-template-columns:1fr 1fr}.hero-grid,.section-head,.pipeline-shell{grid-template-columns:1fr}}@media(max-width:680px){.signal-grid,.surface-grid,.principle-grid,.split-card{grid-template-columns:1fr}.signal-grid{gap:12px}.surface-card,.principle{min-height:auto}.pipeline-shell{padding:24px}}
</style>
