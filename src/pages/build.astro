---
import Layout from '../layouts/Layout.astro';

const days = [
  ['Day 1', 'Boundary', 'Name one exception workflow, its start/stop events, owner, reviewer and explicit exclusions.'],
  ['Day 2', 'Fields', 'Map required, optional, conflicting and sensitive fields using synthetic, redacted or schema-only inputs.'],
  ['Day 3', 'Exceptions', 'Define review, hold, reject and escalation outcomes for missing, conflicting and ambiguous cases.'],
  ['Day 4', 'Human gate', 'Create the review packet and bounded internal readback specification.'],
  ['Day 5', 'Evidence handoff', 'Deliver the workflow map, rubric, limitations, acceptance result and next-decision queue.']
];

const outputs = [
  'Workflow boundary statement',
  'Source-of-truth map',
  'Field dictionary',
  'Exception taxonomy and review rubric',
  'Human-review packet template',
  'Acceptance rubric and safe proof plan',
  'Bounded internal-task readback specification',
  'Exclusion register and unresolved-question list',
  'Evidence handoff for owner review'
];

const proofFacts = [
  ['12 / 12', 'Fixed synthetic cases executed'],
  ['8 / 8', 'Acceptance criteria passed'],
  ['5 / 5', 'Injected interruption / replay cases passed'],
  ['12', 'Red-team action classes blocked with zero real effects']
];

const noFit = [
  'Candidate or employee communication',
  'Hiring, rejection, offer or eligibility decisions',
  'ATS / HRIS / payroll / calendar / employment-record mutation',
  'Identity or access provisioning',
  'Production deployment, migration or deletion',
  'Compliance, ROI, savings, accuracy or SLA guarantees'
];
---

<Layout title="Thailand/SEA HR Workflow Diagnostic | BitEvo BUILD" description="Map one recurring Thailand/SEA recruiting, HR or workforce exception workflow in five business days. Human review, bounded readback and evidence handoff — without candidate contact or ATS, HRIS, payroll, calendar or employment-record changes.">
  <section class="hero section">
    <div class="container hero-grid">
      <div>
        <div class="eyebrow">BitEvo BUILD · five-day diagnostic</div>
        <h1 class="display">Make one recurring HR exception reviewable in five business days.</h1>
      </div>
      <div class="hero-side">
        <p class="lede">BitEvo maps one Thailand/SEA recruiting, HR or workforce exception workflow and turns it into a clear human-review packet, bounded internal task readback and evidence handoff.</p>
        <p class="boundary">The first phase uses synthetic, redacted or schema-only inputs. It does not contact candidates or employees and does not change ATS, HRIS, payroll, calendar or employment records.</p>
        <div class="hero-actions">
          <a class="button button-primary" href="mailto:robert@bitevo.work?subject=BitEvo%20BUILD%20qualification%20call">Request a 20-minute qualification call <span aria-hidden="true">↗</span></a>
          <a class="button button-ghost" href="#scope">See the five-day scope</a>
        </div>
      </div>
    </div>
  </section>

  <section class="signal-strip section-rule" aria-label="Offer summary">
    <div class="container signal-grid">
      <div><small>TIME</small><strong>5 business days</strong></div>
      <div><small>LAUNCH PRICE</small><strong>USD 3,000</strong></div>
      <div><small>INPUTS</small><strong>Synthetic / redacted / schema-only</strong></div>
      <div><small>BOUNDARY</small><strong>No production write</strong></div>
    </div>
  </section>

  <section class="section section-rule" id="scope">
    <div class="container section-head">
      <div><div class="eyebrow">The wedge</div><h2 class="section-title">One exception workflow. One owner. One reviewer.</h2></div>
      <p class="lede">Recruiting and workforce teams lose time when a requisition, onboarding packet, employee change or site-readiness handoff is missing a required field, carries conflicting dates, points to the wrong owner or crosses a regional boundary. BUILD makes that boundary explicit before any integration is considered.</p>
    </div>
    <div class="container day-grid">
      {days.map(([day, title, text]) => (
        <article class="panel day-card">
          <span>{day}</span>
          <h3>{title}</h3>
          <p>{text}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section section-rule">
    <div class="container split">
      <article class="panel output-card">
        <div class="eyebrow">What you receive</div>
        <h2>Evidence before integration.</h2>
        <ul>{outputs.map((item) => <li>{item}</li>)}</ul>
      </article>
      <article class="panel fit-card">
        <div class="eyebrow">Good fit</div>
        <h2>A bounded operational exception.</h2>
        <p>Best fit: Thailand/SEA multi-site hospitality, restaurant, retail, healthcare, manufacturing, logistics, freight, aviation, staffing, recruiting, BPO/shared-services, technology or education teams with one recurring people/workforce exception and a named process owner.</p>
        <p><strong>GO:</strong> one recurring exception, one owner, one reviewer, safe inputs and no first-phase production write.</p>
        <p><strong>HOLD:</strong> workflow ownership, data boundary or requested integration is unclear.</p>
      </article>
    </div>
  </section>

  <section class="section section-rule proof-section">
    <div class="container section-head">
      <div><div class="eyebrow">Local synthetic proof</div><h2 class="section-title">Measured locally. Labeled honestly.</h2></div>
      <p class="lede">The existing proof is local and synthetic. It demonstrates the fixed harness behavior below; it does not establish production integration, language quality, legal/compliance treatment, customer outcomes, ROI, savings, headcount reduction, availability or SLA.</p>
    </div>
    <div class="container proof-grid">
      {proofFacts.map(([value, label]) => <div class="panel proof-card"><strong>{value}</strong><span>{label}</span></div>)}
    </div>
    <div class="container proof-note panel">
      <strong>Evidence boundary</strong>
      <p>In the fixed local corpus, BitEvo also rejected corrupted readback/checkpoint states, sealed twelve evidence bundles and created local fixture effects only after synthetic approval. No customer system or external API was tested.</p>
    </div>
  </section>

  <section class="section section-rule">
    <div class="container section-head">
      <div><div class="eyebrow">Explicit exclusions</div><h2 class="section-title">What the five-day diagnostic will not do.</h2></div>
      <p class="lede">A narrow first phase is deliberate. Requests that require these actions move outside this offer and need a separate written scope and risk review.</p>
    </div>
    <div class="container exclusion-grid">
      {noFit.map((item, i) => <div class="exclusion"><span>{String(i + 1).padStart(2,'0')}</span><strong>{item}</strong></div>)}
    </div>
  </section>

  <section class="section section-rule">
    <div class="container price-shell panel">
      <div>
        <div class="eyebrow">Commercial boundary</div>
        <h2 class="section-title">Five-day diagnostic — USD 3,000.</h2>
        <p class="lede">The price covers the bounded diagnostic above. It does not include production integrations, software subscriptions, customer-data migration, compliance work or ongoing production support.</p>
      </div>
      <div class="price-side">
        <div><small>OPTIONAL NEXT STEP</small><strong>10-day bounded synthetic prototype — USD 6,500</strong><p>Separately scoped. Still non-production. A controlled pilot remains TBD.</p></div>
        <a class="button button-primary" href="mailto:robert@bitevo.work?subject=BitEvo%20BUILD%20qualification%20call">Request qualification <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>

  <section class="section section-rule">
    <div class="narrow boundary-note">
      <div class="eyebrow">Proof and safety boundary</div>
      <h2 class="section-title">No production-readiness implication.</h2>
      <p class="lede">The five-day BUILD diagnostic uses synthetic, redacted or schema-only inputs and avoids production systems. Proof references describe local synthetic results, not customer outcomes. Any integration, live data, language, security, retention, residency or compliance requirement is a separate TBD decision.</p>
    </div>
  </section>
</Layout>

<style>
  .hero{padding-top:clamp(76px,10vw,132px)}.hero-grid{display:grid;grid-template-columns:1.08fr .92fr;gap:clamp(38px,8vw,105px);align-items:end}.hero-side .lede{margin:0 0 18px}.boundary{margin:0 0 25px;color:var(--muted);font-size:.84rem}.hero-actions{display:flex;gap:10px;flex-wrap:wrap}.signal-strip{padding-block:18px}.signal-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:18px}.signal-grid div{display:flex;flex-direction:column;gap:4px}.signal-grid small,.price-side small{color:#61706d;font:500 .58rem var(--mono);letter-spacing:.11em}.signal-grid strong{font-size:.78rem}.section-head{display:grid;grid-template-columns:.84fr 1.16fr;gap:clamp(38px,8vw,105px);margin-bottom:36px}.section-head .lede{margin:2px 0 0}.day-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:12px}.day-card{min-height:245px;padding:22px;display:flex;flex-direction:column}.day-card>span{color:var(--green);font:500 .6rem var(--mono);letter-spacing:.08em}.day-card h3{margin:auto 0 10px;font-size:1.05rem}.day-card p{margin:0;color:var(--muted);font-size:.79rem}.split{display:grid;grid-template-columns:1fr 1fr;gap:16px}.output-card,.fit-card{padding:30px}.output-card h2,.fit-card h2{margin:8px 0 18px;font-size:1.45rem}.output-card ul{margin:0;padding-left:18px;color:var(--muted);display:grid;gap:9px}.fit-card p{color:var(--muted);font-size:.84rem}.fit-card strong{color:var(--ink-soft)}.proof-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}.proof-card{padding:25px;min-height:145px;display:flex;flex-direction:column;justify-content:space-between}.proof-card strong{color:var(--green);font-size:2rem;letter-spacing:-.04em}.proof-card span{color:var(--muted);font-size:.78rem}.proof-note{margin-top:14px;padding:22px;display:grid;grid-template-columns:.35fr 1.65fr;gap:24px}.proof-note p{margin:0;color:var(--muted);font-size:.8rem}.exclusion-grid{display:grid;grid-template-columns:1fr 1fr;border:1px solid var(--line);border-radius:var(--radius);overflow:hidden}.exclusion{display:grid;grid-template-columns:38px 1fr;gap:10px;padding:18px 20px;border-right:1px solid var(--line);border-bottom:1px solid var(--line);background:rgba(8,16,18,.42)}.exclusion:nth-child(2n){border-right:0}.exclusion:nth-last-child(-n+2){border-bottom:0}.exclusion span{color:var(--green);font:500 .58rem var(--mono)}.exclusion strong{font-size:.84rem}.price-shell{padding:34px;display:grid;grid-template-columns:1fr .9fr;gap:clamp(32px,7vw,90px);align-items:center;background:radial-gradient(circle at 0 0,rgba(127,208,177,.07),transparent 38%),linear-gradient(180deg,rgba(14,27,29,.84),rgba(8,16,18,.88))}.price-shell .lede{margin-bottom:0}.price-side{display:grid;gap:20px}.price-side strong{display:block;margin:5px 0 6px;font-size:1rem}.price-side p{margin:0;color:var(--muted);font-size:.78rem}.boundary-note{text-align:center}.boundary-note .lede{margin-left:auto;margin-right:auto;max-width:850px}
  @media(max-width:950px){.hero-grid,.section-head,.price-shell{grid-template-columns:1fr;gap:24px}.day-grid{grid-template-columns:1fr 1fr}.proof-grid{grid-template-columns:1fr 1fr}}
  @media(max-width:640px){.signal-grid,.split,.day-grid,.proof-grid,.exclusion-grid{grid-template-columns:1fr}.exclusion{border-right:0}.exclusion:nth-last-child(-n+2){border-bottom:1px solid var(--line)}.exclusion:last-child{border-bottom:0}.proof-note{grid-template-columns:1fr}.hero-actions{align-items:stretch}.hero-actions .button{width:100%;justify-content:center}}
</style>
