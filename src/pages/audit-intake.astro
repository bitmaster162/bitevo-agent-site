---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Agent Authority & Evidence Audit — Scope Intake" description="Prepare a local Rules-of-Engagement scope brief for the BitEvo Agent Authority & Evidence Audit.">
  <section class="intake-hero section-tight">
    <div class="container hero-grid">
      <div><div class="eyebrow">Rules of Engagement intake</div><h1 class="page-title">Define the workflow before anyone tests it.</h1></div>
      <div><p class="lede">This form creates a scope brief locally in your browser. It does not transmit data and it does not authorize testing. Written scope and approval are required before execution.</p></div>
    </div>
  </section>

  <section class="section-tight section-rule">
    <div class="container warning panel" role="alert">
      <div class="warning-mark">!</div>
      <div><strong>Do not submit or paste secrets.</strong><p>API keys · passwords · tokens · private keys · wallet seeds · production credentials · customer secrets. Describe access boundaries instead of pasting credentials.</p></div>
    </div>

    <div class="container intake-grid">
      <form id="audit-intake" class="form-shell panel">
        <section class="form-section">
          <div class="form-section-head"><span>01</span><div><h2>Business context</h2><p>Enough context to identify the owner and decision — not a company data dump.</p></div></div>
          <div class="two">
            <label>Company<input id="company" autocomplete="organization" required placeholder="Company or project" /></label>
            <label>Business contact<input id="contact" autocomplete="name" required placeholder="Name + business contact" /></label>
          </div>
          <label>Role<input id="role" autocomplete="organization-title" required placeholder="CTO / Founder / Engineering Lead" /></label>
          <label>Desired outcome<textarea id="outcome" rows="3" required placeholder="What decision, evidence or repair backlog should this audit enable?"></textarea></label>
        </section>

        <section class="form-section">
          <div class="form-section-head"><span>02</span><div><h2>Workflow boundary</h2><p>Isolate the one action chain whose failure matters most.</p></div></div>
          <label>Agent / workflow description<textarea id="workflow" rows="3" required placeholder="What the agent does and what external effect it can create"></textarea></label>
          <label>Critical workflow<textarea id="criticalWorkflow" rows="3" required placeholder="The exact action chain whose failure matters most"></textarea></label>
          <label>External systems / tools<textarea id="externalSystems" rows="3" required placeholder="Tools, APIs, MCP servers and external systems involved — names only, no credentials"></textarea></label>
          <label>Most expensive plausible error<textarea id="expensiveError" rows="3" required placeholder="Describe the business or operational consequence"></textarea></label>
          <div class="two">
            <label>Environment<input id="environment" required placeholder="staging / test / isolated lab / other" /></label>
            <label>Access approver<input id="approver" required placeholder="Role/name authorized to approve access" /></label>
          </div>
        </section>

        <section class="form-section">
          <div class="form-section-head"><span>03</span><div><h2>Execution rules</h2><p>Define what may happen and what must never happen.</p></div></div>
          <div class="two">
            <label>Test / staging available?
              <select id="staging" required><option value="">Select</option><option>Yes</option><option>No</option><option>Partial / needs setup</option></select>
            </label>
            <label>Safe replay available?
              <select id="replay" required><option value="">Select</option><option>Yes</option><option>No</option><option>Unknown</option></select>
            </label>
          </div>
          <label>Allowed tests<textarea id="allowedTests" rows="3" required placeholder="What may be tested, replayed, written or simulated"></textarea></label>
          <label>Prohibited actions<textarea id="prohibited" rows="3" required placeholder="Actions, systems, data or effects that must never be touched"></textarea></label>
        </section>

        <section class="form-section">
          <div class="form-section-head"><span>04</span><div><h2>Data & secret boundary</h2><p>Use the minimum evidence necessary for the agreed workflow.</p></div></div>
          <label>Data classification<input id="classification" required placeholder="public / internal / confidential / regulated / other" /></label>
          <label>Minimum necessary data<textarea id="minimumData" rows="3" required placeholder="Smallest dataset/log subset needed for the audit"></textarea></label>
          <label>Secret-handling boundary<textarea id="secretBoundary" rows="3" required placeholder="How credentials and secrets remain outside the audit evidence path"></textarea></label>
          <label class="confirm"><input type="checkbox" id="secretConfirm" required /><span>I confirm this form contains no credentials, private keys, wallet seeds or customer secrets.</span></label>
        </section>

        <div class="form-actions">
          <button class="button button-primary" type="submit">Generate scope brief <span aria-hidden="true">→</span></button>
          <button class="button button-ghost" type="reset">Reset</button>
        </div>
      </form>

      <aside class="brief-panel panel">
        <div class="brief-top"><div><div class="eyebrow">Local output</div><h2>Scope brief</h2></div><span id="briefState">Not generated</span></div>
        <p class="brief-explain">Review the generated text before sharing it through an agreed business channel. Generation happens only in this browser.</p>
        <textarea id="brief" readonly aria-label="Generated scope brief" placeholder="Complete the required fields, then generate the brief."></textarea>
        <div class="brief-actions">
          <button id="copy" class="button" disabled>Copy brief</button>
          <button id="download" class="button button-ghost" disabled>Download .txt</button>
        </div>
        <div class="gate"><span>AUTHORIZATION GATE</span><strong>Testing authorization: NOT GRANTED by this form.</strong><p>Scope, allowed/prohibited actions, access approval, data boundaries and replay conditions must be agreed in writing before testing.</p></div>
      </aside>
    </div>
  </section>

  <script>
    const form = document.getElementById('audit-intake') as HTMLFormElement;
    const brief = document.getElementById('brief') as HTMLTextAreaElement;
    const copy = document.getElementById('copy') as HTMLButtonElement;
    const download = document.getElementById('download') as HTMLButtonElement;
    const briefState = document.getElementById('briefState') as HTMLSpanElement;
    const fields = [
      ['Company','company'],['Business contact','contact'],['Role','role'],['Desired outcome','outcome'],
      ['Agent/workflow','workflow'],['Critical workflow','criticalWorkflow'],['External systems/tools','externalSystems'],
      ['Most expensive plausible error','expensiveError'],['Environment','environment'],['Access approver','approver'],
      ['Test/staging available','staging'],['Safe replay available','replay'],['Allowed tests','allowedTests'],
      ['Prohibited actions','prohibited'],['Data classification','classification'],['Minimum necessary data','minimumData'],
      ['Secret-handling boundary','secretBoundary']
    ];

    const setReady = (ready: boolean) => {
      copy.disabled = !ready;
      download.disabled = !ready;
      briefState.textContent = ready ? 'Ready to review' : 'Not generated';
    };

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;
      const lines = [
        '=== BITEVO AGENT AUTHORITY & EVIDENCE AUDIT — SCOPE INTAKE ===',
        `Generated: ${new Date().toISOString()}`,
        'PUBLIC FORM WARNING: no API keys, passwords, tokens, private keys, wallet seeds, production credentials or customer secrets.',
        'Testing authorization: NOT GRANTED by this brief. Written Rules of Engagement required.',
        ''
      ];
      for (const [label,id] of fields) {
        const el = document.getElementById(id) as HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement;
        lines.push(`${label}: ${el?.value.trim() || '-'}`);
      }
      lines.push('', 'Secret confirmation: user confirmed no credentials/private keys/wallet seeds/customer secrets were entered.');
      lines.push('Requested next step: scope review only; no testing until written approval.');
      brief.value = lines.join('\n');
      setReady(true);
    });

    copy.addEventListener('click', async () => {
      if (!brief.value) return;
      await navigator.clipboard.writeText(brief.value);
      const old = copy.textContent;
      copy.textContent = 'Copied';
      setTimeout(() => copy.textContent = old, 1400);
    });

    download.addEventListener('click', () => {
      if (!brief.value) return;
      const blob = new Blob([brief.value], { type: 'text/plain;charset=utf-8' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = 'bitevo-agent-audit-scope.txt';
      a.click();
      URL.revokeObjectURL(url);
    });

    form.addEventListener('reset', () => {
      requestAnimationFrame(() => {
        brief.value = '';
        setReady(false);
      });
    });
  </script>
</Layout>

<style>
  .intake-hero{padding-top:clamp(62px,8vw,104px)}.hero-grid{display:grid;grid-template-columns:1.05fr .95fr;gap:clamp(40px,8vw,100px);align-items:end}.hero-grid .lede{margin:0}.warning{max-width:1080px;padding:18px 20px;display:grid;grid-template-columns:36px 1fr;gap:14px;align-items:start;border-color:rgba(228,139,139,.28);background:linear-gradient(180deg,rgba(69,29,29,.28),rgba(25,14,15,.32));margin-bottom:22px}.warning-mark{width:28px;height:28px;display:grid;place-items:center;border:1px solid rgba(228,139,139,.4);border-radius:50%;color:var(--red);font:500 .72rem var(--mono)}.warning strong{color:#f1caca}.warning p{margin:3px 0 0;color:#ba9999;font-size:.79rem}
  .intake-grid{max-width:1080px;display:grid;grid-template-columns:1.12fr .88fr;gap:18px;align-items:start}.form-shell{padding:0 28px}.form-section{padding:28px 0;border-bottom:1px solid var(--line)}.form-section:last-of-type{border-bottom:0}.form-section-head{display:grid;grid-template-columns:34px 1fr;gap:12px;margin-bottom:22px}.form-section-head>span{color:var(--green);font:500 .64rem var(--mono)}.form-section h2{margin:0;font-size:1.05rem}.form-section-head p{margin:4px 0 0;color:var(--muted);font-size:.76rem}.two{display:grid;grid-template-columns:1fr 1fr;gap:12px}label{display:flex;flex-direction:column;gap:7px;margin-bottom:14px;color:#96a29f;font:500 .64rem/1.3 var(--mono);letter-spacing:.06em;text-transform:uppercase}input,textarea,select{width:100%;border:1px solid var(--line-strong);border-radius:11px;background:rgba(255,255,255,.025);color:var(--ink);padding:11px 12px;font:500 .83rem/1.55 var(--sans);letter-spacing:0;text-transform:none;outline:none}input:focus,textarea:focus,select:focus{border-color:rgba(127,208,177,.55);box-shadow:0 0 0 3px rgba(127,208,177,.06)}textarea{resize:vertical}.confirm{display:grid;grid-template-columns:18px 1fr;align-items:start;gap:10px;padding:13px 14px;border:1px solid var(--line);border-radius:11px;text-transform:none;letter-spacing:0;font-family:var(--sans);font-size:.78rem;line-height:1.5}.confirm input{width:16px;height:16px;margin:2px 0 0;padding:0;accent-color:var(--green)}.form-actions{display:flex;gap:10px;flex-wrap:wrap;padding:0 0 28px}
  .brief-panel{position:sticky;top:96px;padding:24px}.brief-top{display:flex;justify-content:space-between;gap:18px;align-items:start}.brief-top h2{margin:0;font-size:1.25rem}.brief-top .eyebrow{margin-bottom:5px}.brief-top>span{padding:5px 8px;border:1px solid var(--line);border-radius:999px;color:var(--muted);font:500 .56rem var(--mono)}.brief-explain{color:var(--muted);font-size:.78rem}.brief-panel textarea{min-height:430px;margin-top:8px;font-family:var(--mono);font-size:.68rem;line-height:1.65}.brief-actions{display:flex;gap:9px;margin-top:12px}.brief-actions button:disabled{opacity:.35;cursor:not-allowed;transform:none}.gate{margin-top:20px;padding-top:18px;border-top:1px solid var(--line)}.gate>span{color:var(--gold);font:500 .58rem var(--mono);letter-spacing:.1em}.gate strong{display:block;margin:6px 0;font-size:.8rem}.gate p{margin:0;color:var(--muted);font-size:.72rem}
  @media(max-width:900px){.hero-grid,.intake-grid{grid-template-columns:1fr}.brief-panel{position:static}.brief-panel textarea{min-height:320px}}
  @media(max-width:620px){.two{grid-template-columns:1fr}.form-shell{padding:0 18px}.brief-actions{flex-direction:column}.brief-actions .button{width:100%}}
</style>
