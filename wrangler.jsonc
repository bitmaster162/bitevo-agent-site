{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bitevo-agent-site",
  "compatibility_date": "2026-08-12",
  "main": "worker/index.mjs",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/b1-2/event",
      "/b1-2/event-report",
      "/guides/*",
      "/ru/guides/ai-agent-reliability-audit",
      "!/guides/security-sandboxing",
      "!/guides/fleet-coordinator-drift-monitoring",
      "!/guides/d3-tool-io-bridge-contract"
    ]
  },
  "d1_databases": [
    {
      "binding": "BITEVO_EVENT_DB",
      "database_name": "bitevo-events-b12",
      "database_id": "b533a76e-ddd0-406b-9449-94e878bc2c50"
    }
  ],
  "ratelimits": [
    {
      "name": "BITEVO_EVENT_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "vars": {
    "BITEVO_EVENT_COUNTER_RECEIVER_ENABLED": "true"
  }
}
